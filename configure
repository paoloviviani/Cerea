KEY = re.compile(r"^[A-Z_][A-Z0-9_]*$")


class ConfigError(ValueError):
    """An answer that would produce a deployment which cannot work."""


# --- .env files ------------------------------------------------------------------


def parse_env(text: str) -> dict:
    """Compose's .env rules, as far as this stack needs them.

    Single quotes are literal; double quotes take the usual backslash escapes;
    an unquoted value ends at ` #`.
    """
    values = {}
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export ") :].lstrip()
        key, sep, value = line.partition("=")
        key = key.strip()
        if not sep or not KEY.match(key):
            raise ConfigError(f"line {number}: expected KEY=VALUE, got {raw!r}")
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] == "'":
            value = value[1:-1]
        elif len(value) >= 2 and value[0] == value[-1] == '"':
            value = bytes(value[1:-1], "utf-8").decode("unicode_escape")
        else:
            value = re.split(r"\s+#", value, maxsplit=1)[0].strip()
        values[key] = value
    return values


def quote(key: str, value: str) -> str:
    if "'" in value or "\n" in value:
        raise ConfigError(f"{key}: a value holding a single quote or a newline cannot be written")
    return f"{key}='{value}'"


_ACTIVE = re.compile(r"^([A-Z_][A-Z0-9_]*)=")
_COMMENTED = re.compile(r"^# ([A-Z_][A-Z0-9_]*)='[^']*'$")


def template_keys(template: str) -> tuple:
    """(active keys, commented-out keys) of .env.example, in order."""
    active, commented = [], []
    for line in template.splitlines():
        m = _ACTIVE.match(line)
        if m:
            active.append(m.group(1))
            continue
        m = _COMMENTED.match(line)
        if m:
            commented.append(m.group(1))
    return active, commented


def render(template: str, values: dict, header: str) -> str:
    """.env.example's layout with these values.

    An active line takes its key's value. A commented-out example line becomes
    active when its key has a value, and stays a comment otherwise. Keys the
    template does not name go into a final section, so nothing is lost.
    """
    out, seen = [], set()
    lines = template.splitlines()
    # The template's own header (up to the first blank line) is for readers
    # of the example; the written file gets a short one of its own.
    first_blank = lines.index("") if "" in lines else 0
    out.extend(header.splitlines())
    for line in lines[first_blank:]:
        m = _ACTIVE.match(line)
        if m:
            key = m.group(1)
            seen.add(key)
            if key in values:
                out.append(quote(key, values[key]))
            continue
        m = _COMMENTED.match(line)
        if m and m.group(1) in values and m.group(1) not in seen:
            seen.add(m.group(1))
            out.append(quote(m.group(1), values[m.group(1)]))
            continue
        out.append(line)
    extra = [k for k in values if k not in seen]
    if extra:
        out += ["", "# --- Not in .env.example (kept as found) " + "-" * 38, ""]
        out += [quote(k, values[k]) for k in extra]
    return "\n".join(out).rstrip("\n") + "\n"


def write_private(path: Path, text: str) -> None:
    """Atomically, at mode 0600 from the first byte."""
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def backup(path: Path) -> Path | None:
    if not path.exists():
        return None
    stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    target = path.with_name(f"{path.name}.bak-{stamp}")
    n = 1
    while target.exists():
        target = path.with_name(f"{path.name}.bak-{stamp}-{n}")
        n += 1
    write_private(target, path.read_text(encoding="utf-8"))
    return target


HEADER = """\
# Written by ./configure. The deployment's one configuration file; every key
# is explained in .env.example. Edit it by hand or re-run ./configure (which
# keeps your secrets and edits), then: ./configure --check && docker compose up -d
# Mode 0600: it holds every secret. Back it up with the volumes."""


# --- secrets and digests ---------------------------------------------------------


def mint(nbytes: int) -> str:
    return secrets.token_hex(nbytes)


def _ab64(raw: bytes) -> str:
    # The "adapted base64" of crypt(3)-style digests: no padding, '.' for '+'.
    return base64.b64encode(raw).decode().rstrip("=").replace("+", ".")


def _un_ab64(text: str) -> bytes:
    text = text.replace(".", "+")
    return base64.b64decode(text + "=" * (-len(text) % 4))


PBKDF2_ROUNDS = 310000


def pbkdf2_digest(secret: str, *, rounds: int = PBKDF2_ROUNDS, salt: bytes | None = None) -> str:
    """An Authelia-compatible `$pbkdf2-sha512$` digest (argon2 is not in the stdlib)."""
    salt = salt or os.urandom(16)
    raw = hashlib.pbkdf2_hmac("sha512", secret.encode(), salt, rounds)
    return f"$pbkdf2-sha512${rounds}${_ab64(salt)}${_ab64(raw)}"


_CRYPT64 = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
# glibc's byte order for SHA512-crypt's output: 21 triples, then byte 63.
_SHA512_CRYPT_ORDER = [(i, (i + 21) % 63, (i + 42) % 63) for i in (0, 22, 44, 3, 25, 47, 6, 28, 50, 9,
                                                                   31, 53, 12, 34, 56, 15, 37, 59, 18, 40, 62)]
SHA512_CRYPT_ROUNDS = 100000


def sha512_crypt(secret: str, *, rounds: int = SHA512_CRYPT_ROUNDS, salt: str | None = None) -> str:
    """A `$6$` (SHA512-crypt) digest, Ulrich Drepper's algorithm.

    For the first Authelia password: the gateway's bootstrap accepts argon2 or
    `$6$` there, and argon2 is not in the standard library (`crypt` left it
    in Python 3.13). Authelia verifies it as sha2crypt.
    """
    if salt is None:
        salt = "".join(secrets.choice(_CRYPT64) for _ in range(16))
    key, salt_b = secret.encode(), salt.encode()[:16]
    sha = hashlib.sha512
    b = sha(key + salt_b + key).digest()
    a = sha(key + salt_b)
    n = len(key)
    while n > 64:
        a.update(b)
        n -= 64
    a.update(b[:n])
    n = len(key)
    while n:
        a.update(b if n & 1 else key)
        n >>= 1
    a_digest = a.digest()
    p = (sha(key * len(key)).digest() * (len(key) // 64 + 1))[: len(key)]
    s = (sha(salt_b * (16 + a_digest[0])).digest() * (len(salt_b) // 64 + 1))[: len(salt_b)]
    c = a_digest
    for i in range(rounds):
        h = sha(p if i & 1 else c)
        if i % 3:
            h.update(s)
        if i % 7:
            h.update(p)
        h.update(c if i & 1 else p)
        c = h.digest()
    out = []
    for i, j, k in _SHA512_CRYPT_ORDER:
        w = (c[i] << 16) | (c[j] << 8) | c[k]
        for _ in range(4):
            out.append(_CRYPT64[w & 0x3F])
            w >>= 6
    w = c[63]
    for _ in range(2):
        out.append(_CRYPT64[w & 0x3F])
        w >>= 6
    prefix = "$6$" if rounds == 5000 else f"$6$rounds={rounds}$"
    return f"{prefix}{salt_b.decode()}${''.join(out)}"


def digest_matches(secret: str, digest: str) -> bool | None:
    """True/False for a digest we can verify ($6$, pbkdf2-sha512); None otherwise."""
    if digest.startswith("$6$"):
        parts = digest.split("$")
        rounds = 5000
        if len(parts) == 5 and parts[2].startswith("rounds="):
            rounds, salt = int(parts[2][len("rounds="):]), parts[3]
        elif len(parts) == 4:
            salt = parts[2]
        else:
            return False
        return hmac.compare_digest(sha512_crypt(secret, rounds=rounds, salt=salt), digest)
    parts = digest.split("$")
    if len(parts) != 5 or parts[1] != "pbkdf2-sha512":
        return None
    try:
        rounds, salt, want = int(parts[2]), _un_ab64(parts[3]), _un_ab64(parts[4])
    except (ValueError, TypeError):
        return False
    got = hashlib.pbkdf2_hmac("sha512", secret.encode(), salt, rounds)
    return hmac.compare_digest(got, want)


# --- origin rules ----------------------------------------------------------------


def is_ip(host: str) -> bool:
    try:
        ipaddress.ip_address(host)
    except ValueError:
        return False
    return True


def split_origin(origin: str) -> tuple:
    """(normalised origin, host, port or None). Refuses what cannot work."""
    parts = urlsplit(origin.strip())
    if parts.scheme != "https":
        raise ConfigError(
            f"the public origin must be https:// (got {origin!r}); browsers reach the stack "
            "over TLS in every mode, upstream included"
        )
    if not parts.hostname or parts.path not in ("", "/") or parts.query or parts.fragment:
        raise ConfigError(f"the public origin must be https://host[:port], got {origin!r}")
    try:
        port = parts.port
    except ValueError:
        raise ConfigError(f"the public origin has an invalid port: {origin!r}") from None
    return f"https://{parts.netloc.lower()}", parts.hostname.lower(), port


def check_email(email: str) -> str:
    email = email.strip()
    local, _, domain = email.rpartition("@")
    if not local or "." not in domain or domain.startswith(".") or domain.endswith("."):
        # The chat refuses an issuer-local address such as admin@local with an
        # error that reads like a broken login; refuse it here instead.
        raise ConfigError(f"the administrator email must be a real address (user@domain.tld), got {email!r}")
    return email


def refuse_tls(tls: str, host: str) -> None:
    if tls not in TLS_MODES:
        raise ConfigError(f"TLS mode must be one of {', '.join(TLS_MODES)}")
    if tls == "acme" and (is_ip(host) or "." not in host):
        raise ConfigError(
            "TLS mode acme needs a public DNS name; for an IP or a private host use "
            "--tls internal, or --tls upstream when TLS ends in front of this host"
        )


def refuse_authelia(host: str) -> None:
    if is_ip(host) or "." not in host:
        # Authelia needs a Domain cookie, and browsers refuse one on an IP or
        # a dotless name: nobody would stay signed in.
        raise ConfigError(
            "the bundled Authelia needs a dotted host name, not an IP or a dotless name; "
            "add a DNS or hosts entry, or bring an external IdP (--idp external)"
        )


def site_for(tls: str, host: str) -> tuple:
    if tls == "upstream":
        # TLS ends in front of us: plain HTTP inside, on HTTP_PORT.
        return "http://:80", ""
    return f"https://{host}", ("tls internal" if tls == "internal" else "")


# --- answers -> values -----------------------------------------------------------


@dataclass
class Answers:
    origin: str = ""
    admin_email: str = ""
    preset: str = "team"
    tls: str = "acme"
    idp: str = "authelia"
    agents: bool | None = None
    project: str | None = None
    http_port: int | None = None
    https_port: int | None = None
    public_bind: str | None = None
    acme_email: str | None = None
    admin_user: str | None = None
    admin_name: str | None = None
    admin_password: str | None = None
    # External IdP.
    oidc_issuer: str | None = None
    oidc_internal_base_url: str | None = None
    oidc_console_client_id: str | None = None
    oidc_console_client_secret: str | None = None
    oidc_chat_client_id: str | None = None
    oidc_chat_client_secret: str | None = None
    oidc_groups_claim: str | None = None
    oidc_logout_url: str | None = None
    # Who is an administrator (external IdP only; the bundled Authelia uses
    # admin_email as its bootstrap address instead).
    admin_claim: str | None = None
    admin_claim_value: str | None = None
    link_by_email: bool | None = None
    machine_client_id: str | None = None
    group_sync: str | None = None
    # Mail: quota notices, "send test", and (bundled Authelia) its own
    # self-service reset.
    smtp_host: str | None = None
    smtp_port: int | None = None
    smtp_username: str | None = None
    smtp_password: str | None = None
    smtp_from: str | None = None
    smtp_security: str | None = None
    # Satellite and generic presets, and the gateway's first provider.
    central_url: str | None = None
    upstream_base_url: str | None = None
    upstream_api_key: str | None = None


@dataclass
class Result:
    values: dict
    #: The minted first password, for first-sign-in.txt; never printed.
    admin_password: str | None = None
    notes: list = field(default_factory=list)


def template_defaults(template: str) -> dict:
    return parse_env("\n".join(line for line in template.splitlines() if _ACTIVE.match(line)))


def answers_from(values: dict) -> Answers:
    """What an existing .env answered, so a re-run starts from it."""
    profiles = {p for p in values.get("COMPOSE_PROFILES", "").split(",") if p}
    return Answers(
        origin=values.get("PUBLIC_ORIGIN", ""),
        admin_email=values.get("PYSTINO_BOOTSTRAP_ADMIN_EMAIL", ""),
        preset=values.get("PYSTINO_PRESET", "team") or "team",
        tls=values.get("TLS_MODE", "acme") or "acme",
        idp="authelia" if "authelia" in profiles or not profiles else "external",
        agents=values.get("CODE_AGENTS_ENABLED", "") == "true",
    )


def build(answers: Answers, existing: dict, template: str) -> Result:
    """Every value the stack reads, from the answers and what .env already holds.

    Pure apart from randomness: no file is read or written here, so every rule
    is a unit test.
    """
    fresh = not existing
    values = dict(template_defaults(template))
    # The example's placeholders are never real values on a fresh install.
    for key in ("PUBLIC_ORIGIN", "SITE_ADDRESS", "ACME_EMAIL", "OIDC_ISSUER",
                "OIDC_LOGOUT_URL", "AUTHELIA_COOKIE_DOMAIN", "PYSTINO_BOOTSTRAP_ADMIN_EMAIL",
                "AUTHELIA_ADMIN_EMAIL"):
        values[key] = ""
    values.update(existing)
    before = answers_from(existing) if existing else None
    result = Result(values=values)
    notes = result.notes

    if answers.preset not in PRESETS:
        raise ConfigError(f"unknown preset {answers.preset!r}; choose one of {', '.join(PRESETS)}")
    preset = PRESETS[answers.preset]
    origin, host, origin_port = split_origin(answers.origin)
    refuse_tls(answers.tls, host)
    idp = answers.idp
    if preset.name == "satellite" and idp != "external":
        # One directory: the central gateway accepts only its own issuer's tokens.
        idp = "external"
        notes.append("satellite: the IdP is the central Pystino's (external)")
    if idp not in IDPS:
        raise ConfigError(f"the IdP must be one of {', '.join(IDPS)}")
    if idp == "authelia":
        refuse_authelia(host)
    # The bundled Authelia's bootstrap door needs an address; an external IdP
    # does not, on its own — an admin rule does (checked below, once it is
    # known whether a claim rule was given instead), and the bootstrap
    # address is honoured only with the bundled IdP anyway.
    if idp == "authelia":
        admin_email = check_email(answers.admin_email)
    else:
        admin_email = (answers.admin_email or "").strip()
        if admin_email:
            admin_email = check_email(admin_email)

    def changed(attr: str) -> bool:
        return before is None or getattr(before, attr) != getattr(answers, attr)

    # No PYSTINO_PRESET: a .env from elsewhere (Pystino's own deploy/, which
    # has no chat), so the preset's profiles and switches apply in full.
    preset_changed = before is None or not existing.get("PYSTINO_PRESET") or before.preset != preset.name
    idp_changed = before is None or before.idp != idp

    # --- compose ----------------------------------------------------------------
    values["PYSTINO_CONFIG_VERSION"] = CONFIG_VERSION
    if answers.project:
        values["COMPOSE_PROJECT_NAME"] = answers.project
    values.setdefault("COMPOSE_PROJECT_NAME", "cerea")
    if preset_changed:
        profiles = list(preset.profiles)
    else:
        # Keep profiles the operator switched on by hand (fetch on team, say).
        profiles = [p for p in values.get("COMPOSE_PROFILES", "").split(",") if p]
        profiles = [p for p in profiles if p != "authelia"]
    if idp == "authelia":
        profiles.append("authelia")
    profiles = [p for p in PROFILES if p in profiles] + [p for p in profiles if p not in PROFILES]
    values["COMPOSE_PROFILES"] = ",".join(dict.fromkeys(profiles))
    # The chat's renderer address follows the fetch profile. An address that
    # is not ours (a renderer elsewhere) is left alone.
    if "fetch" in profiles:
        values.setdefault("PLAYWRIGHT_WS_ENDPOINT", PLAYWRIGHT_ENDPOINT)
        values["PLAYWRIGHT_WS_ENDPOINT"] = values["PLAYWRIGHT_WS_ENDPOINT"] or PLAYWRIGHT_ENDPOINT
    elif values.get("PLAYWRIGHT_WS_ENDPOINT") in ("", PLAYWRIGHT_ENDPOINT):
        values.pop("PLAYWRIGHT_WS_ENDPOINT", None)
    values["PYSTINO_PRESET"] = preset.name
    if preset_changed:
        values.update(preset.values)
        if not fresh:
            notes.append(f"preset {preset.name}: feature switches reset to the preset's")
    else:
        for key, value in preset.values.items():
            values.setdefault(key, value)

    # --- origin and TLS -----------------------------------------------------------
    values["PUBLIC_ORIGIN"] = origin
    values["TLS_MODE"] = answers.tls
    values["SITE_ADDRESS"], values["TLS_DIRECTIVE"] = site_for(answers.tls, host)
    if answers.https_port is not None:
        values["HTTPS_PORT"] = str(answers.https_port)
    elif origin_port and (fresh or changed("origin")):
        values["HTTPS_PORT"] = str(origin_port)
    elif fresh:
        values["HTTPS_PORT"] = "443"
    if answers.http_port is not None:
        values["HTTP_PORT"] = str(answers.http_port)
    if answers.public_bind:
        values["PUBLIC_BIND"] = answers.public_bind
    old_host = split_origin(before.origin)[1] if before and before.origin.startswith("https://") else None
    if answers.acme_email:
        values["ACME_EMAIL"] = answers.acme_email
    elif not values.get("ACME_EMAIL") or values.get("ACME_EMAIL") == f"admin@{old_host}":
        values["ACME_EMAIL"] = "admin@example.org" if is_ip(host) else f"admin@{host}"
    values["PROXY_DEFAULT"] = "chat" if preset.standalone else "gateway"

    # --- secrets: minted once, never re-minted ------------------------------------
    for key, nbytes in MINTED.items():
        if not values.get(key):
            values[key] = mint(nbytes)

    # --- where the chat sends model calls -------------------------------------------
    for key in ("CHAT_OPENAI_BASE_URL", "CHAT_OPENAI_API_KEY", "CHAT_USE_USER_TOKEN"):
        if preset_changed:
            values.pop(key, None)
    if preset.name == "satellite":
        central = (answers.central_url or "").strip().rstrip("/")
        if not central:
            base = values.get("CHAT_OPENAI_BASE_URL", "")
            central = base[: -len("/v1")] if base.endswith("/v1") else ""
        if not central.startswith("https://"):
            raise ConfigError("the satellite preset needs --central-url https://<central Pystino>")
        if answers.upstream_api_key:
            # A stored key would bill every user of this site to one account.
            raise ConfigError("a satellite stores no API key: every call carries the user's token")
        values.update(
            CHAT_OPENAI_BASE_URL=f"{central}/v1", CHAT_OPENAI_API_KEY="", CHAT_USE_USER_TOKEN="true"
        )
        if not answers.oidc_issuer and (idp_changed or not values.get("OIDC_ISSUER")):
            answers.oidc_issuer = f"{central}/authelia"
    elif preset.name == "generic":
        key = answers.upstream_api_key or values.get("CHAT_OPENAI_API_KEY", "")
        if not key:
            raise ConfigError("the generic preset needs the endpoint's API key (--upstream-api-key)")
        values.update(
            CHAT_OPENAI_BASE_URL=answers.upstream_base_url
            or values.get("CHAT_OPENAI_BASE_URL")
            or DEFAULT_UPSTREAM,
            CHAT_OPENAI_API_KEY=key,
            # Forced: user-token mode would send people's IdP tokens to a third party.
            CHAT_USE_USER_TOKEN="false",
        )
    else:
        if answers.upstream_base_url:
            values["GATEWAY_UPSTREAM__BASE_URL"] = answers.upstream_base_url
        if answers.upstream_api_key is not None:
            values["GATEWAY_UPSTREAM__API_KEY"] = answers.upstream_api_key
    if preset.standalone:
        values["GATEWAY_UPSTREAM__API_KEY"] = ""

    # --- agent machines -------------------------------------------------------------
    if answers.agents is not None:
        values["CODE_AGENTS_ENABLED"] = "true" if answers.agents else ""

    # --- identity -------------------------------------------------------------------
    values["PYSTINO_BOOTSTRAP_ADMIN_EMAIL"] = admin_email
    if answers.group_sync:
        values["OIDC_GROUP_SYNC"] = answers.group_sync
    values.setdefault("OIDC_GROUP_SYNC", "every_login")
    if answers.link_by_email is not None:
        values["OIDC_LINK_BY_EMAIL"] = "true" if answers.link_by_email else "false"
    values.setdefault("OIDC_LINK_BY_EMAIL", "false")
    if answers.machine_client_id:
        values["OIDC_MACHINE_CLIENT_ID"] = answers.machine_client_id
    values.setdefault("OIDC_MACHINE_CLIENT_ID", "opencode-enrollment")

    # --- mail -------------------------------------------------------------------
    for attr, key in (
        ("smtp_host", "SMTP_HOST"),
        ("smtp_username", "SMTP_USERNAME"),
        ("smtp_password", "SMTP_PASSWORD"),
        ("smtp_from", "SMTP_FROM"),
        ("smtp_security", "SMTP_SECURITY"),
    ):
        value = getattr(answers, attr)
        if value is not None:
            values[key] = value
    if answers.smtp_port is not None:
        values["SMTP_PORT"] = str(answers.smtp_port)
    if answers.smtp_host is not None:
        # Setting the host is what turns mail on; a later edit that clears it
        # (--smtp-host '') turns it back off rather than leaving a stale
        # SMTP_ENABLED=true with nothing to connect to.
        values["SMTP_ENABLED"] = "true" if answers.smtp_host else "false"
    values.setdefault("SMTP_ENABLED", "false")
    values.setdefault("SMTP_PORT", "587")
    values.setdefault("SMTP_SECURITY", "starttls")

    if idp == "authelia":
        values.update(
            OIDC_ISSUER=f"{origin}/authelia",
            OIDC_INTERNAL_BASE_URL=AUTHELIA_INTERNAL,
            OIDC_KIND="authelia",
            OIDC_CONSOLE_CLIENT_ID="pystino-console",
            OIDC_CHAT_CLIENT_ID="cerea",
            OIDC_GROUPS_CLAIM="groups",
            OIDC_AUDIENCE="pystino-api",
            # Authelia publishes no end_session_endpoint; the chat signs out
            # through the portal's /logout, {redirect} = where to land.
            OIDC_LOGOUT_URL=f"{origin}/authelia/logout?rd={{redirect}}",
            AUTHELIA_COOKIE_DOMAIN=host,
            AUTHELIA_ADMIN_EMAIL=admin_email,
        )
        for key, nbytes in MINTED_AUTHELIA.items():
            if not values.get(key):
                values[key] = mint(nbytes)
        for secret_key, digest_key in DIGESTS.items():
            secret = values.get(secret_key, "")
            digest = values.get(digest_key, "")
            if not secret:
                secret = values[secret_key] = mint(32)
                digest = ""
            # A digest we cannot verify (argon2id from an older install) is kept.
            if not digest or digest_matches(secret, digest) is False:
                values[digest_key] = pbkdf2_digest(secret)
        if answers.admin_user:
            values["AUTHELIA_ADMIN_USER"] = answers.admin_user
        values["AUTHELIA_ADMIN_USER"] = values.get("AUTHELIA_ADMIN_USER") or "admin"
        if answers.admin_name:
            values["AUTHELIA_ADMIN_NAME"] = answers.admin_name
        values["AUTHELIA_ADMIN_NAME"] = values.get("AUTHELIA_ADMIN_NAME") or values["AUTHELIA_ADMIN_USER"]
        # $6$, not pbkdf2: the gateway's bootstrap accepts only argon2 or $6$ here.
        if answers.admin_password:
            values["AUTHELIA_ADMIN_PASSWORD_DIGEST"] = sha512_crypt(answers.admin_password)
        elif not values.get("AUTHELIA_ADMIN_PASSWORD_DIGEST"):
            password = secrets.token_urlsafe(18)
            values["AUTHELIA_ADMIN_PASSWORD_DIGEST"] = sha512_crypt(password)
            result.admin_password = password
    else:
        if idp_changed:
            # The bundled IdP's own values would be wrong for another issuer.
            for key in ("OIDC_ISSUER", "OIDC_INTERNAL_BASE_URL", "OIDC_LOGOUT_URL"):
                if values.get(key, "").startswith((f"{origin}/authelia", AUTHELIA_INTERNAL)):
                    values[key] = ""
            values["OIDC_KIND"] = "generic"
        for attr, key in (
            ("oidc_issuer", "OIDC_ISSUER"),
            ("oidc_internal_base_url", "OIDC_INTERNAL_BASE_URL"),
            ("oidc_console_client_id", "OIDC_CONSOLE_CLIENT_ID"),
            ("oidc_console_client_secret", "OIDC_CONSOLE_CLIENT_SECRET"),
            ("oidc_chat_client_id", "OIDC_CHAT_CLIENT_ID"),
            ("oidc_chat_client_secret", "OIDC_CHAT_CLIENT_SECRET"),
            ("oidc_groups_claim", "OIDC_GROUPS_CLAIM"),
            ("oidc_logout_url", "OIDC_LOGOUT_URL"),
        ):
            value = getattr(answers, attr)
            if value is not None:
                values[key] = value.rstrip("/") if key.endswith(("ISSUER", "BASE_URL")) else value
        values.setdefault("OIDC_KIND", "generic")
        if idp_changed and values.get("OIDC_KIND") == "authelia":
            values["OIDC_KIND"] = "generic"
        if not values.get("OIDC_ISSUER"):
            raise ConfigError("an external IdP needs its issuer (--oidc-issuer)")
        if not values["OIDC_ISSUER"].startswith("https://"):
            raise ConfigError("the external issuer must be an https:// URL")
        if not preset.standalone and not values.get("OIDC_CONSOLE_CLIENT_SECRET"):
            raise ConfigError(
                "an external IdP needs the console's client secret (--oidc-console-client-secret); "
                f"register redirect URI {origin}/auth/callback/default"
            )
        if not values.get("OIDC_CHAT_CLIENT_SECRET"):
            raise ConfigError(
                "an external IdP needs the chat's client secret (--oidc-chat-client-secret); "
                f"register redirect URI {origin}/chat/login/callback"
            )
        if answers.admin_claim is not None:
            values["OIDC_ADMIN_CLAIM"] = answers.admin_claim
        if answers.admin_claim_value is not None:
            values["OIDC_ADMIN_CLAIM_VALUE"] = answers.admin_claim_value
        if bool(values.get("OIDC_ADMIN_CLAIM")) != bool(values.get("OIDC_ADMIN_CLAIM_VALUE")):
            raise ConfigError(
                "--admin-claim and --admin-claim-value must be set together, or not at all"
            )
        # An external IdP has no bootstrap door (that is the bundled
        # Authelia's only): admin_email answers OIDC_ADMIN_EMAIL directly
        # here, unless a claim rule was given instead.
        if not values.get("OIDC_ADMIN_CLAIM"):
            values["OIDC_ADMIN_EMAIL"] = admin_email
        if not values.get("OIDC_ADMIN_EMAIL") and not values.get("OIDC_ADMIN_CLAIM"):
            raise ConfigError(
                "an external identity provider needs an admin rule: --admin-email, or "
                "--admin-claim with --admin-claim-value"
            )
    return result


# --- --check ----------------------------------------------------------------------


@dataclass
class Report:
    errors: list = field(default_factory=list)
    warnings: list = field(default_factory=list)
    notes: list = field(default_factory=list)

    @property
    def ok(self) -> bool:
        return not self.errors


def _run(cmd: list, timeout: int = 30, cwd: Path | None = None) -> subprocess.CompletedProcess | None:
    if shutil.which(cmd[0]) is None:
        return None
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=cwd)
    except (OSError, subprocess.SubprocessError):
        return None


def compose_version() -> tuple | None:
    proc = _run(["docker", "compose", "version", "--short"], timeout=20)
    if not proc or proc.returncode != 0:
        return None
    m = re.search(r"(\d+)\.(\d+)", proc.stdout)
    return (int(m.group(1)), int(m.group(2))) if m else None


def local_addresses() -> set:
    addrs = {"127.0.0.1", "::1"}
    proc = _run(["ip", "-o", "addr", "show"], timeout=5)
    if proc and proc.returncode == 0:
        for m in re.finditer(r"\binet6? ([0-9a-fA-F:.]+)/", proc.stdout):
            addrs.add(m.group(1))
    try:
        addrs.update(socket.gethostbyname_ex(socket.gethostname())[2])
    except OSError:
        pass
    return addrs


def resolve(host: str) -> set:
    try:
        return {info[4][0] for info in socket.getaddrinfo(host, None)}
    except OSError:
        return set()


def reachable(host: str, port: int, timeout: float = 4.0) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def registry_login_state(registry: str) -> str:
    """ok | missing | unknown (a credential store we cannot see into)."""
    host = registry.split("/", 1)[0]
    config = Path(os.environ.get("DOCKER_CONFIG") or Path.home() / ".docker") / "config.json"
    try:
        data = json.loads(config.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return "missing"
    if host in (data.get("auths") or {}) or host in (data.get("credHelpers") or {}):
        return "ok"
    return "unknown" if data.get("credsStore") else "missing"


def check_values(values: dict, report: Report) -> None:
    """Everything that can be said from .env alone."""
    profiles = {p for p in values.get("COMPOSE_PROFILES", "").split(",") if p}
    for key in REQUIRED:
        if not values.get(key):
            report.errors.append(f"{key} is missing or empty")
    for profile in sorted(profiles):
        if profile not in PROFILES:
            report.errors.append(f"COMPOSE_PROFILES names {profile!r}; known: {', '.join(PROFILES)}")
        for key in REQUIRED_BY_PROFILE.get(profile, ()):
            if not values.get(key):
                report.errors.append(f"{key} is missing or empty (needed by profile {profile!r})")
    if "gateway" not in profiles and "chat" not in profiles:
        report.errors.append("COMPOSE_PROFILES has neither gateway nor chat: nothing to serve")
    for key, why in RETIRED.items():
        if key in values:
            report.warnings.append(f"{key} is set but no longer read: {why}")
    for key in ("PYSTINO_VERSION", "CEREA_VERSION"):
        registry = values.get(key.replace("VERSION", "REGISTRY"), "")
        if values.get(key) and registry != "local":
            report.warnings.append(
                f"{key}={values[key]} overrides the version compose.yaml pins; upgrades "
                "by `git pull` will not move it. Remove it unless that is intended"
            )

    origin = values.get("PUBLIC_ORIGIN", "")
    try:
        origin, host, _ = split_origin(origin)
    except ConfigError as exc:
        report.errors.append(str(exc))
        return
    tls = values.get("TLS_MODE", "")
    try:
        refuse_tls(tls, host)
    except ConfigError as exc:
        report.errors.append(str(exc))
    else:
        want_site, want_directive = site_for(tls, host)
        if values.get("SITE_ADDRESS") != want_site or values.get("TLS_DIRECTIVE", "") != want_directive:
            report.errors.append(
                f"TLS_MODE={tls} needs SITE_ADDRESS='{want_site}' and TLS_DIRECTIVE='{want_directive}' "
                f"(found {values.get('SITE_ADDRESS')!r} and {values.get('TLS_DIRECTIVE', '')!r})"
            )
        if tls == "internal":
            report.notes.append("TLS_MODE=internal: browsers will warn; fine for development only")
    if values.get("PROXY_DEFAULT", "gateway") == "gateway" and "gateway" not in profiles:
        report.errors.append("PROXY_DEFAULT=gateway but the gateway profile is off; set PROXY_DEFAULT='chat'")
    try:
        check_email(values.get("PYSTINO_BOOTSTRAP_ADMIN_EMAIL", ""))
    except ConfigError as exc:
        report.warnings.append(f"PYSTINO_BOOTSTRAP_ADMIN_EMAIL: {exc}")

    if "authelia" in profiles:
        try:
            refuse_authelia(host)
        except ConfigError as exc:
            report.errors.append(str(exc))
        if values.get("OIDC_ISSUER") != f"{origin}/authelia":
            report.errors.append(f"with the bundled Authelia, OIDC_ISSUER must be {origin}/authelia")
        if values.get("AUTHELIA_COOKIE_DOMAIN") and values["AUTHELIA_COOKIE_DOMAIN"] != host:
            report.errors.append(f"AUTHELIA_COOKIE_DOMAIN must be {host}, the origin's host")
        for secret_key, digest_key in DIGESTS.items():
            secret, digest = values.get(secret_key, ""), values.get(digest_key, "")
            if secret and digest and digest_matches(secret, digest) is False:
                report.errors.append(
                    f"{digest_key} is not a digest of {secret_key}: sign-in would fail; "
                    "re-run ./configure to recompute it"
                )
        if "chat" in profiles and not values.get("OIDC_LOGOUT_URL"):
            report.warnings.append(
                "OIDC_LOGOUT_URL is empty: signing out of the chat will not end the Authelia "
                f"session. Set OIDC_LOGOUT_URL='{origin}/authelia/logout?rd={{redirect}}'"
            )
    else:
        admin_claim = values.get("OIDC_ADMIN_CLAIM", "")
        admin_claim_value = values.get("OIDC_ADMIN_CLAIM_VALUE", "")
        if bool(admin_claim) != bool(admin_claim_value):
            report.errors.append(
                "OIDC_ADMIN_CLAIM and OIDC_ADMIN_CLAIM_VALUE must be set together, or not at all"
            )
        elif not values.get("OIDC_ADMIN_EMAIL") and not admin_claim:
            report.errors.append(
                "an external identity provider needs an admin rule: set OIDC_ADMIN_EMAIL, or "
                "OIDC_ADMIN_CLAIM and OIDC_ADMIN_CLAIM_VALUE (./configure --admin-email / "
                "--admin-claim --admin-claim-value)"
            )
    for entry in values.get("OIDC_ADMIN_EMAIL", "").split(","):
        entry = entry.strip()
        if not entry:
            continue
        try:
            check_email(entry)
        except ConfigError as exc:
            report.errors.append(f"OIDC_ADMIN_EMAIL: {exc}")
    if values.get("OIDC_GROUP_SYNC", "every_login") not in ("every_login", "first_login", "never"):
        report.errors.append(
            "OIDC_GROUP_SYNC must be every_login, first_login or never, got "
            f"{values.get('OIDC_GROUP_SYNC')!r}"
        )
    if values.get("OIDC_LINK_BY_EMAIL", "false") == "true":
        report.warnings.append(
            "OIDC_LINK_BY_EMAIL is on: a first sign-in with a verified email will attach to the "
            "existing non-admin account with that address. Turn it off when the transition is done."
        )
    if not values.get("SMTP_HOST"):
        if values.get("PYSTINO_PRESET") == "team":
            report.warnings.append(
                "SMTP_HOST is empty: users can't reset their own password. "
                "Set --smtp-host (and --smtp-username/--smtp-password/--smtp-from as needed)"
            )
        elif "authelia" in profiles:
            report.notes.append(
                "SMTP_HOST is empty: password resets are admin-issued one-time passwords"
            )
    else:
        for key in ("SMTP_HOST", "SMTP_USERNAME", "SMTP_FROM"):
            value = values.get(key, "")
            if value and _SMTP_UNSAFE.search(value):
                report.errors.append(
                    f"{key} contains whitespace, a quote or a newline, which the bundled "
                    f"Authelia's configuration can't render safely: {value!r}"
                )
        port = values.get("SMTP_PORT", "")
        if port and not port.isdigit():
            report.errors.append(f"SMTP_PORT must be a number, got {port!r}")
        if "authelia" in profiles and not values.get("AUTHELIA_RESET_PASSWORD_JWT_SECRET"):
            report.errors.append(
                "AUTHELIA_RESET_PASSWORD_JWT_SECRET is missing or empty (needed once SMTP_HOST "
                "is set, for the bundled Authelia's password-reset link)"
            )
    endpoint = values.get("PLAYWRIGHT_WS_ENDPOINT", "")
    if "fetch" in profiles and not endpoint:
        report.warnings.append(
            "the fetch profile is on but PLAYWRIGHT_WS_ENDPOINT is empty: the chat cannot reach the "
            f"renderer. Set PLAYWRIGHT_WS_ENDPOINT='{PLAYWRIGHT_ENDPOINT}'"
        )
    elif "fetch" not in profiles and endpoint == PLAYWRIGHT_ENDPOINT:
        report.warnings.append(
            f"PLAYWRIGHT_WS_ENDPOINT points at {PLAYWRIGHT_ENDPOINT} but the fetch profile is off: "
            "the admin screen will report the renderer unreachable. Unset it, or add fetch to "
            "COMPOSE_PROFILES"
        )
    if values.get("FETCH_BACKEND") == "playwright" and not endpoint:
        report.warnings.append(
            "FETCH_BACKEND=playwright with no renderer (PLAYWRIGHT_WS_ENDPOINT empty): web fetch "
            "will fail. Turn on the fetch profile, or set FETCH_BACKEND='direct'"
        )
    if values.get("REDACTION_NLP_ENGINE") == "spacy" and "redaction" in profiles:
        if not values.get("REDACTION_IMAGE", "").endswith("-ner"):
            report.errors.append(
                "REDACTION_NLP_ENGINE=spacy needs the NER image, which is never published: "
                "run dev/build.sh --ner (or set REDACTION_NLP_ENGINE='disabled')"
            )


def check_host(values: dict, report: Report, *, root: Path, network: bool) -> None:
    """What needs Docker, DNS or the network."""
    version = compose_version()
    if version is None:
        report.errors.append("`docker compose` is not available here (Docker Engine with Compose v2)")
    elif version < MIN_COMPOSE:
        report.errors.append(
            f"Docker Compose {version[0]}.{version[1]} is too old; {MIN_COMPOSE[0]}.{MIN_COMPOSE[1]}+ is needed"
        )
    else:
        proc = _run(["docker", "compose", "config", "--images"], timeout=60, cwd=root)
        if proc is None or proc.returncode != 0:
            detail = (proc.stderr.strip().splitlines() or ["?"])[-1] if proc else "docker not runnable"
            report.errors.append(f"docker compose config fails: {detail}")
        else:
            images = sorted({line.strip() for line in proc.stdout.splitlines() if line.strip()})
            local = [i for i in images if i.startswith("local/")]
            for image in local:
                probe = _run(["docker", "image", "inspect", image], timeout=20)
                if probe is not None and probe.returncode != 0:
                    report.errors.append(f"{image} is not on this host: run dev/build.sh")
            registries = {i.split("/", 1)[0] for i in images if i.startswith("ghcr.io/paoloviviani/")}
            for registry in registries:
                state = registry_login_state(registry)
                if state == "missing":
                    report.warnings.append(
                        f"this host is not logged in to {registry}. If the images are private, "
                        "`docker compose pull` answers 'denied': log in once with a token that has "
                        "read:packages (echo $TOKEN | docker login ghcr.io -u <user> --password-stdin)"
                    )
                elif state == "unknown":
                    report.notes.append(f"a credential store hides whether {registry} is logged in")

    if not network:
        report.notes.append("--offline: DNS and port checks skipped")
        return

    if "gateway" in {p for p in values.get("COMPOSE_PROFILES", "").split(",") if p}:
        proc = _run(
            ["docker", "compose", "run", "--rm", "--no-deps", "gateway", "pystino", "idp",
             "check", "--discovery-only"],
            timeout=30, cwd=root,
        )
        if proc is None:
            report.notes.append("docker compose run is not available here; skipped pystino idp check")
        elif proc.returncode != 0:
            detail = (proc.stdout.strip().splitlines() or proc.stderr.strip().splitlines() or ["?"])[-1]
            report.errors.append(f"pystino idp check --discovery-only failed: {detail}")
        else:
            report.notes.append("pystino idp check --discovery-only: ok")

    try:
        _, host, _ = split_origin(values.get("PUBLIC_ORIGIN", ""))
    except ConfigError:
        return
    tls = values.get("TLS_MODE", "")
    addresses = resolve(host)
    if tls == "upstream":
        # TLS ends in front of this host: the name points at that front, and
        # 80/443 here are not the public path. Informational only.
        where = ", ".join(sorted(addresses)) or "nothing"
        report.notes.append(
            f"TLS_MODE=upstream: {host} resolves to {where} (the TLS front, not necessarily this host); "
            f"the front must forward plain HTTP to this host's port {values.get('HTTP_PORT', '80')}"
        )
        return
    if not addresses:
        (report.errors if tls == "acme" else report.warnings).append(
            f"{host} does not resolve from here" + (": Let's Encrypt cannot issue a certificate" if tls == "acme" else "")
        )
        return
    mine = local_addresses()
    if addresses & mine:
        report.notes.append(f"{host} resolves to this host ({', '.join(sorted(addresses & mine))})")
    elif tls == "acme":
        report.warnings.append(
            f"{host} resolves to {', '.join(sorted(addresses))}, not an address on this host; fine "
            "behind NAT with ports 80 and 443 forwarded here, otherwise Let's Encrypt will fail"
        )
    if tls == "acme":
        for port in (80, 443):
            if reachable(host, port):
                report.notes.append(f"{host}:{port} accepts connections")
            else:
                report.warnings.append(
                    f"{host}:{port} does not accept connections from here (the stack may not be up yet, "
                    "or a firewall blocks it); Let's Encrypt needs both 80 and 443"
                )


def check(root: Path, *, network: bool = True, probe_host: bool = True) -> Report:
    report = Report()
    env_path = root / ".env"
    if not env_path.is_file():
        report.errors.append(f"no .env in {root}: run ./configure (or copy .env.example) first")
        return report
    try:
        values = parse_env(env_path.read_text(encoding="utf-8"))
    except ConfigError as exc:
        report.errors.append(f".env does not parse: {exc}")
        return report
    mode = stat.S_IMODE(env_path.stat().st_mode)
    if mode & 0o077:
        report.warnings.append(f".env is mode {oct(mode)}; it holds every secret: chmod 600 .env")
    if (root / FIRST_SIGN_IN).exists():
        report.warnings.append(f"{FIRST_SIGN_IN} still exists: sign in once, then delete it")
    if not (root / "proxy.d").is_dir():
        report.errors.append("proxy.d/ is missing (the proxy mounts it); restore it with git checkout proxy.d")
    check_values(values, report)
    if probe_host:
        check_host(values, report, root=root, network=network)
    return report


# --- the interactive part -----------------------------------------------------------


def ask(prompt: str, default: str = "", *, secret: bool = False, validate=None) -> str:
    suffix = f" [{default}]" if default and not secret else (" [keep]" if default else "")
    while True:
        try:
            raw = getpass.getpass(f"{prompt}{suffix}: ") if secret else input(f"{prompt}{suffix}: ")
        except EOFError:
            raise SystemExit("\nconfigure: input ended; nothing written") from None
        value = raw.strip() or default
        if not value:
            print("  an answer is needed")
            continue
        if validate:
            try:
                validate(value)
            except ConfigError as exc:
                print(f"  {exc}")
                continue
        return value


def choose(prompt: str, options: dict, default: str) -> str:
    print(prompt)
    for name, text in options.items():
        print(f"  {name:<11} {text}")
    return ask("choice", default, validate=lambda v: None if v in options else _raise(f"one of {', '.join(options)}"))


def _raise(message: str):
    raise ConfigError(message)


def interview(answers: Answers, given: set, existing: dict) -> Answers:
    """Ask what the flags did not answer, defaulting to what .env holds."""
    if existing:
        print("Editing the existing .env: Enter keeps each current answer.\n")
    if "origin" not in given:
        answers.origin = ask(
            "Public origin, https://host[:port]",
            answers.origin,
            validate=lambda v: split_origin(v),
        )
    if "admin_email" not in given:
        answers.admin_email = ask(
            "Administrator's email (their first sign-in becomes an administrator)",
            answers.admin_email,
            validate=check_email,
        )
    if "preset" not in given:
        answers.preset = choose("Preset:", {n: p.summary for n, p in PRESETS.items()}, answers.preset)
    host = split_origin(answers.origin)[1]
    if "tls" not in given:
        tls_default = answers.tls
        if tls_default == "acme" and (is_ip(host) or "." not in host):
            tls_default = "internal"
        answers.tls = choose(
            "TLS:",
            {
                "acme": "a Let's Encrypt certificate (public DNS name, ports 80 and 443 open)",
                "internal": "Caddy's own CA; browsers warn (development, private networks)",
                "upstream": "TLS ends in front of this host, which gets plain HTTP",
            },
            tls_default,
        )
        refuse_tls(answers.tls, host)
    if answers.tls == "upstream" and "http_port" not in given:
        port = ask(
            "Port the TLS front forwards plain HTTP to, on this host",
            existing.get("HTTP_PORT", "80"),
            validate=lambda v: None if v.isdigit() and 0 < int(v) < 65536 else _raise("a port number"),
        )
        answers.http_port = int(port)
    if answers.preset == "satellite":
        answers.idp = "external"
        if "central_url" not in given:
            base = existing.get("CHAT_OPENAI_BASE_URL", "")
            answers.central_url = ask(
                "The central Pystino's origin, https://…",
                base[: -len("/v1")] if base.endswith("/v1") else "",
                validate=lambda v: None if v.startswith("https://") else _raise("an https:// URL"),
            )
    elif "idp" not in given:
        answers.idp = choose(
            "Identity provider:",
            {
                "authelia": "the bundled Authelia (users managed in the console)",
                "external": "your own OIDC issuer (Keycloak, Entra ID, Google, …)",
            },
            answers.idp,
        )
    if answers.idp == "authelia":
        refuse_authelia(host)
    else:
        origin = split_origin(answers.origin)[0]
        if "oidc_issuer" not in given and answers.preset != "satellite":
            answers.oidc_issuer = ask(
                "Issuer URL", existing.get("OIDC_ISSUER", ""),
                validate=lambda v: None if v.startswith("https://") else _raise("an https:// URL"),
            )
        if PRESETS[answers.preset].standalone is False and "oidc_console_client_secret" not in given:
            print(f"  Console client: redirect URI {origin}/auth/callback/default")
            answers.oidc_console_client_id = ask("  client id", existing.get("OIDC_CONSOLE_CLIENT_ID", "pystino-console"))
            answers.oidc_console_client_secret = ask(
                "  client secret", existing.get("OIDC_CONSOLE_CLIENT_SECRET", ""), secret=True
            )
        if "oidc_chat_client_secret" not in given:
            print(f"  Chat client: redirect URI {origin}/chat/login/callback")
            answers.oidc_chat_client_id = ask("  client id", existing.get("OIDC_CHAT_CLIENT_ID", "cerea"))
            answers.oidc_chat_client_secret = ask(
                "  client secret", existing.get("OIDC_CHAT_CLIENT_SECRET", ""), secret=True
            )
    if answers.preset == "generic" and "upstream_api_key" not in given:
        answers.upstream_base_url = ask(
            "OpenAI-compatible endpoint", existing.get("CHAT_OPENAI_BASE_URL", DEFAULT_UPSTREAM)
        )
        answers.upstream_api_key = ask("Its API key", existing.get("CHAT_OPENAI_API_KEY", ""), secret=True)
    print()
    return answers


# --- commands ---------------------------------------------------------------------


def import_smtp_env(root: Path) -> dict:
    """`pystino email export-env`'s output from the running gateway, as a dict.

    Prints and returns `{}` on any failure — a stack that is not up yet, or
    without the gateway profile — rather than raising: `--import-smtp` is a
    convenience over typing `--smtp-*` by hand, not a precondition of writing
    `.env` at all.
    """
    proc = _run(
        ["docker", "compose", "exec", "-T", "gateway", "pystino", "email", "export-env"],
        timeout=20, cwd=root,
    )
    if proc is None or proc.returncode != 0:
        detail = (proc.stderr.strip().splitlines() or ["?"])[-1] if proc else "docker not runnable"
        print(f"configure: --import-smtp: {detail}", file=sys.stderr)
        return {}
    values = {}
    for line in proc.stdout.splitlines():
        key, sep, value = line.partition("=")
        if sep and KEY.match(key):
            values[key] = value
    return values


def cmd_configure(args, root: Path) -> int:
    env_path = root / ".env"
    template = (root / ".env.example").read_text(encoding="utf-8")
    existing = parse_env(env_path.read_text(encoding="utf-8")) if env_path.exists() else {}
    answers = answers_from(existing) if existing else Answers()
    given = set()
    for attr in Answers.__dataclass_fields__:
        value = getattr(args, attr, None)
        if value is not None:
            setattr(answers, attr, value)
            given.add(attr)
    if args.upstream_api_key_env:
        answers.upstream_api_key = os.environ.get(args.upstream_api_key_env, "")
        given.add("upstream_api_key")
    if args.admin_password_file:
        answers.admin_password = Path(args.admin_password_file).read_text(encoding="utf-8").strip()
        given.add("admin_password")
    if args.import_smtp:
        imported = import_smtp_env(root)
        for key, attr in (
            ("SMTP_HOST", "smtp_host"), ("SMTP_USERNAME", "smtp_username"),
            ("SMTP_PASSWORD", "smtp_password"), ("SMTP_FROM", "smtp_from"),
            ("SMTP_SECURITY", "smtp_security"),
        ):
            if key in imported:
                setattr(answers, attr, imported[key])
                given.add(attr)
        if "SMTP_PORT" in imported:
            try:
                answers.smtp_port = int(imported["SMTP_PORT"])
                given.add("smtp_port")
            except ValueError:
                pass

    interactive = not args.non_interactive and sys.stdin.isatty()
    if interactive:
        answers = interview(answers, given, existing)
    else:
        # An external IdP's admin rule (--admin-email, or --admin-claim with
        # --admin-claim-value) is validated in build(), with a message
        # naming both options; only the bundled Authelia's bootstrap door
        # is unconditionally required this early.
        required = ["origin"]
        if answers.idp != "external":
            required.append("admin_email")
        missing = [f"--{n.replace('_', '-')}" for n in required if not getattr(answers, n)]
        if missing:
            print(f"configure: non-interactive, and {' and '.join(missing)} not given", file=sys.stderr)
            return 2
    try:
        result = build(answers, existing, template)
        text = render(template, result.values, HEADER)
    except ConfigError as exc:
        print(f"configure: {exc}", file=sys.stderr)
        return 2

    if existing and parse_env(text) == existing:
        print(f"{env_path} is already up to date; nothing written")
    else:
        saved = backup(env_path)
        write_private(env_path, text)
        print(f"wrote {env_path} (mode 0600)" + (f"; the previous one is {saved.name}" if saved else ""))
    for note in result.notes:
        print(f"note: {note}")
    if result.admin_password:
        path = root / FIRST_SIGN_IN
        write_private(
            path,
            f"Cerea: the first sign-in, shown nowhere else.\n"
            f"URL:      {result.values['PUBLIC_ORIGIN']}/\n"
            f"User:     {result.values['AUTHELIA_ADMIN_USER']}\n"
            f"Password: {result.admin_password}\n"
            f"Email:    {result.values['AUTHELIA_ADMIN_EMAIL']} (becomes administrator on first sign-in)\n"
            f"Change the password after signing in, then delete this file.\n",
        )
        print(f"the first sign-in is in {path} (mode 0600): read it, sign in, delete it")
    values = result.values
    print()
    print(f"  origin    {values['PUBLIC_ORIGIN']}   (TLS {values['TLS_MODE']})")
    print(f"  preset    {values['PYSTINO_PRESET']}   profiles {values['COMPOSE_PROFILES']}")
    print(f"  identity  {values['OIDC_ISSUER']}")
    print()
    print("next:  ./configure --check  &&  docker compose up -d --wait")
    return 0


def cmd_set(args, root: Path) -> int:
    env_path = root / ".env"
    if not env_path.exists():
        print("configure: no .env yet; run ./configure first", file=sys.stderr)
        return 2
    template = (root / ".env.example").read_text(encoding="utf-8")
    values = parse_env(env_path.read_text(encoding="utf-8"))
    changes = []
    for item in args.set or []:
        key, sep, value = item.partition("=")
        if not sep or not KEY.match(key):
            print(f"configure: --set expects KEY=VALUE, got {item!r}", file=sys.stderr)
            return 2
        if values.get(key) != value:
            values[key] = value
            changes.append(key)
    for key in args.unset or []:
        if not KEY.match(key):
            print(f"configure: --unset expects a KEY, got {key!r}", file=sys.stderr)
            return 2
        if key in values:
            del values[key]
            changes.append(key)
    if not changes:
        print(".env already says so; nothing written")
        return 0
    try:
        text = render(template, values, HEADER)
    except ConfigError as exc:
        print(f"configure: {exc}", file=sys.stderr)
        return 2
    write_private(env_path, text)
    print(f"updated {', '.join(changes)} in {env_path}; apply with `docker compose up -d`")
    return 0


def cmd_check(args, root: Path) -> int:
    report = check(root, network=not args.offline)
    for line in report.errors:
        print(f"ERROR  {line}")
    for line in report.warnings:
        print(f"WARN   {line}")
    for line in report.notes:
        print(f"note   {line}")
    print("ok" if report.ok else f"{len(report.errors)} error(s)")
    return 0 if report.ok else 1


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="./configure",
        description="Write this deployment's .env (asking only what it cannot decide), or check it.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Presets:\n" + "\n".join(f"  {n:<11} {pr.summary}" for n, pr in PRESETS.items()),
    )
    mode = p.add_argument_group("what to do (default: write .env)")
    mode.add_argument("--check", action="store_true", help="check .env and this host; change nothing")
    mode.add_argument("--offline", action="store_true", help="with --check: skip DNS and port probes")
    mode.add_argument("--set", nargs="+", metavar="KEY=VALUE", help="change values in .env, no questions")
    mode.add_argument("--unset", nargs="+", metavar="KEY", help="remove values from .env")
    mode.add_argument("--non-interactive", action="store_true", help="ask nothing; fail on a missing answer")
    mode.add_argument("--dir", help=argparse.SUPPRESS)

    q = p.add_argument_group("the questions")
    q.add_argument("--origin", help="public origin, https://host[:port]")
    q.add_argument("--admin-email", help="the administrator's email")
    q.add_argument("--preset", choices=list(PRESETS))
    q.add_argument("--tls", choices=TLS_MODES, help="acme | internal | upstream")
    q.add_argument("--idp", choices=IDPS, help="authelia (bundled) | external")

    o = p.add_argument_group("optional")
    o.add_argument("--agents", action=argparse.BooleanOptionalAction, default=None,
                   help="agent machines (/chat/code and galopin)")
    o.add_argument("--project", help="compose project name (default cerea)")
    o.add_argument("--http-port", type=int, help="host port for HTTP (upstream mode: what the front forwards to)")
    o.add_argument("--https-port", type=int, help="host port for HTTPS")
    o.add_argument("--public-bind", help="address the proxy binds (default 0.0.0.0)")
    o.add_argument("--acme-email", help="Let's Encrypt account email")
    o.add_argument("--admin-user", help="bundled Authelia: the first account's user name (default admin)")
    o.add_argument("--admin-name", help="bundled Authelia: its display name")
    o.add_argument("--admin-password-file", help="bundled Authelia: read the first password from this file "
                   "instead of minting one")
    o.add_argument("--oidc-issuer", help="external IdP: the issuer URL")
    o.add_argument("--oidc-internal-base-url", help="external IdP: a URL for it inside the network")
    o.add_argument("--oidc-console-client-id")
    o.add_argument("--oidc-console-client-secret")
    o.add_argument("--oidc-chat-client-id")
    o.add_argument("--oidc-chat-client-secret")
    o.add_argument("--oidc-groups-claim")
    o.add_argument("--oidc-logout-url", help="external IdP without end_session_endpoint; {redirect} = landing")
    o.add_argument("--admin-claim", help="external IdP: a dotted claim path that can confer admin (e.g. groups)")
    o.add_argument("--admin-claim-value", help="external IdP: comma-separated values of --admin-claim that confer it")
    o.add_argument("--link-by-email", action=argparse.BooleanOptionalAction, default=None,
                   help="a verified email at sign-in attaches to the existing account with it")
    o.add_argument("--machine-client-id", help="galopin's public client id (default opencode-enrollment)")
    o.add_argument("--group-sync", choices=("every_login", "first_login", "never"),
                   help="how often the directory's answer about groups is applied")
    o.add_argument("--smtp-host")
    o.add_argument("--smtp-port", type=int)
    o.add_argument("--smtp-username")
    o.add_argument("--smtp-password", help="prefer --import-smtp: argv is visible")
    o.add_argument("--smtp-from")
    o.add_argument("--smtp-security", choices=("starttls", "tls", "none"))
    o.add_argument("--import-smtp", action="store_true",
                   help="read GATEWAY_SMTP__* from the running gateway's environment "
                   "(docker compose exec gateway pystino email export-env) instead of typing it here")
    o.add_argument("--central-url", help="satellite: the central Pystino's origin")
    o.add_argument("--upstream-base-url", help="the gateway's first provider (generic: the chat's endpoint)")
    o.add_argument("--upstream-api-key", help="its key (prefer --upstream-api-key-env: argv is visible)")
    o.add_argument("--upstream-api-key-env", metavar="VAR", help="read that key from this environment variable")
    return p


def main(argv: list | None = None) -> int:
    args = parser().parse_args(argv)
    root = Path(args.dir).resolve() if args.dir else ROOT
    if args.check:
        return cmd_check(args, root)
    if args.set or args.unset:
        return cmd_set(args, root)
    return cmd_configure(args, root)


if __name__ == "__main__":
    sys.exit(main())
