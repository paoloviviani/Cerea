# Cerea sandbox host (kit/sandbox/compose.yaml): copy to .env, chmod 600, set the token.
# Every value is optional except the token. Empty means the default shown in the comments.
# The chat host does not read this file: it is told the manager's address and token by
# ./configure --sandbox remote. Docs: docs/sandboxes.md.

COMPOSE_PROJECT_NAME='cerea-sandbox'
# Where the manager listens on this host. 127.0.0.1 behind a TLS reverse proxy on the same host, or a
# private address (a VPN or LAN interface). Never 0.0.0.0 on an untrusted network without TLS.
SANDBOX_BIND='127.0.0.1'
SANDBOX_PORT='8080'
# The service token: openssl rand -hex 32. The manager refuses to start without it.
SANDBOX_MANAGER_TOKEN=''
# The manager's own image (default: this release's cerea-sandbox).
SANDBOX_IMAGE=''
# gVisor's runtime name (default runsc). runc is refused unless SANDBOX_ALLOW_RUNC=true, which is
# for development and tests only: sandboxes then share the host kernel.
SANDBOX_RUNTIME=''
SANDBOX_ALLOW_RUNC=''
# Hosted agent machines (class P, a later phase of ADR 0115): refused unless true, and not built yet.
SANDBOX_MACHINES_ENABLED=''
# The image a sandbox runs (default: this release's cerea-sandbox-python). The manager pulls it on first use.
SANDBOX_EXEC_IMAGE=''
# The Docker socket the proxy reads, and the numeric group that owns it (`stat -c %g /var/run/docker.sock`;
# default 999). Rootless Docker: point the first at its socket.
SANDBOX_DOCKER_SOCKET_HOST=''
SANDBOX_DOCKER_GID=''
# Totals. The budget they imply, worst case: SANDBOX_MAX_LEASES x the memory below, plus the
# services (about 0.4 GB). The defaults suit a host with 8-16 GB to spare: 8 leases x 1024 MB = 8 GB, 8 CPUs at most (caps, not reservations). On a 4-8 GB box lower SANDBOX_MAX_LEASES to 3-4. With execute_code on the server, each conversation running code holds one lease.
#   max concurrent sandboxes overall (default 8) and per owner (default 3: the conversations one user can run code in at once; the next one falls back to the browser and says so)
SANDBOX_MAX_LEASES=''
SANDBOX_MAX_LEASES_PER_OWNER=''
#   warm pool of pristine sandboxes (default 0; reserved: the pool arrives with step 2)
SANDBOX_WARM_POOL_SIZE=''
#   a sandbox with no call for this long is released (default 1200 s; at most SANDBOX_MAX_IDLE_SECONDS, 3600),
#   and none lives longer than SANDBOX_MAX_LIFETIME_SECONDS (default 14400)
SANDBOX_IDLE_SECONDS=''
SANDBOX_MAX_IDLE_SECONDS=''
SANDBOX_MAX_LIFETIME_SECONDS=''
# Per sandbox: the default, and the most a request may ask for (a request above it is refused).
#   memory MB (default 1024, max 2048: numpy, pandas and matplotlib need it), CPUs (default 1, max 2), processes (default 256, max 1024)
SANDBOX_EXEC_MEMORY_MB=''
SANDBOX_EXEC_MAX_MEMORY_MB=''
SANDBOX_EXEC_CPUS=''
SANDBOX_EXEC_MAX_CPUS=''
SANDBOX_EXEC_PIDS=''
SANDBOX_EXEC_MAX_PIDS=''
#   workspace size in MB (default 256, max 1024): a RAM-backed tmpfs, so it counts against the memory
SANDBOX_EXEC_WORKSPACE_MB=''
SANDBOX_EXEC_MAX_WORKSPACE_MB=''
#   wall time of one call in seconds (default 30, max 300); output of one call in bytes
#   (default 256 KiB, max 1 MiB: more is cut and the call is marked truncated)
SANDBOX_EXEC_TIMEOUT_SECONDS=''
SANDBOX_EXEC_MAX_TIMEOUT_SECONDS=''
SANDBOX_EXEC_MAX_OUTPUT_BYTES=''
SANDBOX_EXEC_MAX_OUTPUT_BYTES_CAP=''
#   the largest file put into or read from a sandbox (default 8 MiB)
SANDBOX_MAX_FILE_BYTES=''
#   requests the manager handles at once (default 16; more get 503) and, of those, file transfers (default 4)
SANDBOX_MAX_INFLIGHT=''
SANDBOX_MAX_FILE_TRANSFERS=''
# The services themselves: memory, CPUs and processes. Defaults: manager 512 MB (see the sizing page before lowering it),
# 0.5 CPU, 128 processes; socket proxy 128 MB, 0.25 CPU, 64 processes.
SANDBOX_MANAGER_MEM_LIMIT=''
SANDBOX_MANAGER_CPUS=''
SANDBOX_MANAGER_PIDS=''
SANDBOX_PROXY_MEM_LIMIT=''
SANDBOX_PROXY_CPUS=''
SANDBOX_PROXY_PIDS=''
