@dataclass(frozen=True)
class Preset:
    name: str
    summary: str
    profiles: tuple
    values: dict

    @property
    def standalone(self) -> bool:
        """Cerea without a local gateway (the satellite and generic presets)."""
        return "gateway" not in self.profiles


