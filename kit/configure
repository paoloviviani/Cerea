KEY = re.compile(r"^[A-Z_][A-Z0-9_]*$")


class ConfigError(ValueError):
    """An answer that would produce a deployment which cannot work."""


# --- scopes ---------------------------------------------------------------------


def fetch_discovery(issuer: str, timeout: float = 8.0) -> dict | None:
    """The issuer's OIDC discovery document, or None when it cannot be read.

    The public issuer URL, from this host: the back-channel address (the
    bundled Authelia's, say) only resolves inside the compose network.
    """
    import urllib.request

    url = issuer.rstrip("/") + "/.well-known/openid-configuration"
    request = urllib.request.Request(url, headers={"User-Agent": "cerea-configure", "Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            document = json.load(response)
    except (OSError, ValueError):
        return None
    return document if isinstance(document, dict) else None


def supported_scopes(discovery: dict | None) -> list | None:
    """`scopes_supported`, or None when the document does not say."""
    listed = (discovery or {}).get("scopes_supported")
    if isinstance(listed, list) and listed and all(isinstance(s, str) for s in listed):
        return listed
    return None


#: RFC 8628. Without it galopin cannot enroll: a machine has no browser, and
#: the device flow is the one grant that works without one.
DEVICE_CODE_GRANT = "urn:ietf:params:oauth:grant-type:device_code"
# GitLab (Doorkeeper) lists the grant as the short "device_code" and publishes
# no device endpoint; galopin accepts both spellings and derives the endpoint.
DEVICE_CODE_GRANTS = (DEVICE_CODE_GRANT, "device_code")
DOORKEEPER_AUTHORIZE = "/oauth/authorize"


def idp_check_detail(proc) -> str:
    """The lines of `pystino idp check` output that say why it failed.

    Report lines naming FAILED, MISSING or "does NOT match"; the last line of
    output when none does (a crash, a traceback).
    """
    out = (proc.stdout or "").strip().splitlines() or (proc.stderr or "").strip().splitlines()
    bad = [
        line.strip() for line in out
        if "FAILED" in line or "MISSING" in line or "does NOT match" in line
    ]
    # The final "idp check: FAILED" summary adds nothing next to a cause.
    causes = [line for line in bad if line != "idp check: FAILED"]
    return "; ".join(causes or bad or [out[-1].strip() if out else "?"])


def device_flow_problem(discovery: dict | None) -> str | None:
    """Why this issuer cannot run galopin's enrollment, or None when it can.

    A `device_authorization_endpoint` in discovery is the requirement; when
    the issuer also publishes `grant_types_supported`, it must list the
    device grant there too. None discovery (unreachable) is not a device
    problem: --check reports that separately.
    """
    if not discovery:
        return None
    grants = discovery.get("grant_types_supported")
    listed = isinstance(grants, list) and any(g in DEVICE_CODE_GRANTS for g in grants)
    authorize = str(discovery.get("authorization_endpoint") or "").rstrip("/")
    doorkeeper = authorize.endswith(DOORKEEPER_AUTHORIZE) and authorize != DOORKEEPER_AUTHORIZE
    if not discovery.get("device_authorization_endpoint") and not (listed and doorkeeper):
        return (
            "the issuer's discovery publishes no device_authorization_endpoint, "
            "so galopin cannot enroll: agent machines will not work with it"
        )
    if isinstance(grants, list) and grants and not listed:
        return (
            "the issuer's grant_types_supported omits the device flow "
            f"({DEVICE_CODE_GRANT}), so galopin cannot enroll: agent machines "
            "will not work with it"
        )
    return None


def compute_scopes(discovery: dict | None) -> tuple:
    """(scopes to request, wanted scopes dropped), from the issuer's discovery.

    The wanted set intersected with `scopes_supported`; `openid` always stays,
    as no OIDC login works without it. No `scopes_supported` means the default.
    """
    listed = supported_scopes(discovery)
    if listed is None:
        return list(WANTED_SCOPES), []
    scopes = [s for s in WANTED_SCOPES if s == "openid" or s in listed]
    return scopes, [s for s in WANTED_SCOPES if s not in scopes]


def scopes_json(scopes: str) -> str:
    """The gateway's list-typed setting wants JSON; the chat's takes the words."""
    return json.dumps(scopes.split(), separators=(",", ":"))


# --- .env files ------------------------------------------------------------------


def parse_env(text: str) -> dict:
    """Compose's .env rules, as far as this stack needs them.

    Single quotes are literal; double quotes take the usual backslash escapes;
    an unquoted value ends at ` #`.
    """
    values = {}
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export ") :].lstrip()
        key, sep, value = line.partition("=")
        key = key.strip()
        if not sep or not KEY.match(key):
            raise ConfigError(f"line {number}: expected KEY=VALUE, got {raw!r}")
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] == "'":
            value = value[1:-1]
        elif len(value) >= 2 and value[0] == value[-1] == '"':
            value = bytes(value[1:-1], "utf-8").decode("unicode_escape")
        else:
            value = re.split(r"\s+#", value, maxsplit=1)[0].strip()
        values[key] = value
    return values


def quote(key: str, value: str) -> str:
    if "'" in value or "\n" in value:
        raise ConfigError(f"{key}: a value holding a single quote or a newline cannot be written")
    return f"{key}='{value}'"


_ACTIVE = re.compile(r"^([A-Z_][A-Z0-9_]*)=")
_COMMENTED = re.compile(r"^# ([A-Z_][A-Z0-9_]*)='[^']*'$")


def template_keys(template: str) -> tuple:
    """(active keys, commented-out keys) of .env.example, in order."""
    active, commented = [], []
    for line in template.splitlines():
        m = _ACTIVE.match(line)
        if m:
            active.append(m.group(1))
            continue
        m = _COMMENTED.match(line)
        if m:
            commented.append(m.group(1))
    return active, commented


def render(template: str, values: dict, header: str) -> str:
    """.env.example's layout with these values.

    An active line takes its key's value. A commented-out example line becomes
    active when its key has a value, and stays a comment otherwise. Keys the
    template does not name go into a final section, so nothing is lost.
    """
    out, seen = [], set()
    lines = template.splitlines()
    # The template's own header (up to the first blank line) is for readers
    # of the example; the written file gets a short one of its own.
    first_blank = lines.index("") if "" in lines else 0
    out.extend(header.splitlines())
    for line in lines[first_blank:]:
        m = _ACTIVE.match(line)
        if m:
            key = m.group(1)
            seen.add(key)
            if key in values:
                out.append(quote(key, values[key]))
            continue
        m = _COMMENTED.match(line)
        if m and m.group(1) in values and m.group(1) not in seen:
            seen.add(m.group(1))
            out.append(quote(m.group(1), values[m.group(1)]))
            continue
        out.append(line)
    extra = [k for k in values if k not in seen]
    if extra:
        out += ["", "# --- Not in .env.example (kept as found) " + "-" * 38, ""]
        out += [quote(k, values[k]) for k in extra]
    return "\n".join(out).rstrip("\n") + "\n"


def write_private(path: Path, text: str) -> None:
    """Atomically, at mode 0600 from the first byte."""
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def backup(path: Path) -> Path | None:
    if not path.exists():
        return None
    stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    target = path.with_name(f"{path.name}.bak-{stamp}")
    n = 1
    while target.exists():
        target = path.with_name(f"{path.name}.bak-{stamp}-{n}")
        n += 1
    write_private(target, path.read_text(encoding="utf-8"))
    return target


def _utc_backup(path: Path) -> Path | None:
    """Like `backup`, but stamped in UTC (ADR 0093 §10 step 1).

    `--break-glass` runs unattended, often from a script reacting to an
    incident in whatever timezone it happens to run in; a recovery
    procedure's own audit trail should not depend on the host's local
    timezone setting to read back. The ordinary `backup` (interactive
    `./configure`, local time, matching what an operator watching the
    terminal just typed) is untouched.
    """
    if not path.exists():
        return None
    stamp = _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    target = path.with_name(f"{path.name}.bak-{stamp}")
    n = 1
    while target.exists():
        target = path.with_name(f"{path.name}.bak-{stamp}-{n}")
        n += 1
    write_private(target, path.read_text(encoding="utf-8"))
    return target


HEADER = """\
# Written by ./configure. The deployment's one configuration file; every key
# is explained in .env.example. Edit it by hand or re-run ./configure (which
# keeps your secrets and edits), then: ./configure --check && docker compose up -d
# Mode 0600: it holds every secret. Back it up with the volumes."""


# --- secrets and digests ---------------------------------------------------------


def mint(nbytes: int) -> str:
    return secrets.token_hex(nbytes)


# --- VAPID keys (Web Push) --------------------------------------------------------
# A P-256 key pair, base64url, the form browsers' pushManager.subscribe takes
# (the 65-byte uncompressed public point) and the chat's sender reads. The
# standard library has no elliptic curves and ./configure runs with nothing
# installed, so the public point is derived here with plain integer maths
# rather than by shelling out to openssl (whose output format varies).
_P256_P = 0xFFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFF
_P256_N = 0xFFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551
_P256_G = (
    0x6B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C296,
    0x4FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F5,
)


def _p256_add(a, b):
    if a is None:
        return b
    if b is None:
        return a
    (x1, y1), (x2, y2) = a, b
    if x1 == x2 and (y1 + y2) % _P256_P == 0:
        return None
    if a == b:
        lam = (3 * x1 * x1 - 3) * pow(2 * y1, -1, _P256_P) % _P256_P
    else:
        lam = (y2 - y1) * pow(x2 - x1, -1, _P256_P) % _P256_P
    x3 = (lam * lam - x1 - x2) % _P256_P
    return x3, (lam * (x1 - x3) - y1) % _P256_P


def p256_public(private: bytes) -> bytes:
    """The uncompressed public point (65 bytes) of a 32-byte P-256 private key."""
    d = int.from_bytes(private, "big")
    if not 0 < d < _P256_N:
        raise ValueError("not a valid P-256 private key")
    result, addend = None, _P256_G
    while d:
        if d & 1:
            result = _p256_add(result, addend)
        addend = _p256_add(addend, addend)
        d >>= 1
    assert result is not None
    return b"\x04" + result[0].to_bytes(32, "big") + result[1].to_bytes(32, "big")


def _b64url(raw: bytes) -> str:
    return base64.urlsafe_b64encode(raw).decode().rstrip("=")


def _unb64url(text: str) -> bytes:
    return base64.urlsafe_b64decode(text + "=" * (-len(text) % 4))


def mint_vapid() -> tuple[str, str]:
    """(private, public), both base64url."""
    while True:
        private = secrets.token_bytes(32)
        if 0 < int.from_bytes(private, "big") < _P256_N:
            return _b64url(private), _b64url(p256_public(private))


def vapid_pair_problem(private: str, public: str) -> str | None:
    """Why a stored pair is unusable, or None. A pair that disagrees would make
    every push fail at the push service, so it is reported rather than served."""
    try:
        return None if _b64url(p256_public(_unb64url(private))) == public else "the public key is not the private key's"
    except ValueError as exc:
        return str(exc)
    except Exception:  # noqa: BLE001 - malformed base64 and the like
        return "not base64url P-256 keys"


def _ab64(raw: bytes) -> str:
    # The "adapted base64" of crypt(3)-style digests: no padding, '.' for '+'.
    return base64.b64encode(raw).decode().rstrip("=").replace("+", ".")


def _un_ab64(text: str) -> bytes:
    text = text.replace(".", "+")
    return base64.b64decode(text + "=" * (-len(text) % 4))


PBKDF2_ROUNDS = 310000


def pbkdf2_digest(secret: str, *, rounds: int = PBKDF2_ROUNDS, salt: bytes | None = None) -> str:
    """An Authelia-compatible `$pbkdf2-sha512$` digest (argon2 is not in the stdlib)."""
    salt = salt or os.urandom(16)
    raw = hashlib.pbkdf2_hmac("sha512", secret.encode(), salt, rounds)
    return f"$pbkdf2-sha512${rounds}${_ab64(salt)}${_ab64(raw)}"


_CRYPT64 = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
# glibc's byte order for SHA512-crypt's output: 21 triples, then byte 63.
_SHA512_CRYPT_ORDER = [(i, (i + 21) % 63, (i + 42) % 63) for i in (0, 22, 44, 3, 25, 47, 6, 28, 50, 9,
                                                                   31, 53, 12, 34, 56, 15, 37, 59, 18, 40, 62)]
SHA512_CRYPT_ROUNDS = 100000


def sha512_crypt(secret: str, *, rounds: int = SHA512_CRYPT_ROUNDS, salt: str | None = None) -> str:
    """A `$6$` (SHA512-crypt) digest, Ulrich Drepper's algorithm.

    For the first Authelia password: the gateway's bootstrap accepts argon2 or
    `$6$` there, and argon2 is not in the standard library (`crypt` left it
    in Python 3.13). Authelia verifies it as sha2crypt.
    """
    if salt is None:
        salt = "".join(secrets.choice(_CRYPT64) for _ in range(16))
    key, salt_b = secret.encode(), salt.encode()[:16]
    sha = hashlib.sha512
    b = sha(key + salt_b + key).digest()
    a = sha(key + salt_b)
    n = len(key)
    while n > 64:
        a.update(b)
        n -= 64
    a.update(b[:n])
    n = len(key)
    while n:
        a.update(b if n & 1 else key)
        n >>= 1
    a_digest = a.digest()
    p = (sha(key * len(key)).digest() * (len(key) // 64 + 1))[: len(key)]
    s = (sha(salt_b * (16 + a_digest[0])).digest() * (len(salt_b) // 64 + 1))[: len(salt_b)]
    c = a_digest
    for i in range(rounds):
        h = sha(p if i & 1 else c)
        if i % 3:
            h.update(s)
        if i % 7:
            h.update(p)
        h.update(c if i & 1 else p)
        c = h.digest()
    out = []
    for i, j, k in _SHA512_CRYPT_ORDER:
        w = (c[i] << 16) | (c[j] << 8) | c[k]
        for _ in range(4):
            out.append(_CRYPT64[w & 0x3F])
            w >>= 6
    w = c[63]
    for _ in range(2):
        out.append(_CRYPT64[w & 0x3F])
        w >>= 6
    prefix = "$6$" if rounds == 5000 else f"$6$rounds={rounds}$"
    return f"{prefix}{salt_b.decode()}${''.join(out)}"


def digest_matches(secret: str, digest: str) -> bool | None:
    """True/False for a digest we can verify ($6$, pbkdf2-sha512); None otherwise."""
    if digest.startswith("$6$"):
        parts = digest.split("$")
        rounds = 5000
        if len(parts) == 5 and parts[2].startswith("rounds="):
            rounds, salt = int(parts[2][len("rounds="):]), parts[3]
        elif len(parts) == 4:
            salt = parts[2]
        else:
            return False
        return hmac.compare_digest(sha512_crypt(secret, rounds=rounds, salt=salt), digest)
    parts = digest.split("$")
    if len(parts) != 5 or parts[1] != "pbkdf2-sha512":
        return None
    try:
        rounds, salt, want = int(parts[2]), _un_ab64(parts[3]), _un_ab64(parts[4])
    except (ValueError, TypeError):
        return False
    got = hashlib.pbkdf2_hmac("sha512", secret.encode(), salt, rounds)
    return hmac.compare_digest(got, want)


# --- origin rules ----------------------------------------------------------------


def is_ip(host: str) -> bool:
    try:
        ipaddress.ip_address(host)
    except ValueError:
        return False
    return True


def split_origin(origin: str) -> tuple:
    """(normalised origin, host, port or None). Refuses what cannot work."""
    parts = urlsplit(origin.strip())
    if parts.scheme != "https":
        raise ConfigError(
            f"the public origin must be https:// (got {origin!r}); browsers reach the stack "
            "over TLS in every mode, upstream included"
        )
    if not parts.hostname or parts.path not in ("", "/") or parts.query or parts.fragment:
        raise ConfigError(f"the public origin must be https://host[:port], got {origin!r}")
    try:
        port = parts.port
    except ValueError:
        raise ConfigError(f"the public origin has an invalid port: {origin!r}") from None
    return f"https://{parts.netloc.lower()}", parts.hostname.lower(), port


def check_email(email: str) -> str:
    email = email.strip()
    local, _, domain = email.rpartition("@")
    if not local or "." not in domain or domain.startswith(".") or domain.endswith("."):
        # The chat refuses an issuer-local address such as admin@local with an
        # error that reads like a broken login; refuse it here instead.
        raise ConfigError(f"the administrator email must be a real address (user@domain.tld), got {email!r}")
    return email


def refuse_tls(tls: str, host: str) -> None:
    if tls not in TLS_MODES:
        raise ConfigError(f"TLS mode must be one of {', '.join(TLS_MODES)}")
    if tls == "acme" and (is_ip(host) or "." not in host):
        raise ConfigError(
            "TLS mode acme needs a public DNS name; for an IP or a private host use "
            "--tls internal, or --tls upstream when TLS ends in front of this host"
        )


def refuse_authelia(host: str) -> None:
    # Authelia validates the session cookie domain itself: it accepts a dotted
    # name or an IPv4 address (a browser stores and returns a Domain cookie set
    # to an identical IP, RFC 6265 section 5.1.3), and rejects a single-word name.
    if is_ip(host):
        if ":" in host:
            raise ConfigError(
                "the bundled Authelia is not set up for an IPv6 address; use an IPv4 address, "
                "a dotted DNS name, or bring an external IdP (--idp external)"
            )
        return
    if "." not in host:
        raise ConfigError(
            f"the bundled Authelia does not accept the single-word host name {host!r}; use a dotted "
            "DNS name (cerea.example.org), an IP address, a name that resolves to your IP "
            "(10-0-0-5.sslip.io), or bring an external IdP (--idp external)"
        )


def default_sni_for(tls: str, host: str) -> str:
    """Browsers send no SNI to an IP, and Docker's port mapping hides the address
    the client dialled, so Caddy needs to be told which certificate to serve."""
    return f"default_sni {host}" if tls == "internal" and is_ip(host) else ""


def site_for(tls: str, host: str) -> tuple:
    if tls == "upstream":
        # TLS ends in front of us: plain HTTP inside, on HTTP_PORT.
        return "http://:80", ""
    return f"https://{host}", ("tls internal" if tls == "internal" else "")


# --- the MongoDB image --------------------------------------------------------
#
# MongoDB 8 is the default; 4.4 is what runs where 8 cannot. Two host facts
# decide it, and both are read here rather than guessed:
#
#   - MongoDB 5.0 and later need AVX on x86-64 (a few small VPS hosts and some
#     low-power CPUs lack it). Under Docker Desktop on macOS the VM's CPU is
#     what counts, not the Mac's: /proc/cpuinfo does not exist on the host, so
#     the choice falls back to 4.4 and says why; see the README to check the VM.
#   - MongoDB 8.0 refuses to start on Linux kernels 6.19 to 7.0.13 (its
#     vendored TCMalloc and the kernel's rseq change, SERVER-121912); 7.0.14
#     and later are fixed. Distribution suffixes (7.0.0-38-generic) are
#     ignored: the upstream x.y.z is what counts.
#
# The pins are exact patch versions so a pull never changes the database under
# a running install. MONGO_DEFAULT is also compose.yaml's default for a .env
# that names no MONGO_IMAGE (a unit test keeps the two equal). An install from
# before this setting has its data on 4.4, which 8 cannot open: it must pin
# MONGO_IMAGE=mongo:4.4.30 (or move with tools/mongo-upgrade), and configure
# says so. A fresh install on a host that cannot run 8 gets the 4.4 pin written.

MONGO_DEFAULT = "mongo:8.0.34"
MONGO_FALLBACK = "mongo:4.4.30"
#: Kernels MongoDB 8 cannot run on, inclusive.
MONGO8_BAD_KERNELS = ((6, 19, 0), (7, 0, 13))


def cpu_has_avx(cpuinfo: str | None, machine: str) -> bool | None:
    """True/False for x86-64 from /proc/cpuinfo's flags; None when it cannot be told.

    Only x86-64 has an AVX rule here: another architecture, or no cpuinfo
    (macOS, a restricted container), answers None and the caller stays safe.
    """
    if machine not in ("x86_64", "AMD64", "amd64") or not cpuinfo:
        return None
    flags = []
    for line in cpuinfo.splitlines():
        key, _, value = line.partition(":")
        if key.strip() == "flags":
            flags = value.split()
            break
    if not flags:
        return None
    return "avx" in flags


def kernel_version(release: str) -> tuple | None:
    """The upstream (major, minor, patch) of `uname -r`; None when it does not parse."""
    m = re.match(r"^(\d+)\.(\d+)(?:\.(\d+))?", release.strip())
    if not m:
        return None
    return int(m.group(1)), int(m.group(2)), int(m.group(3) or 0)


def mongo8_kernel_broken(release: str) -> bool | None:
    version = kernel_version(release)
    if version is None:
        return None
    low, high = MONGO8_BAD_KERNELS
    return low <= version <= high


def detect_host() -> tuple:
    """(avx, kernel release) of this host: avx is True, False or None (unknown)."""
    try:
        cpuinfo = Path("/proc/cpuinfo").read_text(encoding="utf-8", errors="replace")
    except OSError:
        cpuinfo = None
    return cpu_has_avx(cpuinfo, platform.machine()), platform.release()


@dataclass(frozen=True)
class MongoChoice:
    image: str
    reason: str


def choose_mongo(avx: bool | None, release: str) -> MongoChoice:
    """The image for a fresh install on this host, and why."""
    if avx is None:
        return MongoChoice(
            MONGO_FALLBACK,
            f"MONGO_IMAGE={MONGO_FALLBACK}: this host's AVX support could not be read (MongoDB 5+ needs it; "
            "on Docker Desktop check the VM, see the README). To use MongoDB 8: "
            f"./configure --set MONGO_IMAGE={MONGO_DEFAULT}",
        )
    if not avx:
        return MongoChoice(
            MONGO_FALLBACK,
            f"MONGO_IMAGE={MONGO_FALLBACK}: this CPU has no AVX, which MongoDB 5 and later need",
        )
    broken = mongo8_kernel_broken(release)
    if broken:
        return MongoChoice(
            MONGO_FALLBACK,
            f"MONGO_IMAGE={MONGO_FALLBACK}: Linux {release} is in the range (6.19 to 7.0.13) where "
            "MongoDB 8 does not start; kernel 7.0.14 or later fixes it",
        )
    if broken is None:
        return MongoChoice(
            MONGO_FALLBACK,
            f"MONGO_IMAGE={MONGO_FALLBACK}: the kernel version {release!r} could not be read (MongoDB 8 "
            f"fails on 6.19 to 7.0.13). To use MongoDB 8: ./configure --set MONGO_IMAGE={MONGO_DEFAULT}",
        )
    return MongoChoice(MONGO_DEFAULT, f"MONGO_IMAGE={MONGO_DEFAULT}: this host has AVX and a kernel MongoDB 8 runs on")


def mongo_series(image: str) -> tuple | None:
    """(major, minor) of an official `mongo:X.Y[.Z]` reference; None for any other image."""
    m = re.match(r"^(?:docker\.io/)?(?:library/)?mongo:(\d+)\.(\d+)(?:[.@-]|$)", image.strip())
    return (int(m.group(1)), int(m.group(2))) if m else None


def mongo_image_problems(image: str, avx: bool | None, release: str) -> list:
    """Why this image cannot run on this host: an empty list when it can, or when unknowable."""
    series = mongo_series(image)
    if series is None:
        return []
    problems = []
    if series[0] >= 5 and avx is False:
        problems.append(
            f"MONGO_IMAGE={image} needs AVX, which this CPU lacks (MongoDB 5 and later); "
            f"use {MONGO_FALLBACK}"
        )
    if series[0] == 8 and mongo8_kernel_broken(release):
        problems.append(
            f"MONGO_IMAGE={image} does not start on Linux {release} (MongoDB 8 fails on kernels "
            f"6.19 to 7.0.13); use {MONGO_FALLBACK} or update the kernel"
        )
    return problems


# --- answers -> values -----------------------------------------------------------


@dataclass
class Answers:
    origin: str = ""
    admin_email: str = ""
    preset: str = "team"
    tls: str = "acme"
    idp: str = "authelia"
    agents: bool | None = None
    terminal: bool | None = None
    # The headless browser (the fetch profile): None leaves it to the preset
    # and to a hand-enabled profile; True/False add or remove it.
    fetch: bool | None = None
    # Office previews and the convert_document tool (the office profile:
    # Gotenberg). Off unless asked for; None leaves it as it is.
    office: bool | None = None
    # The bundled S3-compatible object store for the chat's files (the rustfs
    # profile: RustFS). Off unless asked for; None leaves it as it is.
    rustfs: bool | None = None
    project: str | None = None
    http_port: int | None = None
    https_port: int | None = None
    public_bind: str | None = None
    acme_email: str | None = None
    admin_user: str | None = None
    admin_name: str | None = None
    admin_password: str | None = None
    # External IdP.
    oidc_issuer: str | None = None
    oidc_internal_base_url: str | None = None
    oidc_console_client_id: str | None = None
    oidc_console_client_secret: str | None = None
    oidc_chat_client_id: str | None = None
    oidc_chat_client_secret: str | None = None
    oidc_groups_claim: str | None = None
    oidc_scopes: str | None = None
    oidc_logout_url: str | None = None
    # Who is an administrator (external IdP only; the bundled Authelia uses
    # admin_email as its bootstrap address instead).
    admin_claim: str | None = None
    admin_claim_value: str | None = None
    link_by_email: bool | None = None
    machine_client_id: str | None = None
    group_sync: str | None = None
    # External IdP: import the group names it reports by hand (manual, the
    # default) or create them on first sight (auto).
    group_import: str | None = None
    # Who may join (ADR 0095): open, approval, invite or group. group needs
    # the local group names too, and says what a stranger without one gets.
    join_mode: str | None = None
    required_groups: str | None = None
    group_fallback: str | None = None
    # Mail: quota notices, "send test", and (bundled Authelia) its own
    # self-service reset.
    smtp_host: str | None = None
    smtp_port: int | None = None
    smtp_username: str | None = None
    smtp_password: str | None = None
    smtp_from: str | None = None
    smtp_security: str | None = None
    # Satellite and generic presets, and the gateway's first provider.
    central_url: str | None = None
    upstream_base_url: str | None = None
    upstream_api_key: str | None = None


@dataclass
class Result:
    values: dict
    #: The minted first password, for first-sign-in.txt; never printed.
    admin_password: str | None = None
    notes: list = field(default_factory=list)


def template_defaults(template: str) -> dict:
    return parse_env("\n".join(line for line in template.splitlines() if _ACTIVE.match(line)))


def answers_from(values: dict) -> Answers:
    """What an existing .env answered, so a re-run starts from it."""
    profiles = {p for p in values.get("COMPOSE_PROFILES", "").split(",") if p}
    return Answers(
        origin=values.get("PUBLIC_ORIGIN", ""),
        admin_email=values.get("PYSTINO_BOOTSTRAP_ADMIN_EMAIL", ""),
        preset=values.get("PYSTINO_PRESET", "team") or "team",
        tls=values.get("TLS_MODE", "acme") or "acme",
        idp="authelia" if "authelia" in profiles or not profiles else "external",
        agents=values.get("CODE_AGENTS_ENABLED", "") == "true",
        terminal=values.get("CODE_TERMINAL_ENABLED", "") == "true",
        office="office" in profiles,
        rustfs="rustfs" in profiles,
    )


def build(answers: Answers, existing: dict, template: str, discovery: dict | None = None,
          mongo: MongoChoice | None = None) -> Result:
    """Every value the stack reads, from the answers and what .env already holds.

    Pure apart from randomness: no file is read or written here, so every rule
    is a unit test. `discovery` is the external issuer's discovery document,
    fetched by the caller (None: unreadable or not fetched). `mongo` is the host's
    MongoDB choice (None: not asked, as in the unit tests, and no key is written).
    """
    fresh = not existing
    values = dict(template_defaults(template))
    # The example's placeholders are never real values on a fresh install.
    for key in ("PUBLIC_ORIGIN", "SITE_ADDRESS", "ACME_EMAIL", "OIDC_ISSUER",
                "OIDC_LOGOUT_URL", "AUTHELIA_COOKIE_DOMAIN", "PYSTINO_BOOTSTRAP_ADMIN_EMAIL",
                "AUTHELIA_ADMIN_EMAIL"):
        values[key] = ""
    values.update(existing)
    before = answers_from(existing) if existing else None
    result = Result(values=values)
    notes = result.notes

    if answers.preset not in PRESETS:
        raise ConfigError(f"unknown preset {answers.preset!r}; choose one of {', '.join(PRESETS)}")
    preset = PRESETS[answers.preset]
    origin, host, origin_port = split_origin(answers.origin)
    refuse_tls(answers.tls, host)
    idp = answers.idp
    if preset.name == "satellite" and idp != "external":
        # One directory: the central gateway accepts only its own issuer's tokens.
        idp = "external"
        notes.append("satellite: the IdP is the central Pystino's (external)")
    if idp not in IDPS:
        raise ConfigError(f"the IdP must be one of {', '.join(IDPS)}")
    if idp == "authelia":
        refuse_authelia(host)
    # The bundled Authelia's bootstrap door needs an address; an external IdP
    # does not, on its own — an admin rule does (checked below, once it is
    # known whether a claim rule was given instead), and the bootstrap
    # address is honoured only with the bundled IdP anyway.
    if idp == "authelia":
        admin_email = check_email(answers.admin_email)
    else:
        admin_email = (answers.admin_email or "").strip()
        if admin_email:
            admin_email = check_email(admin_email)

    def changed(attr: str) -> bool:
        return before is None or getattr(before, attr) != getattr(answers, attr)

    # No PYSTINO_PRESET: a .env from elsewhere (Pystino's own deploy/, which
    # has no chat), so the preset's profiles and switches apply in full.
    preset_changed = before is None or not existing.get("PYSTINO_PRESET") or before.preset != preset.name
    idp_changed = before is None or before.idp != idp

    # --- compose ----------------------------------------------------------------
    values["PYSTINO_CONFIG_VERSION"] = CONFIG_VERSION
    if answers.project:
        values["COMPOSE_PROJECT_NAME"] = answers.project
    values.setdefault("COMPOSE_PROJECT_NAME", "cerea")
    if preset_changed:
        profiles = list(preset.profiles)
    else:
        # Keep profiles the operator switched on by hand (fetch on team, say).
        profiles = [p for p in values.get("COMPOSE_PROFILES", "").split(",") if p]
        profiles = [p for p in profiles if p != "authelia"]
    if idp == "authelia":
        profiles.append("authelia")
    if answers.fetch is True and "fetch" not in profiles:
        profiles.append("fetch")
    elif answers.fetch is False:
        profiles = [p for p in profiles if p != "fetch"]
    if answers.office is True and "office" not in profiles:
        profiles.append("office")
    elif answers.office is False:
        profiles = [p for p in profiles if p != "office"]
    if answers.rustfs is True and "rustfs" not in profiles:
        profiles.append("rustfs")
    elif answers.rustfs is False:
        if values.get("CHAT_BLOB_STORE") == "s3" and values.get("CHAT_S3_ENDPOINT") == RUSTFS_ENDPOINT:
            raise ConfigError(
                "the chat keeps its files in the bundled object store (CHAT_BLOB_STORE=s3 at "
                f"{RUSTFS_ENDPOINT}): removing the rustfs profile would make them unreachable. "
                "Copy them elsewhere first (docs/storage.md), then set CHAT_BLOB_STORE and CHAT_S3_* "
                "to the new store and remove the profile by hand"
            )
        profiles = [p for p in profiles if p != "rustfs"]
    profiles = [p for p in PROFILES if p in profiles] + [p for p in profiles if p not in PROFILES]
    values["COMPOSE_PROFILES"] = ",".join(dict.fromkeys(profiles))
    # The chat's renderer address follows the fetch profile. An address that
    # is not ours (a renderer elsewhere) is left alone.
    if "fetch" in profiles:
        values.setdefault("PLAYWRIGHT_WS_ENDPOINT", PLAYWRIGHT_ENDPOINT)
        values["PLAYWRIGHT_WS_ENDPOINT"] = values["PLAYWRIGHT_WS_ENDPOINT"] or PLAYWRIGHT_ENDPOINT
    elif values.get("PLAYWRIGHT_WS_ENDPOINT") in ("", PLAYWRIGHT_ENDPOINT):
        values.pop("PLAYWRIGHT_WS_ENDPOINT", None)
    elif values.get("PLAYWRIGHT_WS_ENDPOINT") and answers.fetch is False:
        notes.append(
            f"fetch off, but PLAYWRIGHT_WS_ENDPOINT points at a renderer elsewhere "
            f"({values['PLAYWRIGHT_WS_ENDPOINT']}): left as it is"
        )
    # The chat's converter address follows the office profile, like the
    # renderer's above: one that is not ours (a Gotenberg elsewhere) is kept.
    if "office" in profiles:
        values["CHAT_GOTENBERG_URL"] = values.get("CHAT_GOTENBERG_URL") or GOTENBERG_ENDPOINT
    elif values.get("CHAT_GOTENBERG_URL") in ("", GOTENBERG_ENDPOINT):
        values.pop("CHAT_GOTENBERG_URL", None)
    elif values.get("CHAT_GOTENBERG_URL") and answers.office is False:
        notes.append(
            f"office previews off, but CHAT_GOTENBERG_URL points at a converter elsewhere "
            f"({values['CHAT_GOTENBERG_URL']}): left as it is"
        )
    # The chat's file store follows the rustfs profile. The profile always gets
    # its address, bucket and keys (minted once, never re-minted: they are what
    # the stored files are reachable with). Whether the chat *uses* it is a
    # separate switch, CHAT_BLOB_STORE: a fresh install gets s3, but an existing
    # install keeps GridFS until the operator has copied its files across
    # (docs/storage.md), because flipping the store under existing files would
    # hide every one of them. A store that is not ours (BYO S3) is left alone.
    if "rustfs" in profiles:
        foreign = values.get("CHAT_S3_ENDPOINT") not in (None, "", RUSTFS_ENDPOINT)
        if foreign:
            notes.append(
                f"object store profile on, but CHAT_S3_ENDPOINT points at a store elsewhere "
                f"({values['CHAT_S3_ENDPOINT']}): left as it is"
            )
        else:
            values["CHAT_S3_ENDPOINT"] = RUSTFS_ENDPOINT
            values["CHAT_S3_REGION"] = values.get("CHAT_S3_REGION") or "us-east-1"
            values["CHAT_S3_BUCKET"] = values.get("CHAT_S3_BUCKET") or RUSTFS_BUCKET
            values["CHAT_S3_FORCE_PATH_STYLE"] = "true"
            values["CHAT_S3_CREATE_BUCKET"] = "true"
            if not values.get("CHAT_S3_ACCESS_KEY_ID"):
                values["CHAT_S3_ACCESS_KEY_ID"] = mint(10)
            if not values.get("CHAT_S3_SECRET_ACCESS_KEY"):
                values["CHAT_S3_SECRET_ACCESS_KEY"] = mint(32)
            if fresh and "CHAT_BLOB_STORE" not in existing:
                values["CHAT_BLOB_STORE"] = "s3"
            elif values.get("CHAT_BLOB_STORE") != "s3":
                notes.append(
                    "the object store (RustFS) is running, but the chat still keeps its files in "
                    "MongoDB. To move them: scripts/blobs-migrate.mjs, then CHAT_BLOB_STORE='s3' "
                    "(docs/storage.md)"
                )

    # --- MongoDB ------------------------------------------------------------------
    # Chosen once, for a fresh install, and then the operator's. An existing
    # .env without the key now means compose's default, MongoDB 8, which cannot
    # open data left by 4.4: nothing is written (we cannot tell where the data
    # is), but the note says what to pin.
    if "chat" in profiles and not values.get("MONGO_IMAGE"):
        if fresh and mongo is not None:
            values["MONGO_IMAGE"] = mongo.image
            notes.append(mongo.reason)
        elif not fresh:
            notes.append(
                f"MONGO_IMAGE is not set, and compose now runs MongoDB 8 ({MONGO_DEFAULT}), which cannot "
                f"open data left by 4.4. If this install's data is on 4.4, pin it before starting: "
                f"./configure --set MONGO_IMAGE={MONGO_FALLBACK} (or move to 8 with tools/mongo-upgrade)"
            )
    values["PYSTINO_PRESET"] = preset.name
    if preset_changed:
        values.update(preset.values)
        if not fresh:
            notes.append(f"preset {preset.name}: feature switches reset to the preset's")
    else:
        for key, value in preset.values.items():
            values.setdefault(key, value)

    # --fetch / --no-fetch: the backend follows, after the preset's own switches.
    if answers.fetch is True:
        values["FETCH_BACKEND"] = "playwright"
    elif answers.fetch is False and not values.get("PLAYWRIGHT_WS_ENDPOINT"):
        # Back to direct fetching, unless a renderer elsewhere is still wired.
        values["FETCH_BACKEND"] = "direct"

    # --- origin and TLS -----------------------------------------------------------
    values["PUBLIC_ORIGIN"] = origin
    values["TLS_MODE"] = answers.tls
    values["SITE_ADDRESS"], values["TLS_DIRECTIVE"] = site_for(answers.tls, host)
    values["DEFAULT_SNI_DIRECTIVE"] = default_sni_for(answers.tls, host)
    if answers.https_port is not None:
        values["HTTPS_PORT"] = str(answers.https_port)
    elif origin_port and (fresh or changed("origin")):
        values["HTTPS_PORT"] = str(origin_port)
    elif fresh:
        values["HTTPS_PORT"] = "443"
    if answers.http_port is not None:
        values["HTTP_PORT"] = str(answers.http_port)
    if answers.public_bind:
        values["PUBLIC_BIND"] = answers.public_bind
    old_host = split_origin(before.origin)[1] if before and before.origin.startswith("https://") else None
    if answers.acme_email:
        values["ACME_EMAIL"] = answers.acme_email
    elif not values.get("ACME_EMAIL") or values.get("ACME_EMAIL") == f"admin@{old_host}":
        values["ACME_EMAIL"] = "admin@example.org" if is_ip(host) else f"admin@{host}"
    values["PROXY_DEFAULT"] = "chat" if preset.standalone else "gateway"

    # --- secrets: minted once, never re-minted ------------------------------------
    for key, nbytes in MINTED.items():
        if not values.get(key):
            values[key] = mint(nbytes)

    # --- Web Push (VAPID): minted once, never re-minted ------------------------------
    # An existing pair is left alone even if the subject changes, since a
    # re-minted pair strands every browser subscribed to the old public key.
    # A private key without its public half only has the half derived.
    if not values.get("CHAT_VAPID_PRIVATE_KEY"):
        values["CHAT_VAPID_PRIVATE_KEY"], values["CHAT_VAPID_PUBLIC_KEY"] = mint_vapid()
    elif not values.get("CHAT_VAPID_PUBLIC_KEY"):
        try:
            values["CHAT_VAPID_PUBLIC_KEY"] = _b64url(p256_public(_unb64url(values["CHAT_VAPID_PRIVATE_KEY"])))
        except Exception:  # noqa: BLE001 - check_values reports it
            pass
    if not values.get("CHAT_VAPID_SUBJECT"):
        values["CHAT_VAPID_SUBJECT"] = f"mailto:{admin_email}" if admin_email else origin

    # --- where the chat sends model calls -------------------------------------------
    for key in ("CHAT_OPENAI_BASE_URL", "CHAT_OPENAI_API_KEY", "CHAT_USE_USER_TOKEN"):
        if preset_changed:
            values.pop(key, None)
    if preset.name == "satellite":
        central = (answers.central_url or "").strip().rstrip("/")
        if not central:
            base = values.get("CHAT_OPENAI_BASE_URL", "")
            central = base[: -len("/v1")] if base.endswith("/v1") else ""
        if not central.startswith("https://"):
            raise ConfigError("the satellite preset needs --central-url https://<central Pystino>")
        if answers.upstream_api_key:
            # A stored key would bill every user of this site to one account.
            raise ConfigError("a satellite stores no API key: every call carries the user's token")
        values.update(
            CHAT_OPENAI_BASE_URL=f"{central}/v1", CHAT_OPENAI_API_KEY="", CHAT_USE_USER_TOKEN="true"
        )
        if not answers.oidc_issuer and (idp_changed or not values.get("OIDC_ISSUER")):
            answers.oidc_issuer = f"{central}/authelia"
    elif preset.name == "generic":
        key = answers.upstream_api_key or values.get("CHAT_OPENAI_API_KEY", "")
        if not key:
            raise ConfigError("the generic preset needs the endpoint's API key (--upstream-api-key)")
        values.update(
            CHAT_OPENAI_BASE_URL=answers.upstream_base_url
            or values.get("CHAT_OPENAI_BASE_URL")
            or DEFAULT_UPSTREAM,
            CHAT_OPENAI_API_KEY=key,
            # Forced: user-token mode would send people's IdP tokens to a third party.
            CHAT_USE_USER_TOKEN="false",
        )
    else:
        # Pystino mode: people's own tokens (compose's default), never a shared
        # key, whatever an older .env held.
        values.pop("CHAT_OPENAI_API_KEY", None)
        values.pop("CHAT_USE_USER_TOKEN", None)
        if answers.upstream_base_url:
            values["GATEWAY_UPSTREAM__BASE_URL"] = answers.upstream_base_url
        if answers.upstream_api_key is not None:
            values["GATEWAY_UPSTREAM__API_KEY"] = answers.upstream_api_key
    if preset.standalone:
        values["GATEWAY_UPSTREAM__API_KEY"] = ""

    # --- agent machines -------------------------------------------------------------
    if answers.agents is not None:
        values["CODE_AGENTS_ENABLED"] = "true" if answers.agents else ""
    # The browser terminal rides on agent machines: without them there is
    # nothing to open a shell on, so it is off whatever was asked.
    if answers.terminal is not None or answers.agents is False:
        on = bool(answers.terminal) and values.get("CODE_AGENTS_ENABLED") == "true"
        values["CODE_TERMINAL_ENABLED"] = "true" if on else ""

    # --- identity -------------------------------------------------------------------
    values["PYSTINO_BOOTSTRAP_ADMIN_EMAIL"] = admin_email
    if answers.group_sync:
        values["OIDC_GROUP_SYNC"] = answers.group_sync
    values.setdefault("OIDC_GROUP_SYNC", "every_login")
    if answers.link_by_email is not None:
        values["OIDC_LINK_BY_EMAIL"] = "true" if answers.link_by_email else "false"
    values.setdefault("OIDC_LINK_BY_EMAIL", "false")
    if answers.machine_client_id:
        values["OIDC_MACHINE_CLIENT_ID"] = answers.machine_client_id
    values.setdefault("OIDC_MACHINE_CLIENT_ID", "opencode-enrollment")
    # ADR 0095: who may join. Only an answer (or an existing value) is
    # written: absent, the gateway's own default (open) stands, so an upgrade
    # never changes behaviour. `group` without names would start a gate that
    # refuses everyone but the administrators — the gateway refuses to start
    # in that state, so configure refuses to write it.
    if answers.join_mode:
        mode = answers.join_mode.strip()
        if mode not in ("open", "approval", "invite", "group"):
            raise ConfigError("--join-mode must be one of open, approval, invite, group")
        names = [n.strip() for n in (answers.required_groups or "").split(",") if n.strip()]
        if mode == "group":
            if not names:
                raise ConfigError(
                    "--join-mode group needs --required-groups: local group names, comma-"
                    "separated (import or map the directory's names on Console > Groups "
                    "first). Or start with approval and switch in the console."
                )
            values["OIDC_REQUIRED_GROUPS"] = ",".join(names)
            if answers.group_fallback:
                if answers.group_fallback not in ("refuse", "approval"):
                    raise ConfigError("--group-fallback must be refuse or approval")
                values["OIDC_GROUP_FALLBACK"] = answers.group_fallback
        values["OIDC_JOIN_MODE"] = mode
        if mode == "group":
            result.notes.append(
                "group mode: the required groups are local names — a directory name must "
                "be imported or mapped on Console > Groups before it grants access"
            )

    # --- mail -------------------------------------------------------------------
    for attr, key in (
        ("smtp_host", "SMTP_HOST"),
        ("smtp_username", "SMTP_USERNAME"),
        ("smtp_password", "SMTP_PASSWORD"),
        ("smtp_from", "SMTP_FROM"),
        ("smtp_security", "SMTP_SECURITY"),
    ):
        value = getattr(answers, attr)
        if value is not None:
            values[key] = value
    if answers.smtp_port is not None:
        values["SMTP_PORT"] = str(answers.smtp_port)
    if answers.smtp_host is not None:
        # Setting the host is what turns mail on; a later edit that clears it
        # (--smtp-host '') turns it back off rather than leaving a stale
        # SMTP_ENABLED=true with nothing to connect to.
        values["SMTP_ENABLED"] = "true" if answers.smtp_host else "false"
    values.setdefault("SMTP_ENABLED", "false")
    values.setdefault("SMTP_PORT", "587")
    values.setdefault("SMTP_SECURITY", "starttls")

    if idp == "authelia":
        values.update(
            OIDC_ISSUER=f"{origin}/authelia",
            OIDC_INTERNAL_BASE_URL=AUTHELIA_INTERNAL,
            OIDC_KIND="authelia",
            OIDC_CONSOLE_CLIENT_ID="pystino-console",
            OIDC_CHAT_CLIENT_ID="cerea",
            OIDC_GROUPS_CLAIM="groups",
            # Authelia offers every scope the stack wants.
            OIDC_SCOPES=" ".join(WANTED_SCOPES),
            OIDC_AUDIENCE="pystino-api",
            # Authelia publishes no end_session_endpoint; the chat signs out
            # through the portal's /logout, {redirect} = where to land.
            OIDC_LOGOUT_URL=f"{origin}/authelia/logout?rd={{redirect}}",
            AUTHELIA_COOKIE_DOMAIN=host,
            AUTHELIA_ADMIN_EMAIL=admin_email,
        )
        for key, nbytes in MINTED_AUTHELIA.items():
            if not values.get(key):
                values[key] = mint(nbytes)
        for secret_key, digest_key in DIGESTS.items():
            secret = values.get(secret_key, "")
            digest = values.get(digest_key, "")
            if not secret:
                secret = values[secret_key] = mint(32)
                digest = ""
            # A digest we cannot verify (argon2id from an older install) is kept.
            if not digest or digest_matches(secret, digest) is False:
                values[digest_key] = pbkdf2_digest(secret)
        if answers.admin_user:
            values["AUTHELIA_ADMIN_USER"] = answers.admin_user
        values["AUTHELIA_ADMIN_USER"] = values.get("AUTHELIA_ADMIN_USER") or "admin"
        if answers.admin_name:
            values["AUTHELIA_ADMIN_NAME"] = answers.admin_name
        values["AUTHELIA_ADMIN_NAME"] = values.get("AUTHELIA_ADMIN_NAME") or values["AUTHELIA_ADMIN_USER"]
        # $6$, not pbkdf2: the gateway's bootstrap accepts only argon2 or $6$ here.
        if answers.admin_password:
            values["AUTHELIA_ADMIN_PASSWORD_DIGEST"] = sha512_crypt(answers.admin_password)
        elif not values.get("AUTHELIA_ADMIN_PASSWORD_DIGEST"):
            password = secrets.token_urlsafe(18)
            values["AUTHELIA_ADMIN_PASSWORD_DIGEST"] = sha512_crypt(password)
            result.admin_password = password
    else:
        if idp_changed:
            # The bundled IdP's own values would be wrong for another issuer.
            for key in ("OIDC_ISSUER", "OIDC_INTERNAL_BASE_URL", "OIDC_LOGOUT_URL"):
                if values.get(key, "").startswith((f"{origin}/authelia", AUTHELIA_INTERNAL)):
                    values[key] = ""
            values["OIDC_KIND"] = "generic"
        old_issuer = values.get("OIDC_ISSUER", "")
        for attr, key in (
            ("oidc_issuer", "OIDC_ISSUER"),
            ("oidc_internal_base_url", "OIDC_INTERNAL_BASE_URL"),
            ("oidc_console_client_id", "OIDC_CONSOLE_CLIENT_ID"),
            ("oidc_console_client_secret", "OIDC_CONSOLE_CLIENT_SECRET"),
            ("oidc_chat_client_id", "OIDC_CHAT_CLIENT_ID"),
            ("oidc_chat_client_secret", "OIDC_CHAT_CLIENT_SECRET"),
            ("oidc_groups_claim", "OIDC_GROUPS_CLAIM"),
            ("oidc_logout_url", "OIDC_LOGOUT_URL"),
        ):
            value = getattr(answers, attr)
            if value is not None:
                values[key] = value.rstrip("/") if key.endswith(("ISSUER", "BASE_URL")) else value
        # The scopes follow the issuer: asked for what it offers, so a provider
        # that rejects an unknown scope (invalid_scope) still signs people in.
        # Worked out when the issuer is new or no scopes were ever written, and
        # then left alone: a hand-edited list survives a re-run.
        if answers.oidc_scopes is not None:
            words = answers.oidc_scopes.replace(",", " ").split()
            if "openid" not in words:
                raise ConfigError("--oidc-scopes must include openid")
            values["OIDC_SCOPES"] = " ".join(dict.fromkeys(words))
        elif idp_changed or values.get("OIDC_ISSUER") != old_issuer or "OIDC_SCOPES" not in existing:
            scopes, dropped = compute_scopes(discovery)
            values["OIDC_SCOPES"] = " ".join(scopes)
            if discovery is None:
                notes.append(
                    "could not read the issuer's discovery document: asking for the default scopes "
                    f"({values['OIDC_SCOPES']}); ./configure --check says whether it supports them"
                )
            if dropped:
                notes.append(
                    f"the issuer does not offer the {', '.join(dropped)} scope(s), so none is asked for "
                    f"(requesting {values['OIDC_SCOPES']}). Group features then depend on the IdP "
                    "putting a groups claim in its tokens anyway (see OIDC_GROUPS_CLAIM)"
                )
        values.setdefault("OIDC_KIND", "generic")
        if idp_changed and values.get("OIDC_KIND") == "authelia":
            values["OIDC_KIND"] = "generic"
        if not values.get("OIDC_ISSUER"):
            raise ConfigError("an external IdP needs its issuer (--oidc-issuer)")
        if not values["OIDC_ISSUER"].startswith("https://"):
            raise ConfigError("the external issuer must be an https:// URL")
        if not preset.standalone and not values.get("OIDC_CONSOLE_CLIENT_SECRET"):
            raise ConfigError(
                "an external IdP needs the console's client secret (--oidc-console-client-secret); "
                f"register redirect URI {origin}/auth/callback/default"
            )
        if not values.get("OIDC_CHAT_CLIENT_SECRET"):
            raise ConfigError(
                "an external IdP needs the chat's client secret (--oidc-chat-client-secret); "
                f"register redirect URI {origin}/chat/login/callback"
            )
        if answers.admin_claim is not None:
            values["OIDC_ADMIN_CLAIM"] = answers.admin_claim
        if answers.admin_claim_value is not None:
            values["OIDC_ADMIN_CLAIM_VALUE"] = answers.admin_claim_value
        if bool(values.get("OIDC_ADMIN_CLAIM")) != bool(values.get("OIDC_ADMIN_CLAIM_VALUE")):
            raise ConfigError(
                "--admin-claim and --admin-claim-value must be set together, or not at all"
            )
        # An external IdP has no bootstrap door (that is the bundled
        # Authelia's only): admin_email answers OIDC_ADMIN_EMAIL directly
        # here, unless a claim rule was given instead.
        if not values.get("OIDC_ADMIN_CLAIM"):
            values["OIDC_ADMIN_EMAIL"] = admin_email
        if answers.group_import is not None:
            values["OIDC_GROUP_IMPORT"] = answers.group_import
        # An older .env has no such line: the gateway's own default (manual)
        # is what it gets, written down so the operator can see it.
        values["OIDC_GROUP_IMPORT"] = values.get("OIDC_GROUP_IMPORT") or "manual"
        if not values.get("OIDC_ADMIN_EMAIL") and not values.get("OIDC_ADMIN_CLAIM"):
            raise ConfigError(
                "an external identity provider needs an admin rule: --admin-email, or "
                "--admin-claim with --admin-claim-value"
            )
    # The gateway's setting is a JSON list; written from the one list above.
    values["OIDC_SCOPES_JSON"] = scopes_json(values.get("OIDC_SCOPES", ""))
    return result


# --- --check ----------------------------------------------------------------------


@dataclass
class Report:
    errors: list = field(default_factory=list)
    warnings: list = field(default_factory=list)
    notes: list = field(default_factory=list)

    @property
    def ok(self) -> bool:
        return not self.errors


def _run(cmd: list, timeout: int = 30, cwd: Path | None = None) -> subprocess.CompletedProcess | None:
    if shutil.which(cmd[0]) is None:
        return None
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=cwd)
    except (OSError, subprocess.SubprocessError):
        return None


def compose_version() -> tuple | None:
    proc = _run(["docker", "compose", "version", "--short"], timeout=20)
    if not proc or proc.returncode != 0:
        return None
    m = re.search(r"(\d+)\.(\d+)", proc.stdout)
    return (int(m.group(1)), int(m.group(2))) if m else None


def local_addresses() -> set:
    addrs = {"127.0.0.1", "::1"}
    proc = _run(["ip", "-o", "addr", "show"], timeout=5)
    if proc and proc.returncode == 0:
        for m in re.finditer(r"\binet6? ([0-9a-fA-F:.]+)/", proc.stdout):
            addrs.add(m.group(1))
    try:
        addrs.update(socket.gethostbyname_ex(socket.gethostname())[2])
    except OSError:
        pass
    return addrs


def resolve(host: str) -> set:
    try:
        return {info[4][0] for info in socket.getaddrinfo(host, None)}
    except OSError:
        return set()


def reachable(host: str, port: int, timeout: float = 4.0) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def model_mode_problems(values: dict) -> list:
    """What in .env mixes the chat's two modes, one sentence each; empty when it does not.

    The chat runs in exactly one mode and refuses to start on a mix (issue #16):

    - Pystino mode (every preset but `generic`): each person's own token to the
      Pystino gateway, and no shared key.
    - Standalone mode (`generic`): one shared key to one endpoint, no personal
      tokens (there is no gateway to present them to).

    `CHAT_USE_USER_TOKEN` is `true` when unset, as compose.yaml defaults it.
    """
    tokens = values.get("CHAT_USE_USER_TOKEN", "true") == "true"
    key = values.get("CHAT_OPENAI_API_KEY", "")
    if values.get("PYSTINO_PRESET") == "generic":
        return (
            [
                "the generic preset (one shared key, no gateway) has CHAT_USE_USER_TOKEN on: "
                "there is no gateway to present people's tokens to, and the chat would refuse to start"
            ]
            if tokens
            else []
        )
    problems = []
    if key:
        problems.append(
            "CHAT_OPENAI_API_KEY holds a shared key while people's own tokens are used: that bypasses "
            "per-person access, billing and redaction, and the chat refuses to start"
        )
    if not tokens:
        problems.append(
            "CHAT_USE_USER_TOKEN is off on a Pystino preset: every call would bill to one shared key "
            "instead of the person"
        )
    return problems


def check_values(values: dict, report: Report) -> None:
    """Everything that can be said from .env alone."""
    profiles = {p for p in values.get("COMPOSE_PROFILES", "").split(",") if p}
    for key in REQUIRED:
        if not values.get(key):
            report.errors.append(f"{key} is missing or empty")
    for profile in sorted(profiles):
        if profile not in PROFILES:
            report.errors.append(f"COMPOSE_PROFILES names {profile!r}; known: {', '.join(PROFILES)}")
        for key in REQUIRED_BY_PROFILE.get(profile, ()):
            if not values.get(key):
                report.errors.append(f"{key} is missing or empty (needed by profile {profile!r})")
    if "gateway" not in profiles and "chat" not in profiles:
        report.errors.append("COMPOSE_PROFILES has neither gateway nor chat: nothing to serve")
    for problem in model_mode_problems(values):
        report.errors.append(f"{problem}; run ./configure to fix it")
    for key, why in RETIRED.items():
        if key in values:
            report.warnings.append(f"{key} is set but no longer read: {why}")
    if values.get("OIDC_SCOPES"):
        words = values["OIDC_SCOPES"].split()
        if "openid" not in words:
            report.errors.append("OIDC_SCOPES must include openid")
        if values.get("OIDC_SCOPES_JSON", scopes_json(values["OIDC_SCOPES"])) != scopes_json(values["OIDC_SCOPES"]):
            report.warnings.append(
                "OIDC_SCOPES_JSON (the gateway's) differs from OIDC_SCOPES (the chat's): "
                "set both with `./configure --set OIDC_SCOPES='...'`, which writes the JSON twin too"
            )
    if values.get("CHAT_VAPID_PRIVATE_KEY") or values.get("CHAT_VAPID_PUBLIC_KEY"):
        problem = vapid_pair_problem(values.get("CHAT_VAPID_PRIVATE_KEY", ""), values.get("CHAT_VAPID_PUBLIC_KEY", ""))
        if problem:
            report.warnings.append(
                f"CHAT_VAPID_PRIVATE_KEY / CHAT_VAPID_PUBLIC_KEY: {problem}; push notifications stay off "
                "until they are a pair (clear both and run ./configure to mint a new one)"
            )
    for key in ("PYSTINO_VERSION", "CEREA_VERSION"):
        registry = values.get(key.replace("VERSION", "REGISTRY"), "")
        if values.get(key) and registry != "local":
            report.warnings.append(
                f"{key}={values[key]} overrides the version compose.yaml pins; upgrades "
                "by get-kit.sh --upgrade will not move it. Remove it unless that is intended"
            )

    origin = values.get("PUBLIC_ORIGIN", "")
    try:
        origin, host, _ = split_origin(origin)
    except ConfigError as exc:
        report.errors.append(str(exc))
        return
    tls = values.get("TLS_MODE", "")
    try:
        refuse_tls(tls, host)
    except ConfigError as exc:
        report.errors.append(str(exc))
    else:
        want_site, want_directive = site_for(tls, host)
        if values.get("SITE_ADDRESS") != want_site or values.get("TLS_DIRECTIVE", "") != want_directive:
            report.errors.append(
                f"TLS_MODE={tls} needs SITE_ADDRESS='{want_site}' and TLS_DIRECTIVE='{want_directive}' "
                f"(found {values.get('SITE_ADDRESS')!r} and {values.get('TLS_DIRECTIVE', '')!r})"
            )
        want_sni = default_sni_for(tls, host)
        if values.get("DEFAULT_SNI_DIRECTIVE", "") != want_sni:
            report.errors.append(
                f"an IP host needs DEFAULT_SNI_DIRECTIVE='{want_sni}' (without it browsers get a TLS "
                f"error), found {values.get('DEFAULT_SNI_DIRECTIVE', '')!r}; run ./configure again"
                if want_sni else
                f"DEFAULT_SNI_DIRECTIVE must be empty here, found {values.get('DEFAULT_SNI_DIRECTIVE')!r}"
            )
        if tls == "internal":
            report.notes.append("TLS_MODE=internal: browsers will warn; fine for development only")
    if values.get("PROXY_DEFAULT", "gateway") == "gateway" and "gateway" not in profiles:
        report.errors.append("PROXY_DEFAULT=gateway but the gateway profile is off; set PROXY_DEFAULT='chat'")
    try:
        check_email(values.get("PYSTINO_BOOTSTRAP_ADMIN_EMAIL", ""))
    except ConfigError as exc:
        report.warnings.append(f"PYSTINO_BOOTSTRAP_ADMIN_EMAIL: {exc}")

    if "authelia" in profiles:
        try:
            refuse_authelia(host)
        except ConfigError as exc:
            report.errors.append(str(exc))
        if values.get("OIDC_ISSUER") != f"{origin}/authelia":
            report.errors.append(f"with the bundled Authelia, OIDC_ISSUER must be {origin}/authelia")
        if values.get("AUTHELIA_COOKIE_DOMAIN") and values["AUTHELIA_COOKIE_DOMAIN"] != host:
            report.errors.append(f"AUTHELIA_COOKIE_DOMAIN must be {host}, the origin's host")
        for secret_key, digest_key in DIGESTS.items():
            secret, digest = values.get(secret_key, ""), values.get(digest_key, "")
            if secret and digest and digest_matches(secret, digest) is False:
                report.errors.append(
                    f"{digest_key} is not a digest of {secret_key}: sign-in would fail; "
                    "re-run ./configure to recompute it"
                )
        if "chat" in profiles and not values.get("OIDC_LOGOUT_URL"):
            report.warnings.append(
                "OIDC_LOGOUT_URL is empty: signing out of the chat will not end the Authelia "
                f"session. Set OIDC_LOGOUT_URL='{origin}/authelia/logout?rd={{redirect}}'"
            )
    else:
        admin_claim = values.get("OIDC_ADMIN_CLAIM", "")
        admin_claim_value = values.get("OIDC_ADMIN_CLAIM_VALUE", "")
        if bool(admin_claim) != bool(admin_claim_value):
            report.errors.append(
                "OIDC_ADMIN_CLAIM and OIDC_ADMIN_CLAIM_VALUE must be set together, or not at all"
            )
        elif not values.get("OIDC_ADMIN_EMAIL") and not admin_claim:
            report.errors.append(
                "an external identity provider needs an admin rule: set OIDC_ADMIN_EMAIL, or "
                "OIDC_ADMIN_CLAIM and OIDC_ADMIN_CLAIM_VALUE (./configure --admin-email / "
                "--admin-claim --admin-claim-value)"
            )
    for entry in values.get("OIDC_ADMIN_EMAIL", "").split(","):
        entry = entry.strip()
        if not entry:
            continue
        try:
            check_email(entry)
        except ConfigError as exc:
            report.errors.append(f"OIDC_ADMIN_EMAIL: {exc}")
    if values.get("OIDC_GROUP_SYNC", "every_login") not in ("every_login", "first_login", "never"):
        report.errors.append(
            "OIDC_GROUP_SYNC must be every_login, first_login or never, got "
            f"{values.get('OIDC_GROUP_SYNC')!r}"
        )
    if values.get("OIDC_GROUP_IMPORT", "manual") not in ("manual", "auto"):
        report.errors.append(
            f"OIDC_GROUP_IMPORT must be manual or auto, got {values.get('OIDC_GROUP_IMPORT')!r}"
        )
    if values.get("OIDC_LINK_BY_EMAIL", "false") == "true":
        report.warnings.append(
            "OIDC_LINK_BY_EMAIL is on: a first sign-in with a verified email will attach to the "
            "existing non-admin account with that address. Turn it off when the transition is done."
        )
    if not values.get("SMTP_HOST"):
        if values.get("PYSTINO_PRESET") == "team":
            report.warnings.append(
                "SMTP_HOST is empty: users can't reset their own password. "
                "Set --smtp-host (and --smtp-username/--smtp-password/--smtp-from as needed)"
            )
        elif "authelia" in profiles:
            report.notes.append(
                "SMTP_HOST is empty: password resets are admin-issued one-time passwords"
            )
    else:
        for key in ("SMTP_HOST", "SMTP_USERNAME", "SMTP_FROM"):
            value = values.get(key, "")
            if value and _SMTP_UNSAFE.search(value):
                report.errors.append(
                    f"{key} contains whitespace, a quote or a newline, which the bundled "
                    f"Authelia's configuration can't render safely: {value!r}"
                )
        port = values.get("SMTP_PORT", "")
        if port and not port.isdigit():
            report.errors.append(f"SMTP_PORT must be a number, got {port!r}")
        if "authelia" in profiles and not values.get("AUTHELIA_RESET_PASSWORD_JWT_SECRET"):
            report.errors.append(
                "AUTHELIA_RESET_PASSWORD_JWT_SECRET is missing or empty (needed once SMTP_HOST "
                "is set, for the bundled Authelia's password-reset link)"
            )
    endpoint = values.get("PLAYWRIGHT_WS_ENDPOINT", "")
    if "fetch" in profiles and not endpoint:
        report.warnings.append(
            "the fetch profile is on but PLAYWRIGHT_WS_ENDPOINT is empty: the chat cannot reach the "
            f"renderer. Set PLAYWRIGHT_WS_ENDPOINT='{PLAYWRIGHT_ENDPOINT}'"
        )
    elif "fetch" not in profiles and endpoint == PLAYWRIGHT_ENDPOINT:
        report.warnings.append(
            f"PLAYWRIGHT_WS_ENDPOINT points at {PLAYWRIGHT_ENDPOINT} but the fetch profile is off: "
            "the admin screen will report the renderer unreachable. Unset it, or add fetch to "
            "COMPOSE_PROFILES"
        )
    gotenberg = values.get("CHAT_GOTENBERG_URL", "")
    if "office" in profiles and not gotenberg:
        report.warnings.append(
            "the office profile is on but CHAT_GOTENBERG_URL is empty: the chat cannot reach "
            f"Gotenberg, so there are no Office previews. Set CHAT_GOTENBERG_URL='{GOTENBERG_ENDPOINT}'"
        )
    elif "office" not in profiles and gotenberg == GOTENBERG_ENDPOINT:
        report.warnings.append(
            f"CHAT_GOTENBERG_URL points at {GOTENBERG_ENDPOINT} but the office profile is off: "
            "every preview and conversion will fail. Unset it, or add office to COMPOSE_PROFILES"
        )
    store = values.get("CHAT_BLOB_STORE", "")
    if store not in ("", "gridfs", "s3"):
        report.errors.append(f"CHAT_BLOB_STORE='{store}' is not 'gridfs' or 's3'")
    if store == "s3" and not values.get("CHAT_S3_BUCKET"):
        report.errors.append("CHAT_BLOB_STORE='s3' needs CHAT_S3_BUCKET (and, outside AWS, CHAT_S3_ENDPOINT)")
    if "rustfs" in profiles:
        if not (values.get("CHAT_S3_ACCESS_KEY_ID") and values.get("CHAT_S3_SECRET_ACCESS_KEY")):
            report.errors.append(
                "the rustfs profile is on but CHAT_S3_ACCESS_KEY_ID / CHAT_S3_SECRET_ACCESS_KEY are empty: "
                "run ./configure --object-store to mint them"
            )
    elif store == "s3" and values.get("CHAT_S3_ENDPOINT") == RUSTFS_ENDPOINT:
        report.warnings.append(
            f"CHAT_S3_ENDPOINT points at {RUSTFS_ENDPOINT} but the rustfs profile is off: every file "
            "will fail to load. Add rustfs to COMPOSE_PROFILES, or point the chat at another store"
        )
    if values.get("FETCH_BACKEND") == "playwright" and not endpoint:
        report.warnings.append(
            "FETCH_BACKEND=playwright with no renderer (PLAYWRIGHT_WS_ENDPOINT empty): web fetch "
            "will fail. Turn on the fetch profile, or set FETCH_BACKEND='direct'"
        )
    if values.get("REDACTION_NLP_ENGINE") == "spacy" and "redaction" in profiles:
        if not values.get("REDACTION_IMAGE", "").endswith("-ner"):
            report.errors.append(
                "REDACTION_NLP_ENGINE=spacy needs the NER image, which is never published: "
                "run dev/build.sh --ner (or set REDACTION_NLP_ENGINE='disabled')"
            )


def check_scopes(values: dict, report: Report) -> None:
    """Warn about scopes the external issuer's discovery does not list."""
    if values.get("OIDC_KIND") == "authelia":
        return
    issuer = values.get("OIDC_ISSUER", "")
    if not issuer.startswith("https://"):
        return
    discovery = fetch_discovery(issuer)
    if discovery is None:
        report.warnings.append(f"could not read {issuer}/.well-known/openid-configuration from here")
        return
    listed = supported_scopes(discovery)
    if listed is None:
        report.notes.append("the issuer's discovery lists no scopes_supported: scopes not checked")
        return
    asked = values.get("OIDC_SCOPES", "").split() or list(WANTED_SCOPES)
    unsupported = [s for s in asked if s not in listed]
    if unsupported:
        report.warnings.append(
            f"the issuer does not list the scope(s) {', '.join(unsupported)} in scopes_supported; some providers "
            "refuse the sign-in (invalid_scope). Remove them: ./configure --set OIDC_SCOPES='"
            + " ".join(s for s in asked if s in listed)
            + "'"
        )
    else:
        report.notes.append(f"the issuer offers every requested scope ({' '.join(asked)})")


def check_host(values: dict, report: Report, *, root: Path, network: bool) -> None:
    """What needs Docker, DNS or the network."""
    version = compose_version()
    if version is None:
        report.errors.append("`docker compose` is not available here (Docker Engine with Compose v2)")
    elif version < MIN_COMPOSE:
        report.errors.append(
            f"Docker Compose {version[0]}.{version[1]} is too old; {MIN_COMPOSE[0]}.{MIN_COMPOSE[1]}+ is needed"
        )
    else:
        proc = _run(["docker", "compose", "config", "--images"], timeout=60, cwd=root)
        if proc is None or proc.returncode != 0:
            detail = (proc.stderr.strip().splitlines() or ["?"])[-1] if proc else "docker not runnable"
            report.errors.append(f"docker compose config fails: {detail}")
        else:
            images = sorted({line.strip() for line in proc.stdout.splitlines() if line.strip()})
            local = [i for i in images if i.startswith("local/")]
            for image in local:
                probe = _run(["docker", "image", "inspect", image], timeout=20)
                if probe is not None and probe.returncode != 0:
                    report.errors.append(f"{image} is not on this host: run dev/build.sh")

    if not network:
        report.notes.append("--offline: DNS and port checks skipped")
        return

    if "gateway" in {p for p in values.get("COMPOSE_PROFILES", "").split(",") if p}:
        proc = _run(
            ["docker", "compose", "run", "--rm", "--no-deps", "gateway", "pystino", "idp",
             "check", "--discovery-only"],
            timeout=30, cwd=root,
        )
        if proc is None:
            report.notes.append("docker compose run is not available here; skipped pystino idp check")
        elif proc.returncode != 0:
            report.errors.append(f"pystino idp check --discovery-only failed: {idp_check_detail(proc)}")
        else:
            report.notes.append("pystino idp check --discovery-only: ok")

    try:
        _, host, _ = split_origin(values.get("PUBLIC_ORIGIN", ""))
    except ConfigError:
        return
    tls = values.get("TLS_MODE", "")
    addresses = resolve(host)
    if tls == "upstream":
        # TLS ends in front of this host: the name points at that front, and
        # 80/443 here are not the public path. Informational only.
        where = ", ".join(sorted(addresses)) or "nothing"
        report.notes.append(
            f"TLS_MODE=upstream: {host} resolves to {where} (the TLS front, not necessarily this host); "
            f"the front must forward plain HTTP to this host's port {values.get('HTTP_PORT', '80')}"
        )
        return
    if not addresses:
        (report.errors if tls == "acme" else report.warnings).append(
            f"{host} does not resolve from here" + (": Let's Encrypt cannot issue a certificate" if tls == "acme" else "")
        )
        return
    mine = local_addresses()
    if addresses & mine:
        report.notes.append(f"{host} resolves to this host ({', '.join(sorted(addresses & mine))})")
    elif tls == "acme":
        report.warnings.append(
            f"{host} resolves to {', '.join(sorted(addresses))}, not an address on this host; fine "
            "behind NAT with ports 80 and 443 forwarded here, otherwise Let's Encrypt will fail"
        )
    if tls == "acme":
        for port in (80, 443):
            if reachable(host, port):
                report.notes.append(f"{host}:{port} accepts connections")
            else:
                report.warnings.append(
                    f"{host}:{port} does not accept connections from here (the stack may not be up yet, "
                    "or a firewall blocks it); Let's Encrypt needs both 80 and 443"
                )


def check_mongo(values: dict, report: Report, avx: bool | None, release: str) -> None:
    """MONGO_IMAGE against this host: an image it cannot run is an error."""
    if "chat" not in {p for p in values.get("COMPOSE_PROFILES", "").split(",") if p}:
        return
    image = values.get("MONGO_IMAGE") or MONGO_DEFAULT
    report.errors.extend(mongo_image_problems(image, avx, release))
    series = mongo_series(image)
    if series is None:
        report.notes.append(f"MongoDB: {image} is not an official mongo:X.Y image; not checked against this host")
    elif series < (5, 0):
        choice = choose_mongo(avx, release)
        if choice.image == MONGO_DEFAULT:
            report.notes.append(
                f"MongoDB {image} is end of life and this host can run 8: tools/mongo-upgrade moves it, step by step"
            )


def check(root: Path, *, network: bool = True, probe_host: bool = True) -> Report:
    report = Report()
    env_path = root / ".env"
    if not env_path.is_file():
        report.errors.append(f"no .env in {root}: run ./configure (or copy .env.example) first")
        return report
    try:
        values = parse_env(env_path.read_text(encoding="utf-8"))
    except ConfigError as exc:
        report.errors.append(f".env does not parse: {exc}")
        return report
    mode = stat.S_IMODE(env_path.stat().st_mode)
    if mode & 0o077:
        report.warnings.append(f".env is mode {oct(mode)}; it holds every secret: chmod 600 .env")
    if (root / FIRST_SIGN_IN).exists():
        report.warnings.append(f"{FIRST_SIGN_IN} still exists: sign in once, then delete it")
    if not (root / "proxy.d").is_dir():
        report.errors.append("proxy.d/ is missing (the proxy mounts it); restore it with git checkout proxy.d")
    if not (root / "providers.d").is_dir():
        report.errors.append("providers.d/ is missing (the gateway mounts it); restore it with git checkout providers.d")
    check_values(values, report)
    check_mongo(values, report, *detect_host())
    if network:
        check_scopes(values, report)
    if probe_host:
        check_host(values, report, root=root, network=network)
    return report


# --- the interactive part -----------------------------------------------------------


def ask(prompt: str, default: str = "", *, secret: bool = False, validate=None) -> str:
    suffix = f" [{default}]" if default and not secret else (" [keep]" if default else "")
    while True:
        try:
            raw = getpass.getpass(f"{prompt}{suffix}: ") if secret else input(f"{prompt}{suffix}: ")
        except EOFError:
            raise SystemExit("\nconfigure: input ended; nothing written") from None
        value = raw.strip() or default
        if not value:
            print("  an answer is needed")
            continue
        if validate:
            try:
                validate(value)
            except ConfigError as exc:
                print(f"  {exc}")
                continue
        return value


def choose(prompt: str, options: dict, default: str) -> str:
    print(prompt)
    for name, text in options.items():
        print(f"  {name:<11} {text}")
    return ask("choice", default, validate=lambda v: None if v in options else _raise(f"one of {', '.join(options)}"))


def _raise(message: str):
    raise ConfigError(message)


def interview(answers: Answers, given: set, existing: dict) -> Answers:
    """Ask what the flags did not answer, defaulting to what .env holds."""
    if existing:
        print("Editing the existing .env: Enter keeps each current answer.\n")
    if "origin" not in given:
        answers.origin = ask(
            "Public origin, https://host[:port]",
            answers.origin,
            validate=lambda v: split_origin(v),
        )
    if "admin_email" not in given:
        answers.admin_email = ask(
            "Administrator's email (their first sign-in becomes an administrator)",
            answers.admin_email,
            validate=check_email,
        )
    if "preset" not in given:
        answers.preset = choose("Preset:", {n: p.summary for n, p in PRESETS.items()}, answers.preset)
    host = split_origin(answers.origin)[1]
    if "tls" not in given:
        tls_default = answers.tls
        if tls_default == "acme" and (is_ip(host) or "." not in host):
            tls_default = "internal"
        answers.tls = choose(
            "TLS:",
            {
                "acme": "a Let's Encrypt certificate (public DNS name, ports 80 and 443 open)",
                "internal": "Caddy's own CA; browsers warn (development, private networks)",
                "upstream": "TLS ends in front of this host, which gets plain HTTP",
            },
            tls_default,
        )
        refuse_tls(answers.tls, host)
    if answers.tls == "upstream" and "http_port" not in given:
        port = ask(
            "Port the TLS front forwards plain HTTP to, on this host",
            existing.get("HTTP_PORT", "80"),
            validate=lambda v: None if v.isdigit() and 0 < int(v) < 65536 else _raise("a port number"),
        )
        answers.http_port = int(port)
    if answers.preset == "satellite":
        answers.idp = "external"
        if "central_url" not in given:
            base = existing.get("CHAT_OPENAI_BASE_URL", "")
            answers.central_url = ask(
                "The central Pystino's origin, https://…",
                base[: -len("/v1")] if base.endswith("/v1") else "",
                validate=lambda v: None if v.startswith("https://") else _raise("an https:// URL"),
            )
    elif "idp" not in given:
        answers.idp = choose(
            "Identity provider:",
            {
                "authelia": "the bundled Authelia (users managed in the console)",
                "external": "your own OIDC issuer (Keycloak, Entra ID, Google, …)",
            },
            answers.idp,
        )
    if answers.idp == "authelia":
        refuse_authelia(host)
    else:
        origin = split_origin(answers.origin)[0]
        if "oidc_issuer" not in given and answers.preset != "satellite":
            answers.oidc_issuer = ask(
                "Issuer URL", existing.get("OIDC_ISSUER", ""),
                validate=lambda v: None if v.startswith("https://") else _raise("an https:// URL"),
            )
        if PRESETS[answers.preset].standalone is False and "oidc_console_client_secret" not in given:
            print(f"  Console client: redirect URI {origin}/auth/callback/default")
            answers.oidc_console_client_id = ask("  client id", existing.get("OIDC_CONSOLE_CLIENT_ID", "pystino-console"))
            answers.oidc_console_client_secret = ask(
                "  client secret", existing.get("OIDC_CONSOLE_CLIENT_SECRET", ""), secret=True
            )
        if "oidc_chat_client_secret" not in given:
            print(f"  Chat client: redirect URI {origin}/chat/login/callback")
            answers.oidc_chat_client_id = ask("  client id", existing.get("OIDC_CHAT_CLIENT_ID", "cerea"))
            answers.oidc_chat_client_secret = ask(
                "  client secret", existing.get("OIDC_CHAT_CLIENT_SECRET", ""), secret=True
            )
        if "group_import" not in given:
            answers.group_import = choose(
                "Groups from the identity provider:",
                {
                    "manual": "import by hand (recommended): the console lists them to import",
                    "auto": "import automatically: every group name becomes a group",
                },
                existing.get("OIDC_GROUP_IMPORT") or "manual",
            )
        if "join_mode" not in given:
            # A fresh install defaults to approval — the safest that is still
            # usable. Editing an .env that never answered defaults to open:
            # Enter must keep what the deployment does today, not change it.
            join_default = (
                existing.get("OIDC_JOIN_MODE")
                or ("approval" if not existing else "open")
            )
            answers.join_mode = choose(
                "Who may join:",
                {
                    "open": "anyone who signs in gets an account at once (today's behaviour)",
                    "approval": "strangers wait in the console's approval queue (recommended)",
                    "invite": "only people you invite can sign in",
                    "group": "only members of chosen groups may sign in",
                },
                join_default,
            )
        if answers.join_mode == "group":
            if "required_groups" not in given:
                answers.required_groups = ask(
                    "Required groups (local names, comma-separated; a directory name must be "
                    "imported or mapped on Console > Groups first)",
                    existing.get("OIDC_REQUIRED_GROUPS", ""),
                )
            if "group_fallback" not in given:
                answers.group_fallback = choose(
                    "Someone without a required group:",
                    {
                        "refuse": "refused, told to ask an administrator",
                        "approval": "held in the approval queue",
                    },
                    existing.get("OIDC_GROUP_FALLBACK") or "refuse",
                )
    if "office" not in given:
        answers.office = choose(
            "Office previews (Gotenberg, a LibreOffice converter: about 1.5 GB image, 2 GB of memory while converting):",
            {
                "no": "off: PowerPoint previews in the browser, Word as today (recommended unless you need more)",
                "yes": "on: Word, Excel, PowerPoint and OpenDocument files preview as PDF, and models can convert files",
            },
            "yes" if answers.office else "no",
        ) == "yes"
    if "rustfs" not in given and not existing:
        answers.rustfs = choose(
            "File storage (attachments, generated files, uploads):",
            {
                "no": "MongoDB (GridFS), as before (recommended unless you want an S3-compatible store)",
                "yes": "RustFS, a bundled S3-compatible object store (or set CHAT_S3_* afterwards for your own S3)",
            },
            "yes" if answers.rustfs else "no",
        ) == "yes"
    if answers.preset == "generic" and "upstream_api_key" not in given:
        answers.upstream_base_url = ask(
            "OpenAI-compatible endpoint", existing.get("CHAT_OPENAI_BASE_URL", DEFAULT_UPSTREAM)
        )
        answers.upstream_api_key = ask("Its API key", existing.get("CHAT_OPENAI_API_KEY", ""), secret=True)
    print()
    return answers


# --- commands ---------------------------------------------------------------------


def import_smtp_env(root: Path) -> dict:
    """`pystino email export-env`'s output from the running gateway, as a dict.

    Prints and returns `{}` on any failure — a stack that is not up yet, or
    without the gateway profile — rather than raising: `--import-smtp` is a
    convenience over typing `--smtp-*` by hand, not a precondition of writing
    `.env` at all.
    """
    proc = _run(
        ["docker", "compose", "exec", "-T", "gateway", "pystino", "email", "export-env"],
        timeout=20, cwd=root,
    )
    if proc is None or proc.returncode != 0:
        detail = (proc.stderr.strip().splitlines() or ["?"])[-1] if proc else "docker not runnable"
        print(f"configure: --import-smtp: {detail}", file=sys.stderr)
        return {}
    values = {}
    for line in proc.stdout.splitlines():
        key, sep, value = line.partition("=")
        if sep and KEY.match(key):
            values[key] = value
    return values


def cmd_configure(args, root: Path) -> int:
    env_path = root / ".env"
    template = (root / ".env.example").read_text(encoding="utf-8")
    existing = parse_env(env_path.read_text(encoding="utf-8")) if env_path.exists() else {}
    answers = answers_from(existing) if existing else Answers()
    given = set()
    for attr in Answers.__dataclass_fields__:
        value = getattr(args, attr, None)
        if value is not None:
            setattr(answers, attr, value)
            given.add(attr)
    if args.upstream_api_key_env:
        answers.upstream_api_key = os.environ.get(args.upstream_api_key_env, "")
        given.add("upstream_api_key")
    if args.admin_password_file:
        answers.admin_password = Path(args.admin_password_file).read_text(encoding="utf-8").strip()
        given.add("admin_password")
    if args.import_smtp:
        imported = import_smtp_env(root)
        for key, attr in (
            ("SMTP_HOST", "smtp_host"), ("SMTP_USERNAME", "smtp_username"),
            ("SMTP_PASSWORD", "smtp_password"), ("SMTP_FROM", "smtp_from"),
            ("SMTP_SECURITY", "smtp_security"),
        ):
            if key in imported:
                setattr(answers, attr, imported[key])
                given.add(attr)
        if "SMTP_PORT" in imported:
            try:
                answers.smtp_port = int(imported["SMTP_PORT"])
                given.add("smtp_port")
            except ValueError:
                pass

    interactive = not args.non_interactive and sys.stdin.isatty()
    if interactive:
        answers = interview(answers, given, existing)
    else:
        # An external IdP's admin rule (--admin-email, or --admin-claim with
        # --admin-claim-value) is validated in build(), with a message
        # naming both options; only the bundled Authelia's bootstrap door
        # is unconditionally required this early.
        required = ["origin"]
        if answers.idp != "external":
            required.append("admin_email")
        missing = [f"--{n.replace('_', '-')}" for n in required if not getattr(answers, n)]
        if missing:
            print(f"configure: non-interactive, and {' and '.join(missing)} not given", file=sys.stderr)
            return 2
    discovery = None
    pre_notes: list[str] = []
    issuer = (answers.oidc_issuer or existing.get("OIDC_ISSUER", "")).strip()
    if answers.idp == "external" and not args.offline and issuer.startswith("https://"):
        # Fetched for the scopes answer and the device-flow check alike; the
        # scopes question keeps working when the operator named them by hand.
        discovery = fetch_discovery(issuer)
        problem = device_flow_problem(discovery)
        if problem:
            if interactive:
                print(f"note: {problem}.")
                choice = choose(
                    "Continue how?",
                    {
                        "without": "continue without agent machines (recommended; switch issuers or add one that offers the device flow later)",
                        "keep": "keep agent machines on anyway (enrollment will fail)",
                    },
                    "without",
                )
                if choice == "without":
                    answers.agents = False
                    pre_notes.append("agent machines disabled: the issuer offers no device flow")
            else:
                pre_notes.append(f"the issuer offers no device flow: galopin cannot enroll ({problem})")
    if existing and model_mode_problems(existing):
        # An install from before the two modes were exclusive. build() writes
        # one mode only, so this is offered, not silently applied.
        generic = answers.preset == "generic"
        print("configure: this .env mixes Pystino mode and standalone mode:")
        for problem in model_mode_problems(existing):
            print(f"  - {problem}")
        fix = (
            "set CHAT_USE_USER_TOKEN='false' (standalone: one shared key, no personal tokens)"
            if generic
            else "empty CHAT_OPENAI_API_KEY and use personal tokens (Pystino mode)"
        )
        if interactive:
            if choose(f"Fix it ({fix})?", {"yes": "write the fixed .env", "no": "stop; nothing written"}, "yes") != "yes":
                print("configure: nothing written; the chat will refuse to start on this .env", file=sys.stderr)
                return 2
        else:
            print(f"note: fixing it: {fix}")
    try:
        result = build(answers, existing, template, discovery, choose_mongo(*detect_host()))
        text = render(template, result.values, HEADER)
    except ConfigError as exc:
        print(f"configure: {exc}", file=sys.stderr)
        return 2

    if existing and parse_env(text) == existing:
        print(f"{env_path} is already up to date; nothing written")
    else:
        saved = backup(env_path)
        write_private(env_path, text)
        print(f"wrote {env_path} (mode 0600)" + (f"; the previous one is {saved.name}" if saved else ""))
    for note in pre_notes + result.notes:
        print(f"note: {note}")
    if result.admin_password:
        path = root / FIRST_SIGN_IN
        write_private(
            path,
            f"Cerea: the first sign-in, shown nowhere else.\n"
            f"URL:      {result.values['PUBLIC_ORIGIN']}/\n"
            f"User:     {result.values['AUTHELIA_ADMIN_USER']}\n"
            f"Password: {result.admin_password}\n"
            f"Email:    {result.values['AUTHELIA_ADMIN_EMAIL']} (becomes administrator on first sign-in)\n"
            f"Change the password after signing in, then delete this file.\n",
        )
        print(f"the first sign-in is in {path} (mode 0600): read it, sign in, delete it")
    values = result.values
    print()
    print(f"  origin    {values['PUBLIC_ORIGIN']}   (TLS {values['TLS_MODE']})")
    print(f"  preset    {values['PYSTINO_PRESET']}   profiles {values['COMPOSE_PROFILES']}")
    fetch_on = "fetch" in values["COMPOSE_PROFILES"].split(",")
    print(f"  browser   {'on (fetch profile)' if fetch_on else 'off'}")
    office_on = "office" in values["COMPOSE_PROFILES"].split(",")
    print(f"  office    {'on (Gotenberg previews and convert_document)' if office_on else 'off'}")
    rustfs_on = "rustfs" in values["COMPOSE_PROFILES"].split(",")
    store = "s3" if values.get("CHAT_BLOB_STORE") == "s3" else "MongoDB (GridFS)"
    print(f"  files     {store}{'  (bundled RustFS)' if rustfs_on else ''}")
    print(f"  identity  {values['OIDC_ISSUER']}   (scopes: {values['OIDC_SCOPES']})")
    print()
    print("next:  ./configure --check  &&  docker compose up -d --wait")
    return 0


def cmd_break_glass(args, root: Path) -> int:
    """`./configure --break-glass` (ADR 0093 §10 host steps): the deeper
    recovery, when the configured identity provider itself is unreachable or
    every administrator is locked out. Switches `.env` to the bundled
    Authelia (kept but inert if it names an external IdP already: nothing
    here deletes those values, so the operator can switch back with them),
    then grants one target admin through `pystino break-glass` inside the
    gateway container.

    Stops at the first failing step: the `.env` rewrite has already
    happened by the time any `docker compose` step can fail, so every
    failure message says the backup's name, not just that something broke.
    """
    env_path = root / ".env"
    if not env_path.exists():
        print("configure: --break-glass needs an existing .env; run ./configure first", file=sys.stderr)
        return 2
    if not args.admin_email:
        print("configure: --break-glass needs --admin-email", file=sys.stderr)
        return 2

    template = (root / ".env.example").read_text(encoding="utf-8")
    existing = parse_env(env_path.read_text(encoding="utf-8"))
    answers = answers_from(existing)
    answers.idp = "authelia"
    answers.admin_email = args.admin_email
    answers.link_by_email = False

    try:
        result = build(answers, existing, template)
        text = render(template, result.values, HEADER)
    except ConfigError as exc:
        print(f"configure: {exc}", file=sys.stderr)
        return 2

    saved = _utc_backup(env_path)
    write_private(env_path, text)
    print(f"wrote {env_path} (mode 0600); the previous one is {saved.name}" if saved
          else f"wrote {env_path} (mode 0600)")

    def fail(step: str, proc: subprocess.CompletedProcess | None) -> int:
        detail = (proc.stderr.strip().splitlines() or ["?"])[-1] if proc else "docker not runnable"
        print(f"configure: --break-glass failed at {step!r}: {detail}", file=sys.stderr)
        if saved:
            print(f"{saved.name} holds the configuration from before this run", file=sys.stderr)
        return 1

    step = "docker compose up -d --wait postgres"
    proc = _run(["docker", "compose", "up", "-d", "--wait", "postgres"], timeout=120, cwd=root)
    if proc is None or proc.returncode != 0:
        return fail(step, proc)

    step = "docker compose run --rm bootstrap"
    proc = _run(["docker", "compose", "run", "--rm", "bootstrap"], timeout=120, cwd=root)
    if proc is None or proc.returncode != 0:
        return fail(step, proc)

    step = "pystino break-glass"
    bg_cmd = [
        "docker", "compose", "run", "--rm", "--no-deps", "gateway",
        "pystino", "break-glass", "--email", answers.admin_email,
    ]
    if args.reason and args.reason.strip():
        bg_cmd += ["--reason", args.reason.strip()]
    if args.admin_login:
        bg_cmd += ["--login", args.admin_login]
    proc = _run(bg_cmd, timeout=60, cwd=root)
    if proc is None or proc.returncode != 0:
        return fail(step, proc)
    login = password = ""
    for line in proc.stdout.splitlines():
        key, sep, value = line.partition(":")
        if sep and key.strip() == "login":
            login = value.strip()
        elif sep and key.strip() == "password":
            password = value.strip()
    if not login or not password:
        print(f"configure: --break-glass: {step} printed no login/password:\n{proc.stdout}",
              file=sys.stderr)
        if saved:
            print(f"{saved.name} holds the configuration from before this run", file=sys.stderr)
        return 1

    step = "docker compose up -d --wait"
    proc = _run(["docker", "compose", "up", "-d", "--wait"], timeout=180, cwd=root)
    if proc is None or proc.returncode != 0:
        return fail(step, proc)

    print()
    print(f"  sign in at  {result.values['PUBLIC_ORIGIN']}/")
    print(f"  login       {login}")
    print(f"  password    {password}")
    print()
    print("galopin machines must re-enroll: their tokens name the old issuer.")
    return 0


def cmd_set(args, root: Path) -> int:
    env_path = root / ".env"
    if not env_path.exists():
        print("configure: no .env yet; run ./configure first", file=sys.stderr)
        return 2
    template = (root / ".env.example").read_text(encoding="utf-8")
    values = parse_env(env_path.read_text(encoding="utf-8"))
    before = dict(values)
    changes = []
    for item in args.set or []:
        key, sep, value = item.partition("=")
        if not sep or not KEY.match(key):
            print(f"configure: --set expects KEY=VALUE, got {item!r}", file=sys.stderr)
            return 2
        if values.get(key) != value:
            values[key] = value
            changes.append(key)
    for key in args.unset or []:
        if not KEY.match(key):
            print(f"configure: --unset expects a KEY, got {key!r}", file=sys.stderr)
            return 2
        if key in values:
            del values[key]
            changes.append(key)
    if not changes:
        print(".env already says so; nothing written")
        return 0
    fresh_problems = set(model_mode_problems(values)) - set(model_mode_problems(before))
    if fresh_problems:
        print("configure: that would mix Pystino mode and standalone mode; nothing written:", file=sys.stderr)
        for problem in sorted(fresh_problems):
            print(f"  - {problem}", file=sys.stderr)
        print("run ./configure with the preset you want instead: it writes one mode only", file=sys.stderr)
        return 2
    if "OIDC_SCOPES" in changes and "OIDC_SCOPES_JSON" not in changes:
        # The gateway reads the JSON twin; keep it in step with the words.
        values["OIDC_SCOPES_JSON"] = scopes_json(values.get("OIDC_SCOPES", ""))
        changes.append("OIDC_SCOPES_JSON")
    try:
        text = render(template, values, HEADER)
    except ConfigError as exc:
        print(f"configure: {exc}", file=sys.stderr)
        return 2
    write_private(env_path, text)
    print(f"updated {', '.join(changes)} in {env_path}; apply with `docker compose up -d`")
    return 0


def cmd_check(args, root: Path) -> int:
    report = check(root, network=not args.offline)
    for line in report.errors:
        print(f"ERROR  {line}")
    for line in report.warnings:
        print(f"WARN   {line}")
    for line in report.notes:
        print(f"note   {line}")
    print("ok" if report.ok else f"{len(report.errors)} error(s)")
    return 0 if report.ok else 1


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="./configure",
        description="Write this deployment's .env (asking only what it cannot decide), or check it.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Presets:\n" + "\n".join(f"  {n:<11} {pr.summary}" for n, pr in PRESETS.items()),
    )
    mode = p.add_argument_group("what to do (default: write .env)")
    mode.add_argument("--check", action="store_true", help="check .env and this host; change nothing")
    mode.add_argument("--offline", action="store_true", help="skip DNS, port and issuer probes (--check), or the issuer lookup (writing .env)")
    mode.add_argument("--set", nargs="+", metavar="KEY=VALUE", help="change values in .env, no questions")
    mode.add_argument("--unset", nargs="+", metavar="KEY", help="remove values from .env")
    mode.add_argument("--non-interactive", action="store_true", help="ask nothing; fail on a missing answer")
    mode.add_argument(
        "--break-glass", action="store_true",
        help="recover admin access: switch to the bundled Authelia and grant --admin-email",
    )
    mode.add_argument("--dir", help=argparse.SUPPRESS)

    q = p.add_argument_group("the questions")
    q.add_argument("--origin", help="public origin, https://host[:port]")
    q.add_argument("--admin-email", help="the administrator's email")
    q.add_argument("--preset", choices=list(PRESETS))
    q.add_argument("--tls", choices=TLS_MODES, help="acme | internal | upstream")
    q.add_argument("--idp", choices=IDPS, help="authelia (bundled) | external")

    o = p.add_argument_group("optional")
    o.add_argument("--agents", action=argparse.BooleanOptionalAction, default=None,
                   help="agent machines (/chat/code and galopin)")
    o.add_argument("--terminal", action=argparse.BooleanOptionalAction, default=None,
                   help="the browser terminal on agent machines (a full remote shell; needs --agents)")
    o.add_argument("--fetch", action=argparse.BooleanOptionalAction, default=None,
                   help="the headless browser for web fetch (the fetch profile); --no-fetch removes it")
    o.add_argument("--office-preview", dest="office", action=argparse.BooleanOptionalAction, default=None,
                   help="Office documents as PDF previews, and the convert_document tool, through Gotenberg "
                        "(the office profile; off by default); --no-office-preview removes it")
    o.add_argument("--object-store", dest="rustfs", action=argparse.BooleanOptionalAction, default=None,
                   help="a bundled S3-compatible object store (RustFS, the rustfs profile; off by default) for "
                        "the chat's files. A fresh install uses it at once; an existing one keeps MongoDB until "
                        "its files are copied (docs/storage.md). --no-object-store removes it")
    o.add_argument("--project", help="compose project name (default cerea)")
    o.add_argument("--http-port", type=int, help="host port for HTTP (upstream mode: what the front forwards to)")
    o.add_argument("--https-port", type=int, help="host port for HTTPS")
    o.add_argument("--public-bind", help="address the proxy binds (default 0.0.0.0)")
    o.add_argument("--acme-email", help="Let's Encrypt account email")
    o.add_argument("--admin-user", help="bundled Authelia: the first account's user name (default admin)")
    o.add_argument("--admin-name", help="bundled Authelia: its display name")
    o.add_argument("--admin-password-file", help="bundled Authelia: read the first password from this file "
                   "instead of minting one")
    o.add_argument("--admin-login", help="--break-glass: the recovered account's login (default: from --admin-email)")
    o.add_argument("--reason", help="--break-glass: why, for the gateway's audit row (optional)")
    o.add_argument("--oidc-issuer", help="external IdP: the issuer URL")
    o.add_argument("--oidc-internal-base-url", help="external IdP: a URL for it inside the network")
    o.add_argument("--oidc-console-client-id")
    o.add_argument("--oidc-console-client-secret")
    o.add_argument("--oidc-chat-client-id")
    o.add_argument("--oidc-chat-client-secret")
    o.add_argument("--oidc-groups-claim")
    o.add_argument("--oidc-scopes", help="external IdP: scopes to ask for, space- or comma-separated "
                   "(default: openid profile email groups, minus what the issuer's discovery does not offer)")
    o.add_argument("--oidc-logout-url", help="external IdP without end_session_endpoint; {redirect} = landing")
    o.add_argument("--admin-claim", help="external IdP: a dotted claim path that can confer admin (e.g. groups)")
    o.add_argument("--admin-claim-value", help="external IdP: comma-separated values of --admin-claim that confer it")
    o.add_argument("--link-by-email", action=argparse.BooleanOptionalAction, default=None,
                   help="a verified email at sign-in attaches to the existing account with it")
    o.add_argument("--machine-client-id", help="galopin's public client id (default opencode-enrollment)")
    o.add_argument("--group-sync", choices=("every_login", "first_login", "never"),
                   help="how often the directory's answer about groups is applied")
    o.add_argument("--group-import", choices=("manual", "auto"),
                   help="external IdP: import its groups by hand in the console (manual, the "
                        "default) or create each on first sight (auto)")
    o.add_argument("--join-mode", choices=("open", "approval", "invite", "group"),
                   help="external IdP, who may join (ADR 0095): open signs strangers up at "
                        "once; approval holds them for your approval (the new install's "
                        "default); invite refuses everyone not invited; group admits only "
                        "the required groups' members")
    o.add_argument("--required-groups", help="join-mode group: the local group names, comma-"
                   "separated (a directory name must be imported or mapped first)")
    o.add_argument("--group-fallback", choices=("refuse", "approval"),
                   help="join-mode group: what a stranger without a required group gets")
    o.add_argument("--smtp-host")
    o.add_argument("--smtp-port", type=int)
    o.add_argument("--smtp-username")
    o.add_argument("--smtp-password", help="prefer --import-smtp: argv is visible")
    o.add_argument("--smtp-from")
    o.add_argument("--smtp-security", choices=("starttls", "tls", "none"))
    o.add_argument("--import-smtp", action="store_true",
                   help="read GATEWAY_SMTP__* from the running gateway's environment "
                   "(docker compose exec gateway pystino email export-env) instead of typing it here")
    o.add_argument("--central-url", help="satellite: the central Pystino's origin")
    o.add_argument("--upstream-base-url", help="the gateway's first provider (generic: the chat's endpoint)")
    o.add_argument("--upstream-api-key", help="its key (prefer --upstream-api-key-env: argv is visible)")
    o.add_argument("--upstream-api-key-env", metavar="VAR", help="read that key from this environment variable")
    return p


def main(argv: list | None = None) -> int:
    args = parser().parse_args(argv)
    root = Path(args.dir).resolve() if args.dir else ROOT
    if args.break_glass:
        return cmd_break_glass(args, root)
    if args.check:
        return cmd_check(args, root)
    if args.set or args.unset:
        return cmd_set(args, root)
    return cmd_configure(args, root)


if __name__ == "__main__":
    sys.exit(main())
