# Every secret lives here; never commit it.
.env
.env.bak-*
# The minted first sign-in (./configure writes it at 0600); delete it after use.
first-sign-in.txt
# Your own proxy snippets: an upgrade never touches them.
proxy.d/*.caddy
# Your own additions to the stack: Compose merges compose.override.yaml into
# compose.yaml by itself, and an upgrade never touches it.
compose.override.yaml
compose.override.yml
# Source checkouts dev/build.sh builds from.
dev/src/
__pycache__/
# The built mkdocs sites served on /docs/* (OC builds them on this box;
# built output never belongs in git).
docs-site/
diagnose-*.txt
