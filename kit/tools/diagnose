#!/usr/bin/env python3
"""Collect one redacted text file an operator can upload when something is wrong.

    tools/diagnose                    writes ./diagnose-<date>.txt and prints its path
    tools/diagnose --lines 500        more log lines per service (default 200)
    tools/diagnose --output /tmp      write somewhere else
    tools/diagnose --print            write to stdout instead of a file

Run it on the server, from this directory (or anywhere: it finds compose.yaml
next to itself). It only reads: it runs `docker compose ps|logs|exec` and
`docker inspect`, reads `.env`, and changes nothing.

What the file holds:

  - versions and pins: this repository's commit, the Docker and Compose
    versions, the image each service runs, and the pins compose.yaml names;
  - `docker compose ps`, and the health of each service (state, health,
    restarts, OOM kill, exit code);
  - the last 200 log lines of chat, gateway and extractor;
  - the quota health: each rule's counter against the ledger, from
    `pystino quota health` inside the gateway, or, on an image too old to have
    it, a SQL and valkey-cli fallback;
  - disk usage;
  - the keys of `.env`: values are shown only for a short allowlist (versions,
    presets, profiles, flags) and are `<redacted>` for everything else.

Secrets never leave the file: every line is masked by pattern (emails, tokens,
keys, passwords, cookies, credentials in URLs, private keys, password digests,
long opaque strings), and every secret-named value from `.env` is also masked
wherever it appears, whatever shape it has. Read the file before you send it;
the masking is by pattern, and a pattern can miss a thing nobody has seen yet.

Standard library only, like ./configure. Python 3.10 or newer.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import platform
import re
import subprocess
import sys
from collections.abc import Callable, Sequence
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ENV_FILE = ROOT / ".env"
COMPOSE = ROOT / "compose.yaml"

#: The services whose logs are worth the space, and the order they appear in.
LOG_SERVICES = ("chat", "gateway", "extractor")

#: `.env` values that may be shown: versions, presets, profiles, flags. A key
#: not matched here is listed with its value redacted. Everything here is a
#: choice an operator made from a short menu; none of it identifies anyone.
ENV_ALLOWLIST = frozenset(
    {
        "COMPOSE_PROJECT_NAME",
        "COMPOSE_PROFILES",
        "PYSTINO_PRESET",
        "PYSTINO_CONFIG_VERSION",
        "TLS_MODE",
        "HTTP_PORT",
        "HTTPS_PORT",
        "PROXY_DEFAULT",
        "TRUSTED_PROXIES",
        "GATEWAY_ACCOUNTING__ENABLED",
        "GATEWAY_QUOTA__ENABLED",
        "GATEWAY_REDACTION__ENGINE",
        "REDACTION_NLP_ENGINE",
        "REDACTION_LANGUAGE",
        "FETCH_BACKEND",
        "CODE_AGENTS_ENABLED",
        "CODE_TERMINAL_ENABLED",
        "OIDC_KIND",
        "OIDC_GROUP_SYNC",
        "OIDC_LINK_BY_EMAIL",
        "SMTP_ENABLED",
        "SMTP_SECURITY",
    }
)
#: ...and by shape: `*_VERSION`, `CHAT_*_ENABLED`.
ENV_ALLOW_PATTERNS = (
    re.compile(r"^[A-Z0-9_]*_VERSION$"),
    re.compile(r"^CHAT_[A-Z0-9_]*_ENABLED$"),
)

#: A key whose name says it holds a secret. Its value is masked wherever it
#: shows up in the report, not only in the .env section.
SECRET_KEY_NAME = re.compile(r"(PASSWORD|SECRET|TOKEN|DIGEST|SALT|API_KEY|_KEY$|^KEY$)", re.I)
#: Too short to mask by literal: "true", "443" and "gateway" would erase
#: ordinary words from the report.
MIN_LITERAL_SECRET = 8

# --------------------------------------------------------------------------
# redaction


# A name that says what it holds, at its *end*: `access_token`, `db_password`,
# `GATEWAY_SECRET_KEY`. Anchored there so `prompt_tokens=412` and `session: started`
# keep their values, which are what a reader of a log is looking for.
_SENSITIVE_NAME = (
    r"pass(?:word|wd|phrase)|secret|token|api[_-]?key|apikey|authorization|cookie|"
    r"digest|credentials?|private[_-]?key|signature|[_-]key|access[_-]?key|"
    r"session[_-]?(?:id|key|secret|token)|jwt|bearer|salt"
)

_RULES: list[tuple[re.Pattern[str], str | Callable[[re.Match[str]], str]]] = [
    # A whole PEM block (any key or certificate request) before anything
    # line-oriented sees half of it.
    (
        re.compile(
            r"-----BEGIN [A-Z0-9 ]*(?:PRIVATE KEY|CERTIFICATE REQUEST)-----"
            r".*?-----END [A-Z0-9 ]*(?:PRIVATE KEY|CERTIFICATE REQUEST)-----",
            re.S,
        ),
        "<redacted:private-key>",
    ),
    # Password digests: Authelia's users file and the console client digests.
    (
        re.compile(r"\$(?:argon2(?:id|i|d)|pbkdf2(?:-sha\d+)?|scrypt|bcrypt|2[aby]|6|5)\$[^\s'\"]+"),
        "<redacted:digest>",
    ),
    # `scheme://user:password@host`: keep the host, which is what a reader needs.
    (re.compile(r"(?P<scheme>[a-zA-Z][a-zA-Z0-9+.-]*://)[^\s/@'\"]+:[^\s/@'\"]*@"), r"\g<scheme><redacted>@"),
    # JSON Web Tokens, and anything else shaped header.payload.signature.
    (re.compile(r"\beyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]*"), "<redacted:jwt>"),
    # `Authorization: Bearer x`, and a bare `Bearer x`.
    (re.compile(r"\b(?P<scheme>Bearer)\s+[A-Za-z0-9._~+/=-]{8,}", re.I), r"\g<scheme> <redacted>"),
    # Cookie headers carry the session; mask the whole value.
    (
        re.compile(r"(?P<head>\b(?:set-)?cookie\s*[:=]\s*).+", re.I),
        r"\g<head><redacted>",
    ),
    # Gateway keys: <prefix>_<8 hex>_<urlsafe secret>.
    (re.compile(r"\b[a-z]{2,10}_[0-9a-f]{8}_[A-Za-z0-9_-]{20,}"), "<redacted:api-key>"),
    # Provider keys by their well-known prefixes.
    (
        re.compile(
            r"\b(?:sk-(?:ant-|proj-|or-v1-)?[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}"
            r"|github_pat_[A-Za-z0-9_]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}"
            r"|AIza[0-9A-Za-z_-]{30,}|glpat-[A-Za-z0-9_-]{16,}|npm_[A-Za-z0-9]{30,}"
            r"|(?:rk|pk|sk)_(?:live|test)_[A-Za-z0-9]{16,})"
        ),
        "<redacted:api-key>",
    ),
    # name=value, name: value, "name": "value", name='value' for a sensitive
    # name. The name is kept, the value is not; a quoted value may hold spaces.
    (
        re.compile(
            r"(?P<head>(?P<q>[\"']?)[A-Za-z0-9_.-]*(?:" + _SENSITIVE_NAME + r")"
            r"(?P=q)\s*[:=]\s*)(?P<value>\"[^\"]*\"|'[^']*'|[^\s,;&}\]]+)",
            re.I,
        ),
        lambda m: m.group("head") + "<redacted>",
    ),
    # Email addresses.
    (re.compile(r"[A-Za-z0-9._%+'-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+"), "<redacted:email>"),
    # Long opaque strings: hex of 32 or more (a hash, a key), except an image
    # digest, which the pins section needs; and long base64url runs that mix
    # letters and digits (a token nobody gave a prefix).
    (re.compile(r"(?<!sha256:)(?<![0-9A-Za-z])[0-9a-fA-F]{32,}(?![0-9A-Za-z])"), "<redacted:hex>"),
    (
        re.compile(r"(?<![\w/.:-])(?=[A-Za-z0-9_-]*[A-Za-z])(?=[A-Za-z0-9_-]*\d)[A-Za-z0-9_-]{40,}(?![\w/.-])"),
        "<redacted:token>",
    ),
]


def redact(text: str, literals: Sequence[tuple[str, str]] = ()) -> str:
    """Mask everything that looks like a secret.

    ``literals`` are (value, label) pairs taken from `.env`: a secret-named
    value is replaced wherever it appears, in whatever shape, longest first so
    a value containing another is not left half-masked.
    """
    for value, label in sorted(literals, key=lambda pair: -len(pair[0])):
        text = text.replace(value, f"<redacted:{label}>")
    for pattern, replacement in _RULES:
        text = pattern.sub(replacement, text)  # type: ignore[arg-type]
    return text


# --------------------------------------------------------------------------
# .env


def parse_env(text: str) -> dict[str, str]:
    """`KEY='value'` lines, as ./configure writes them. Quotes are stripped."""
    values: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        if key.startswith("export "):
            key = key[len("export ") :].strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            values[key] = value
    return values


def env_allowed(key: str) -> bool:
    return key in ENV_ALLOWLIST or any(p.match(key) for p in ENV_ALLOW_PATTERNS)


def secret_literals(env: dict[str, str]) -> list[tuple[str, str]]:
    """Values to mask everywhere: secret-named, not allowlisted, long enough to be unique."""
    return [
        (value, key)
        for key, value in env.items()
        if SECRET_KEY_NAME.search(key) and not env_allowed(key) and len(value) >= MIN_LITERAL_SECRET
    ]


def env_section(env: dict[str, str]) -> str:
    """Every key; a value only where the allowlist says it is safe."""
    if not env:
        return "no .env found"
    lines = []
    for key in sorted(env):
        value = env[key]
        if env_allowed(key):
            lines.append(f"{key}={value}")
        elif value == "":
            lines.append(f"{key}=<empty>")
        else:
            lines.append(f"{key}=<redacted>")
    return "\n".join(lines)


# --------------------------------------------------------------------------
# running things

Runner = Callable[[Sequence[str], int], "tuple[int, str]"]


def run(argv: Sequence[str], timeout: int = 60) -> tuple[int, str]:
    """Run a command, returning (exit code, combined output). Never raises."""
    try:
        done = subprocess.run(
            list(argv),
            cwd=ROOT,
            capture_output=True,
            text=True,
            timeout=timeout,
            errors="replace",
        )
    except FileNotFoundError:
        return 127, f"{argv[0]}: not found"
    except subprocess.TimeoutExpired:
        return 124, f"timed out after {timeout}s: {' '.join(argv)}"
    return done.returncode, (done.stdout + done.stderr).rstrip()


def compose(*args: str) -> list[str]:
    return ["docker", "compose", *args]


def text_of(result: tuple[int, str]) -> str:
    code, out = result
    return out if code == 0 else f"[exit {code}]\n{out}".rstrip()


# --------------------------------------------------------------------------
# sections


def pins_from_compose() -> str:
    """The default after `:-` for each pinned version, straight from compose.yaml."""
    try:
        text = COMPOSE.read_text(encoding="utf-8")
    except OSError as exc:
        return f"cannot read compose.yaml: {exc}"
    found = re.findall(r"\$\{((?:PYSTINO|CEREA)_VERSION):-([^}]*)\}", text)
    seen: dict[str, str] = {}
    for name, version in found:
        seen.setdefault(name, version)
    return "\n".join(f"{name} (compose.yaml default) = {version}" for name, version in seen.items())


def versions_section(runner: Runner) -> str:
    parts = [
        f"cerea-deploy commit: {text_of(runner(['git', 'rev-parse', '--short', 'HEAD'], 20))}",
        f"cerea-deploy describe: {text_of(runner(['git', 'describe', '--tags', '--always', '--dirty'], 20))}",
        f"host: {platform.platform()}",
        f"python: {platform.python_version()}",
        f"docker: {text_of(runner(['docker', '--version'], 20))}",
        f"compose: {text_of(runner(compose('version', '--short'), 20))}",
        "",
        pins_from_compose(),
        "",
        "images in use:",
        text_of(runner(compose("images", "--format", "table"), 60)),
    ]
    return "\n".join(parts)


def health_section(runner: Runner) -> str:
    code, out = runner(compose("ps", "-a", "--format", "json"), 60)
    if code != 0:
        return text_of((code, out))
    containers = []
    for raw in out.splitlines():
        raw = raw.strip()
        if not raw:
            continue
        try:
            decoded = json.loads(raw)
        except json.JSONDecodeError:
            continue
        containers.extend(decoded if isinstance(decoded, list) else [decoded])
    if not containers:
        return "no containers"
    rows = []
    for item in sorted(containers, key=lambda c: str(c.get("Service", ""))):
        service = item.get("Service", "?")
        ident = item.get("ID", "")
        code, inspected = runner(
            [
                "docker",
                "inspect",
                "--format",
                "{{.State.Status}} health={{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}"
                " restarts={{.RestartCount}} oom={{.State.OOMKilled}} exit={{.State.ExitCode}}"
                " started={{.State.StartedAt}}",
                ident,
            ],
            30,
        )
        detail = inspected if code == 0 else f"state={item.get('State', '?')} health={item.get('Health', '')}"
        rows.append(f"{service:<14} {detail}")
    return "\n".join(rows)


def logs_section(runner: Runner, lines: int) -> str:
    code, out = runner(compose("ps", "-a", "--services"), 30)
    present = set(out.split()) if code == 0 else set()
    blocks = []
    for service in LOG_SERVICES:
        header = f"--- {service} (last {lines} lines) ---"
        if present and service not in present:
            blocks.append(f"{header}\nnot part of this install (profile off)")
            continue
        blocks.append(
            f"{header}\n{text_of(runner(compose('logs', '--no-color', '--tail', str(lines), service), 90))}"
        )
    return "\n\n".join(blocks)


#: What the fallback asks PostgreSQL. Ids and counts only: no email, no name.
_FALLBACK_SQL = (
    "SELECT id, name, scope, scope_id, metric, window_seconds, period, limit_value, is_active "
    "FROM limit_rules ORDER BY scope, metric;",
    "SELECT status, count(*) AS rows, sum(cost) AS cost FROM usage_records "
    "WHERE created_at >= date_trunc('month', now()) GROUP BY status ORDER BY status;",
    "SELECT group_id, user_id, sum(cost) AS cost, count(*) AS rows FROM usage_records "
    "WHERE created_at >= date_trunc('month', now()) AND status <> 'in_progress' "
    "GROUP BY group_id, user_id ORDER BY cost DESC NULLS LAST LIMIT 20;",
    "SELECT count(*) AS stuck_in_progress_over_30min FROM usage_records "
    "WHERE status = 'in_progress' AND created_at < now() - interval '30 minutes';",
)

_FALLBACK_VALKEY = (
    "valkey-cli --scan --pattern 'q:*' | sort | while read -r k; do "
    'echo "$k value=$(valkey-cli get "$k") ttl=$(valkey-cli ttl "$k")"; done'
)


def quota_section(runner: Runner) -> str:
    code, out = runner(compose("exec", "-T", "gateway", "pystino", "quota", "health"), 90)
    if code == 0:
        return f"(from `pystino quota health`)\n{out}"
    reason = out.splitlines()[0] if out else "no output"
    blocks = [
        f"`pystino quota health` is unavailable ({reason}); falling back to SQL and valkey-cli.",
        "These are the ledger and the counters, not their comparison: the window each\n"
        "rule counts over is not recomputed here.",
    ]
    for sql in _FALLBACK_SQL:
        shell = 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -P pager=off -c "$1"'
        blocks.append(
            f"> {sql}\n"
            + text_of(runner(compose("exec", "-T", "postgres", "sh", "-c", shell, "sh", sql), 60))
        )
    blocks.append("> valkey counters (key value ttl)\n" + text_of(runner(compose("exec", "-T", "valkey", "sh", "-c", _FALLBACK_VALKEY), 60)))
    return "\n\n".join(blocks)


def disk_section(runner: Runner) -> str:
    return "\n\n".join(
        [
            "> df -h . /var/lib/docker\n" + text_of(runner(["df", "-h", ".", "/var/lib/docker"], 20)),
            "> docker system df\n" + text_of(runner(["docker", "system", "df"], 60)),
        ]
    )


# --------------------------------------------------------------------------
# the report


def build_report(
    runner: Runner = run,
    *,
    env: dict[str, str] | None = None,
    lines: int = 200,
    now: dt.datetime | None = None,
) -> str:
    """The whole report, redacted. ``env`` and ``runner`` are injectable for tests."""
    if env is None:
        try:
            env = parse_env(ENV_FILE.read_text(encoding="utf-8"))
        except OSError:
            env = {}
    stamp = (now or dt.datetime.now(dt.timezone.utc)).strftime("%Y-%m-%d %H:%M:%S UTC")
    sections = [
        ("versions and pins", lambda: versions_section(runner)),
        ("docker compose ps", lambda: text_of(runner(compose("ps", "-a"), 60))),
        ("service health", lambda: health_section(runner)),
        ("logs", lambda: logs_section(runner, lines)),
        ("quota health", lambda: quota_section(runner)),
        ("disk usage", lambda: disk_section(runner)),
        (".env (values redacted except versions, presets, profiles, flags)", lambda: env_section(env)),
    ]
    literals = secret_literals(env)
    out = [
        f"cerea diagnose, {stamp}",
        "Masked by pattern before it was written. Read it before you send it.",
    ]
    for title, build in sections:
        try:
            body = build()
        except Exception as exc:  # one broken section must not lose the others
            body = f"could not collect: {type(exc).__name__}: {exc}"
        out.append(f"\n===== {title} =====\n{redact(body, literals)}")
    return "\n".join(out) + "\n"


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Write a redacted diagnostics file to upload.")
    parser.add_argument("--lines", type=int, default=200, help="log lines per service (default 200)")
    parser.add_argument("--output", default=".", help="directory for diagnose-<date>.txt (default .)")
    parser.add_argument("--print", action="store_true", help="write to stdout instead of a file")
    args = parser.parse_args(argv)

    report = build_report(lines=args.lines)
    if args.print:
        sys.stdout.write(report)
        return 0
    path = Path(args.output) / f"diagnose-{dt.date.today().isoformat()}.txt"
    # 0600 from the first byte: it is redacted, but it is still this host's logs.
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(report)
    print(f"wrote {path}")
    print("Read it before you send it: the masking is by pattern.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
