#!/bin/sh
# cerea — set up and manage a Cerea deployment.
#
#   ./scripts/cerea init --origin https://chat.example.org --admin-email you@example.org
#   ./scripts/cerea init ... --central-url https://llm.example.org   # against a Pystino
#
# The deployment tool ships inside the Pystino gateway image (one tool for the
# whole stack; ADR 0086–0087), and this runs its Cerea-branded entry point.
# The host needs Docker and nothing else — no checkout, no node.
#
# CEREA_DEPLOY_TAG picks the tool's version (default: edge, main's build; use
# a release such as 1.4.0 once tagged, or `rearch` for the deploy/rearch
# branch). The images are private while the repositories are: log in once with
# a token holding read:packages — docker login ghcr.io -u <github-user>.
set -eu
image="${CEREA_DEPLOY_IMAGE:-ghcr.io/paoloviviani/pystino-gateway:${CEREA_DEPLOY_TAG:-edge}}"
if ! docker image inspect "$image" >/dev/null 2>&1 && ! docker pull -q "$image" >/dev/null; then
    echo "Could not pull $image." >&2
    echo "The images are private for now: docker login ghcr.io -u <github-user>" >&2
    echo "with a token that has read:packages, then run this again." >&2
    exit 1
fi
tty=""
if [ -t 0 ]; then tty="-it"; fi
exec docker run --rm $tty -u "$(id -u):$(id -g)" -v "$PWD:/deploy" -w /deploy \
    -e PYSTINO_DEPLOY_DIR="$PWD" -e PYSTINO_UPSTREAM_API_KEY -e PYSTINO_OIDC_CHAT_CLIENT_SECRET \
    "$image" cerea "$@"
