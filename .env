# The defaults. Put your own values in .env.local, which wins over this file.
# DO NOT PUT SECRETS IN THIS FILE.
#
# Every variable set here is read by the code, and every setting the code reads
# is listed here: set (with its default) or, where it has no safe default,
# commented out as `# NAME=`. scripts/checkEnv.spec.ts keeps both true.

### Models ###
# Models are sourced exclusively from an OpenAI-compatible base URL: a Pystino
# gateway's /v1 (the deploy kit sets it), or any other OpenAI-compatible
# endpoint. No default: the chat refuses to start without one.
OPENAI_BASE_URL=

# The shared key for a standalone endpoint (OpenAI, LM Studio, ...). Leave
# unset against Pystino, which serves GET /v1/models publicly and needs no key
# to boot (ADR 0081); USE_USER_TOKEN covers every real inference call.
OPENAI_API_KEY=
# "true" (Pystino mode): each person's own sign-in token is used for inference
# and OPENAI_API_KEY must be empty. Anything else: standalone mode.
USE_USER_TOKEN=
# "true" redirects to the sign-in page when nobody is signed in
AUTOMATIC_LOGIN=

### MongoDB ###
# Unset: an in-memory MongoDB (development only)
MONGODB_URL=
MONGODB_DB_NAME=chat-ui
MONGODB_DIRECT_CONNECTION=false

## Public app configuration ##
# Name used as title throughout the app
PUBLIC_APP_NAME=Cerea
# Rotating phrases printed beside the logo on a new chat (Turin dialect
# greetings), one per page load — a comma-separated list. Set to "false" or
# empty to restore the plain name everywhere. The compose overlay carries
# this from CHAT_TURIN_PHRASES in deploy/.env on operator deployments.
PUBLIC_TURIN_PHRASES="Com'è?,Va bin,Facciamo che iniziare?,Fuma c'anduma"
# Directory of logos and favicons in static/
PUBLIC_APP_ASSETS=chatui
# Description used throughout the app
PUBLIC_APP_DESCRIPTION="Making the community's best AI chat models available to everyone."
PUBLIC_ORIGIN=
PUBLIC_GOOGLE_ANALYTICS_ID=
PUBLIC_PLAUSIBLE_SCRIPT_URL=
PUBLIC_APPLE_APP_ID=
# Caveat text shown below the chat input on new chats.
# Defaults to "Generated content may be inaccurate or false." if unset.
PUBLIC_CAVEAT=
# Feature announcements shown as a toast on the home screen (no conversation open).
# JSON5 array of { title, description, link?, cta?, maxDate? }; the last valid entry is shown.
# cta overrides the link label (defaults to "Learn more").
# maxDate auto-hides the announcement after that date; a date-only value like "2026-12-31"
# is inclusive (hides at the end of that day, UTC).
# Example: PUBLIC_FEATURE_ANNOUNCEMENTS=[{"title":"Gemma-4-31B at 700 tokens/s","description":"Run Gemma-4-31B at 700 tokens/s thanks to Cerebras inference.","link":"/models/google/gemma-4-31B-it","cta":"Go to the model","maxDate":"2026-12-31"}]
PUBLIC_FEATURE_ANNOUNCEMENTS=

### Authentication ###
# When OPEN_ID is configured, people sign in through it.
# OPENID_CLIENT_ID can be "__CIMD__" for automatic OAuth client registration, see
# https://datatracker.ietf.org/doc/draft-ietf-oauth-client-id-metadata-document/
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
# The scopes requested at sign-in
OPENID_SCOPES="openid profile inference-api read-mcp read-billing"
# Whether the sign-in also asks for the offline_access scope (the refresh token behind background
# sessions and scheduled chats): auto (default, when the issuer lists it) or off.
OPENID_OFFLINE_ACCESS=

### Local Storage ###
# Where the in-memory MongoDB keeps its folder
MONGO_STORAGE_PATH=

## Models overrides
MODELS=

## Task model
# Optional: set to the model id/name from the `${OPENAI_BASE_URL}/models` list
# to use for internal tasks (title summarization, etc). If not set, the current model will be used
TASK_MODEL=

## Connector credentials (ADR 0064)
# The key that encrypts MCP connector credentials at rest — OAuth tokens and
# static API tokens, which used to live in browser localStorage. There is
# deliberately **no default**: a default would mean every deployment that
# forgot to set one shared a key, which is indistinguishable from no
# encryption while looking like encryption. Unset, adding a connector fails
# with a readable error rather than storing a plaintext token.
#
# Commented rather than empty: an empty assignment here is a *value*, and it
# overrides one exported into the environment — which is how the first run of
# the test suite failed with "CHAT_SECRET_KEY is not set" while the runner had
# just set it.
# CHAT_SECRET_KEY=

## Deployment settings the kit's ./configure writes
# These have no default, and are commented out because an empty assignment here
# would override a value exported into the environment. See docs/configuration.md.
# The gateway's credential for /internal/erasure (deleting a person everywhere)
# CHAT_ERASURE_TOKEN=
# PostgreSQL with pgvector, where knowledge-base passages and vectors live
# CHAT_PG_URL=
# Where the chat reaches Gotenberg, the document converter of the `office` profile
# CHAT_GOTENBERG_URL=
# Where the chat keeps files: gridfs (inside MongoDB, the default) or s3 (an S3-compatible bucket); see docs/storage.md
# CHAT_BLOB_STORE=
# CHAT_S3_ENDPOINT=
# CHAT_S3_REGION=
# CHAT_S3_BUCKET=
# CHAT_S3_ACCESS_KEY_ID=
# CHAT_S3_SECRET_ACCESS_KEY=
# CHAT_S3_FORCE_PATH_STYLE=
# CHAT_S3_PREFIX=
# CHAT_S3_SSE=
# CHAT_S3_SSE_KMS_KEY_ID=
# CHAT_S3_CREATE_BUCKET=
# Where the chat reaches the document service (cerea-documents), and the secret it shares with it; both set turn the doc_* tools on
# CHAT_DOCUMENTS_URL=
# CHAT_DOCUMENTS_SECRET=
# Web Push: the VAPID key pair and a contact (`mailto:` or `https:`). Unset: push is off
# CHAT_VAPID_PUBLIC_KEY=
# CHAT_VAPID_PRIVATE_KEY=
# CHAT_VAPID_SUBJECT=
# Comma-separated skill names to switch off deployment-wide
# CHAT_SKILLS_DISABLED=
# JSON array of { title, linkTitle, linkHref, external? } shown above the new-chat form
# PUBLIC_ANNOUNCEMENT_BANNERS=
# "true" shows a short generated summary of the model's reasoning while it thinks
# REASONING_SUMMARY=

## Fetching a URL
# What reads a link somebody pastes into the composer. **Fetching is not
# searching**: given a plain URL you do not search for it, you fetch it, and
# the only question here is what does the reading.
#
#   direct      a plain HTTPS request. The default, and what this app has
#               always done. A page built by JavaScript arrives as an empty
#               shell with a 200 and nothing to say the content was never
#               there — which is the whole reason the others exist.
#   playwright  the headless browser in this deployment. Needs the playwright
#               compose overlay, which is opt-in and publishes no port.
#   pystino     the gateway renders it. Not implemented; selecting it fails
#               with a message saying so rather than quietly falling back.
#
# Settable from Administration -> Fetching when ENABLE_CONFIG_MANAGER is true.
# Applies to HTML only: this endpoint also fetches PDFs and Office documents,
# and a browser is the wrong tool for those.
FETCH_BACKEND=

# The search backend (a gateway model name, `kind: search`) the chat's web
# search runs on. Unset: the choice made on Administration -> Web search, else
# the caller's billing-group search policy in the gateway. A name the caller is
# not granted falls back to that policy.
WEB_SEARCH_MODEL=

# Where the renderer listens. Inside the compose network only — it is
# unauthenticated remote code execution by design and must never be published.
PLAYWRIGHT_WS_ENDPOINT=

## Document extraction
# Optional: the model `POST /v1/ocr` should use when somebody attaches a PDF or
# an Office document to a message. Unset means the first model in
# `${OPENAI_BASE_URL}/models` whose `kind` is `ocr`, which in a deployment with
# only the built-in extractor is the built-in extractor — and that one never
# sends the document anywhere. Naming an upstream OCR model here does send it,
# which is why it is a deliberate setting rather than a preference for whatever
# reads best.
CHAT_OCR_MODEL=

# How many pages of a PDF the local reader may hand back as images, per file.
# A page with real text stays text; a page without (a scan) is rendered as an
# image, stored with the conversation, and sent to a model that reads images —
# a model that does not is told the page is a scan. Pages past the limit are
# not read, and the model is told so. 0 turns this off: scans then come back
# with no text, as before. Applies only when the deployment's own reader reads
# PDFs; a remote OCR model reads scans itself. At most 50.
CHAT_PDF_IMAGE_PAGES=20

# How long one document may take to read, in milliseconds. Unset = 180000
# (3 minutes). A 50-page PDF takes the local reader 20-30 s; this is separate
# from the short deadlines elsewhere. When it fires the server logs
# "document_extraction_timeout" with the elapsed time, and the attachment is
# stored without text. Pystino has its own limit on its side
# (GATEWAY_EXTRACTOR__TIMEOUT_SECONDS, default 180 s): raise both together.
CHAT_OCR_TIMEOUT_MS=

# Optional: for a deployment with no gateway anywhere (the "generic" profile),
# read documents by calling an OCR endpoint directly instead of through
# `/v1/ocr` — the request/response shape already matches Mistral's and
# Cortecs' published `/ocr` schema, so no protocol translation is needed.
# When set, this overrides the gateway path even where one would otherwise
# resolve a reader: naming an endpoint here means use it. Requires
# CHAT_OCR_MODEL above (there is no catalogue to discover a model from
# without a gateway) — the server refuses to start if one is set without the
# other. Direct mode only reads PDFs; Office formats still need a gateway.
#   e.g. https://api.mistral.ai/v1
CHAT_OCR_BASE_URL=
# Bearer key for CHAT_OCR_BASE_URL above. Unlike the gateway path, this is one
# shared deployment key, not the signed-in person's own credential.
CHAT_OCR_API_KEY=

## Knowledge pipeline
# Set to "false" in a deployment without the chat's Postgres (CHAT_PG_URL):
# the Knowledge workspace tab, the project and composer knowledge affordances
# and the admin Knowledge section hide, instead of rendering a pipeline with
# no store behind it. On (including unset) everywhere else — existing
# deployments never set this and keep the pipeline they already run. This is
# the deployment switch; the admin console's own `enabled` (which also needs
# an embedding model named) stays a product decision no operator flag crosses.
CHAT_KNOWLEDGE_ENABLED=

## User memory
# Standing personal facts, carried into every conversation and managed on the
# Memory tab of the workspace. Set to "false" to withdraw the feature from the
# deployment: the tab hides, its routes answer 404, and the remember/forget
# tools are never offered. On (including unset) everywhere else. This is the
# operator's switch; each person's own opt-in is separate and defaults OFF, so
# leaving this on stores nothing until somebody asks for it.
# `ask_user_question` (a structured question with clickable options the turn
# waits on) joins every conversation unless this is "false".
CHAT_ASK_USER_QUESTION_ENABLED=
CHAT_MEMORY_ENABLED=
# Sub-agents: the `delegate` tool (the assistant hands a sub-task to a
# sub-agent that works in its own context) and the `research` preset, offered to
# tool-capable models unless this is "false". Settable from Administration ->
# Sub-agents when ENABLE_CONFIG_MANAGER is true; a value saved there overrides
# this one.
CHAT_DELEGATION=

# Instructions added to the start of every chat's system prompt (chat only, not
# the /code panel), up to 4000 characters. Settable from Administration ->
# Assistant instructions when ENABLE_CONFIG_MANAGER is true; a value saved there
# overrides this one. ADMIN_INSTRUCTIONS_VISIBLE=false hides the text from users
# in Settings (it still applies).
ADMIN_INSTRUCTIONS=
ADMIN_INSTRUCTIONS_VISIBLE=

## Coding agents (`/code` panel)
# docs/code-panel.md is the operator guide; docs/agent-machines.md is for the
# person setting up a machine. A full-screen remote-control panel for coding
# agents (opencode-first) running on the person's own machine, which dials out
# to this deployment — nothing else to deploy (the deploy kit: `./configure --agents`). Off
# (including unset) hides the sidebar row and the route answers 404. Cerea
# persists only pairing records; live agent state stays on the machine.
CODE_AGENTS_ENABLED=
# Local MCP connectors (docs/local-connectors.md): MCP servers that run on a person's own
# machine, listed in the Workspace's Local connectors tab and offered to that person's chat over
# the same machine link. Independent of CODE_AGENTS_ENABLED (a deployment can serve connectors
# machines without the Agents panel). On only when exactly "true"; off (including unset) refuses
# connectors machines and hides the tab. The deploy kit turns it on.
LOCAL_CONNECTORS_ENABLED=
# The thin machine agent (`galopin`, this repository's agent/) dials out to this deployment over
# WSS and authenticates with its enrollment's OIDC access token, validated
# locally (JWKS, no userinfo round trip). CODE_MACHINE_ISSUER defaults to
# OPENID_PROVIDER_URL below — set it separately only to point machine tokens
# at a different issuer than the browser login (a test harness's mock IdP,
# for instance) without touching that config.
CODE_MACHINE_ISSUER=
CODE_MACHINE_AUDIENCE=pystino-api
CODE_MACHINE_CLIENT_ID=opencode-enrollment
# The gateway origin (or /v1 base) the pairing dialog's one-liner passes to
# `galopin enroll --gateway`. Compose sets this to ${PUBLIC_ORIGIN} (or the
# central stack's URL, for a satellite deployment); unset falls back to the
# browser's own origin in the dialog rather than guessing here.
CODE_GATEWAY_ORIGIN=
# The /code file explorer (read-only, ADR 0090): on with the code panel;
# "false" turns it off for the whole deployment. Each machine can still
# refuse it on its own (galopin enroll --no-files).
CODE_FILES_ENABLED=
# The /code terminal (ADR 0090, PROTOCOL.md §9): a full remote shell on the
# paired machine, so it defaults OFF (empty), unlike CODE_FILES_ENABLED —
# set to "true" to turn it on for this deployment. It is still only live for
# a machine enrolled with --allow-terminal (the double veto, ADR 0090 §6.1):
# this switch and the machine's own policy must both allow it.
CODE_TERMINAL_ENABLED=
# Scheduled actions in /code (a prompt sent to a coding session on a timetable).
# On with the panel; exactly 'false' is the kill switch: nothing fires, the API
# answers 404 and the sidebar entry goes. Rows are kept.
CHAT_SCHEDULES_ENABLED=
# How many schedules one person may have. Empty: 20.
CHAT_SCHEDULES_MAX_PER_USER=
# Offer the en-XA pseudo-locale (every message accented and bracketed, to spot
# strings that are still hard-coded) in Settings > Language. A developer tool:
# on in `vite dev` regardless, off in a built image unless exactly 'true'.
CHAT_PSEUDO_LOCALE=
# Where the image keeps the galopin binaries it built from agent/ (the four
# galopin-<os>-<arch>, SHA256SUMS, REVISION). {base}/galopin/* serves them,
# with install.sh, to anyone: a machine installs with
# `curl -fsSL <origin><base>/galopin/install.sh | sh`. Unset: /app/galopin-dist.
GALOPIN_DIST_DIR=

### Transcription ###
# Voice-to-text transcription using Whisper models
# If set, enables the microphone button in the chat input
# Example: openai/whisper-large-v3-turbo
TRANSCRIPTION_MODEL=
# Base URL of the transcription API: the request goes to
# ${TRANSCRIPTION_BASE_URL}/${TRANSCRIPTION_MODEL} with the person's token.
# No default; the microphone button needs both settings.
TRANSCRIPTION_BASE_URL=

# Parameters to enable open id login
OPENID_CONFIG=
# if it's defined, only these emails will be allowed to use login
ALLOWED_USER_EMAILS=[]
# If it's defined, users with emails matching these domains will also be allowed to use login
ALLOWED_USER_DOMAINS=[]
# valid alternative redirect URLs for OAuth
ALTERNATIVE_REDIRECT_URLS=[] 
### Cookies
# name of the cookie used to store the session
COOKIE_NAME=hf-chat
# If the value of this cookie changes, the session is destroyed. Useful when the app is
# deployed on a subpath of your domain and sessions should reset when the user's auth changes
COUPLE_SESSION_WITH_COOKIE_NAME=
# specify secure behaviour for cookies
# "lax", "strict", "none" or empty; empty is "lax" unless ALLOW_IFRAME=true (iframe
# embedding needs "none" to carry the cookie cross-site)
COOKIE_SAMESITE=
# "true" only allows cookies over https
COOKIE_SECURE=

### Admin stuff ###
# Opt-in: true prints an admin login URL at boot; always off when OpenID is configured
ADMIN_CLI_LOGIN=false
# We recommend leaving this empty: the token is printed in the terminal
ADMIN_TOKEN=

### Feature Flags ###
# Generate conversation titles with the task model
LLM_SUMMARIZATION=true

# true allows embedding the app in an iframe on other sites
ALLOW_IFRAME=false

# Artifacts (models emit self-contained apps/docs/diagrams rendered in a side panel)
# are opt-in per model: set `"supportsArtifacts": true` on a model entry in the
# MODELS overrides below.

# Base servers list (JSON array). Example: MCP_SERVERS=[{"name": "Web Search (Exa)", "url": "https://mcp.exa.ai/mcp"}]
MCP_SERVERS=
# "true" forwards the signed-in person's token to the Hub's MCP server
# (https://hf.co/mcp?login), when it is listed above and sets no Authorization header
MCP_FORWARD_HF_USER_TOKEN=
# Exa API key (injected at runtime into mcp.exa.ai URLs as ?exaApiKey=)
EXA_API_KEY=
# How long an MCP tool call may go without the server responding (default: 120000 = 2
# minutes). Time spent waiting on a user to answer an elicitation does not count against it.
MCP_TOOL_TIMEOUT_MS=
# How long (ms) a model's answer stream may go without sending anything before the turn is
# stopped with "The model stopped responding" (default: 300000 = 5 minutes, at least 30000).
# The wait before the first chunk counts, so keep it generous for slow reasoning models.
CHAT_STREAM_IDLE_TIMEOUT_MS=
# The longest one chat turn may run, in minutes (default: 30, at least 1), whatever it is doing.
# Past it the turn ends as an error and keeps what was streamed. A turn that parks for an
# approval or a question ends there; its resume gets a fresh allowance.
CHAT_TURN_MAX_MINUTES=
# web_fetch and "Attach from URL" refuse 10.0.0.0/8 and 100.64.0.0/10 (mesh VPNs such as
# Tailscale and NetBird); other private ranges, loopback and link-local are always refused.
# Set to "true" only if this deployment must fetch content from hosts on those networks.
# MCP connectors may reach both regardless.
CHAT_FETCH_ALLOW_INTERNAL_NETWORKS=
# Set to "true" to allow MCP server URLs over http on localhost / private LAN addresses
# (10.x, 100.64.x mesh VPN, 172.16-31.x, 192.168.x).
# Local development and the e2e harness only — never enable in production.
MCP_ALLOW_INSECURE_URLS=
# Comma-separated exact hostnames of MCP servers running beside the chat on the compose network
# (e.g. "mcp-search,mcp-osm"): reachable over plain http, and only if they resolve to a local
# address. No wildcards or IPs. See the kit's "Server-side MCP servers".
MCP_INTERNAL_HOSTS=
# Set to "true" to stop advertising the `elicitation` client capability, so servers can
# never interrupt a tool call to ask the user for input.
MCP_DISABLE_ELICITATION=
# How long (ms) an elicitation prompt stays answerable (default: 3600000 = 1 hour), so
# someone who walks away can still answer when they get back. Independent of
# MCP_TOOL_TIMEOUT_MS — the tool call's deadline is paused while the prompt is open.
# On a 2026-era connection this is the ONLY bound: the server answered with
# `input_required` and is no longer waiting, so nothing else expires. On a 2025-era one
# the server's own timeout on its request (60s by SDK default) usually gives up first.
MCP_ELICITATION_TIMEOUT_MS=
# How often (ms) to sweep for generations whose pod died mid-run and mark them
# interrupted. Default 60000.
GENERATION_REAP_INTERVAL_MS=
# How often to look for parked turns whose timer is due. Default 10000. The
# interval is the floor on how late a wake can be, so it wants to stay well
# below the shortest wait a tool can ask for.
PARKED_SWEEP_INTERVAL_MS=
# Set to "true" to offer the execute_code tool to tool-supporting models: the
# model's code runs in the signed-in person's own browser sandbox (Pyodide, no
# network — the worker's fetch is allowlisted to this origin's own runtime
# assets) and the result is returned into the model's context. The stdlib plus
# the vendored same-origin wheels are what it can import; see docs/pyodide.md.
# Absent or empty = fences only, exactly the previous behavior.
CHAT_CODE_TOOL_ENABLED=
# Seconds one sandbox code run may take before it is stopped and the sandbox
# restarts. Absent or empty = 60. Held between 5 and 300 (the hard cap).
CHAT_CODE_RUN_TIMEOUT_SECONDS=
CHAT_CODE_EXECUTION=
CODE_PAUSED_WAIT_MS=
CHAT_CODE_EXECUTION_DEADLINE_SECONDS=
# Set to "true" to force-disable the code sandbox's "install packages from
# PyPI" setting deployment-wide, overriding any user's own toggle. The vendored
# same-origin wheels (python-docx, openpyxl, pypdf, python-pptx, and whatever
# else ships in this Pyodide build) stay installable either way — this only
# controls the opt-in escape hatch to the public PyPI index. Absent or empty =
# the per-user setting decides (still off by default until a person turns it
# on).
CHAT_PYODIDE_PYPI_DISABLED=
# Set to "true" to show the "Usage & billing" settings tab: the signed-in
# person's Pystino quotas (progress bars, from `GET /me/limits`) and spend
# (from `GET /me/usage` and `/me/usage/groups`), plus the billing-group
# selector that used to live on the Application tab. Also needs
# OPENAI_BASE_URL configured — without a gateway there is nothing for the
# Pystino usage provider to read, so the tab stays hidden either way. Absent
# or empty = no tab, no gateway calls from this feature.
CHAT_USAGE_ENABLED=
# Set to "true" when this deployment's own origin serves the Pystino console
# at /console — the gateway profiles (homelab, team, enterprise), where the
# chat's admin panel then links to it. Standalone profiles leave it empty:
# satellite's Pystino is central's (its console is not this origin's to
# serve), and generic has no Pystino at all. Absent or empty = the admin
# panel shows no console link, and nothing else changes.
CHAT_CONSOLE_ENABLED=
# How many days files produced by code (execute_code deliverables, ADR
# 0073's amendment) are kept: a whole number, 0 for no expiry, default 30.
# Settable from Administration -> Storage when ENABLE_CONFIG_MANAGER is true;
# a value saved there overrides this one.
CHAT_FILE_RETENTION_DAYS=
# Whether the composer offers dictation with the browser's own speech
# recognition: yes, no, or fallback (the default: only when TRANSCRIPTION_MODEL
# is unset, so the recorder button and this one never show together). Chrome,
# Edge and Safari may send the audio to their vendor's cloud. Settable from
# Administration -> Voice when ENABLE_CONFIG_MANAGER is true; a value saved
# there overrides this one.
CHAT_DICTATION=
# How often (ms) to sweep persisted execute_code deliverables for the
# retention above and free their GridFS bytes, metadata and orphaned bytes
# together. Default 3600000 (1 hour); tests scale it down.
DELIVERABLE_SWEEP_INTERVAL_MS=
# How many days the text web_fetch read from a page or document is kept for its
# conversation, so a later turn does not download and extract it again: a whole
# number, 0 turns the cache off, default 7.
CHAT_WEBFETCH_CACHE_DAYS=
# Within this many minutes of the last download a cached document is reused
# without downloading again; after that it is re-extracted only if it changed.
# Default 10.
CHAT_WEBFETCH_FRESH_MINUTES=
# A run with no heartbeat for this long (ms) is presumed dead and finalized.
# Must stay well above GENERATION_HEARTBEAT_MS or live runs get reaped. Default 90000.
GENERATION_REAP_AFTER_MS=
# How often (ms) a running generation touches its heartbeat. Default 10000.
GENERATION_HEARTBEAT_MS=
ENABLE_DATA_EXPORT=true

### Rate limits ###
# See `src/lib/server/usageLimits.ts`
# {
#   conversations: number, # how many conversations
#   messages: number, # how many messages in a conversation
#   messageLength: number, # how long can a message be before we cut it off
#   messagesPerMinute: number # how many messages per minute
# }
USAGE_LIMITS={}

### Metrics ###
METRICS_ENABLED=false
METRICS_PORT=5565
LOG_LEVEL=info

### Admin API ###
# Secret for program-called admin routes, like computing usage stats
ADMIN_API_SECRET=

### Config ###
ENABLE_CONFIG_MANAGER=true

### Docker build variables ###
# These values cannot be updated at runtime; they are passed when building the
# docker image (see the Dockerfile).
# Base path of the app, e.g. /chat; blank by default
APP_BASE=
### Body size limit for SvelteKit https://svelte.dev/docs/kit/adapter-node#Environment-variables-BODY_SIZE_LIMIT
BODY_SIZE_LIMIT=15728640
PUBLIC_COMMIT_SHA=

### Identity provider ###
# The OIDC issuer for sign-in (and the default issuer of machine tokens). No
# default; the deploy kit sets it from OIDC_ISSUER.
OPENID_PROVIDER_URL=
# Claim used as the display name ("username" for providers that send no name)
OPENID_NAME_CLAIM="name"
# Server-to-server base for the issuer when PROVIDER_URL would hairpin (e.g.
# http://authelia:9091/authelia); browsers still use PROVIDER_URL
OPENID_INTERNAL_URL=
# The provider's logout page, for one that publishes no end_session_endpoint (the
# bundled Authelia: <issuer>/logout?rd={redirect}); {redirect} is where to land.
# Used before discovery when set
OPENID_LOGOUT_URL=
# Other apps' session cookies on this origin to expire on sign-out, `name` or
# `name:path`, comma-separated (the Pystino console: gw_session,gw_idt:/auth)
LOGOUT_ALSO_CLEAR_COOKIES=
# Moving to a new identity provider: the old issuer; a first login with no
# account takes over the old account with the same verified email
CHAT_MIGRATE_ISSUER_FROM=
OPENID_TOLERANCE=
OPENID_RESOURCE=

### Legacy settings, still read ###
# Use COOKIE_SECURE and COOKIE_SAMESITE instead
ALLOW_INSECURE_COOKIES=false
# Use USAGE_LIMITS.messagesPerMinute instead
RATE_LIMIT=
