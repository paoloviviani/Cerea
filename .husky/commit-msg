#!/bin/sh
# Rejects a commit (or merge) message that carries AI attribution other than
# Claude's (MAINTAINING.md, rule 1).
# The check itself is the one shared script, also called by CI's backstop:
"$(dirname "$0")/../scripts/check_no_ai_trailers.sh" "$1" || exit 1
# A maintainer's own extra checks, kept out of the repository.
if [ -x "$(dirname "$0")/commit-msg.local" ]; then
	"$(dirname "$0")/commit-msg.local" "$1" || exit 1
fi
