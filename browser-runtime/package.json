{
	"name": "cerea-browser-runtime",
	"version": "0.1.0",
	"private": true,
	"description": "Browser runtime for Cerea browser use (ADR 0116): an MCP server over Playwright's AI snapshot.",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test --test-concurrency=1 test/*.test.ts",
		"bundle": "node scripts/bundle.mjs",
		"start": "node src/main.ts",
		"format": "prettier --write .",
		"lint": "prettier --check . && tsc --noEmit"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.2",
		"playwright-core": "1.66.0-alpha-2026-11-09",
		"tldts": "7.4.26",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"esbuild": "^0.28.2",
		"prettier": "3.8.4",
		"typescript": "^5.9.0"
	}
}
