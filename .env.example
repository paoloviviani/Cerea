# Cerea: the deployment's one configuration file.
#
# Two ways to get a .env:
#
#   ./configure                          asks a few questions, mints every secret
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# Either way this file is the reference: every variable the stack reads is
# listed and explained here, and every secret names the command that makes
# one. ./configure writes the same keys, in this order, with these comments.
#
# Rules for editing by hand:
#   - Wrap every value in single quotes. Compose takes single-quoted values
#     literally, which matters for the Authelia digests (they contain `$`).
#   - A value may not itself contain a single quote.
#   - After an edit: `./configure --check`, then `docker compose up -d`.
#   - Keep this file at mode 0600 and back it up with the volumes: it holds
#     every secret, and some (GATEWAY_SECRET_KEY, AUTHELIA_STORAGE_KEY) cannot
#     be regenerated without losing data.
#
# Secrets marked `openssl rand -hex 32` can be any long random string; hex is
# used because it needs no quoting in URLs.

PYSTINO_CONFIG_VERSION='1'

# --- Compose: project and add-ons ----------------------------------------------

# The compose project name. Volumes are named after it (cerea_postgres-data,
# ...), so changing it later starts from empty volumes.
COMPOSE_PROJECT_NAME='cerea'

# Which add-ons run, comma-separated. ./configure derives it from the preset
# and the IdP choice:
#   gateway    the Pystino gateway and console (API at /v1, console at /console)
#   chat       Cerea, the chat, at /chat
#   authelia   the bundled IdP, at /authelia (leave out with an external IdP)
#   redaction  PII redaction and document extraction for the gateway
#   fetch      a headless browser for the chat's web fetch
# postgres, bootstrap and the proxy always run.
COMPOSE_PROFILES='gateway,chat,redaction,authelia'

# The preset this file was made from (informational; ./configure reads it when
# re-run). See the README's presets table:
#   homelab | team | enterprise | satellite | generic
PYSTINO_PRESET='team'

# --- Images --------------------------------------------------------------------
#
# Nothing to set. The images this release was tested with are the defaults in
# compose.yaml; `git pull` of a newer release changes them. Set these only to
# run images you built (dev/build.sh writes them) or mirrored:
#
# PYSTINO_REGISTRY='local'
# PYSTINO_VERSION='sha-5f9a870'
# CEREA_REGISTRY='local'
# CEREA_VERSION='sha-ae67826'
#
# Or replace a whole image reference: GATEWAY_IMAGE, CEREA_IMAGE,
# REDACTION_IMAGE, CADDY_IMAGE, AUTHELIA_IMAGE, POSTGRES_IMAGE, VALKEY_IMAGE,
# MONGO_IMAGE, PLAYWRIGHT_IMAGE.

# --- Public origin and TLS -----------------------------------------------------

# Where people reach the stack. Always https://, even when TLS ends in front
# of this host; a path is not allowed (the chat is served at <origin>/chat).
PUBLIC_ORIGIN='https://cerea.example.org'

# How TLS is done. The three proxy variables below follow from it:
#
#   acme      Caddy gets a certificate from Let's Encrypt. Needs a public DNS
#             name pointing at this host and ports 80 and 443 reachable.
#               SITE_ADDRESS='https://<host>'  TLS_DIRECTIVE=''
# Only for a host that is an IP address: `default_sni <ip>`, so Caddy can pick
# its certificate when the browser sends no server name. ./configure writes it.
DEFAULT_SNI_DIRECTIVE=''
#   internal  Caddy's own CA; browsers warn. Development and private networks.
#               SITE_ADDRESS='https://<host>'  TLS_DIRECTIVE='tls internal'
#   upstream  TLS ends in front of this host (a load balancer, an edge proxy)
#             and reaches Caddy as plain HTTP on HTTP_PORT.
#               SITE_ADDRESS='http://:80'      TLS_DIRECTIVE=''
TLS_MODE='acme'
SITE_ADDRESS='https://cerea.example.org'
TLS_DIRECTIVE=''

# Host ports the proxy listens on. In upstream mode only HTTP_PORT matters.
HTTP_PORT='80'
HTTPS_PORT='443'
# The address those ports bind to: 0.0.0.0 for everyone, 127.0.0.1 for a
# stack reached only through a tunnel or a proxy on this host.
PUBLIC_BIND='0.0.0.0'
# The gateway's own port, on 127.0.0.1 only (SSH port-forwarding, scripts).
GATEWAY_PORT='8000'
# Let's Encrypt account address (acme mode).
ACME_EMAIL='admin@cerea.example.org'
# Which proxies in front may set X-Forwarded-* (upstream mode): a Caddy
# trusted_proxies list, or private_ranges.
TRUSTED_PROXIES='private_ranges'
# What / serves: gateway (the console), or chat (a redirect to /chat/, for the
# satellite and generic presets, which have no gateway).
PROXY_DEFAULT='gateway'

# --- Database ------------------------------------------------------------------

# One PostgreSQL (with pgvector) for the gateway and the chat's knowledge store.
POSTGRES_USER='gateway'
POSTGRES_DB='gateway'
# openssl rand -hex 24
POSTGRES_PASSWORD=''
# The chat's own role on the same instance; bootstrap creates it.
# openssl rand -hex 24
CHAT_PG_PASSWORD=''

# --- Application secrets -------------------------------------------------------

# Encrypts provider API keys at rest. Losing it means re-entering every
# provider credential in the console; never rotate it casually.
# openssl rand -hex 32
GATEWAY_SECRET_KEY=''
# Signs console sessions. Rotating it signs everyone out of the console.
# openssl rand -hex 32
GATEWAY_SESSION_SECRET=''
# Signs chat sessions. Rotating it signs everyone out of the chat.
# openssl rand -hex 32
CHAT_SECRET_KEY=''
# The gateway's own credential for the chat's /internal/erasure, over the
# compose network only -- used for nothing else, and never reachable from
# the edge regardless (the Caddyfile answers 404 for that path first).
# Rotating it means the retry loop's in-flight deletes fail until every
# service using the old value restarts with the new one.
# openssl rand -hex 32
CHAT_ERASURE_TOKEN=''
# The HMAC key redaction derives placeholders from. Set it even with redaction
# off, so switching it on later needs nothing new; keep it stable for as long
# as the transcripts it labelled are kept.
# openssl rand -hex 32
REDACTION_PLACEHOLDER_KEY=''

# --- Upstream inference provider ----------------------------------------------

# The gateway's first provider. More, and this one's key, are managed in the
# console; leaving the key empty here is normal.
GATEWAY_UPSTREAM__BASE_URL='https://api.cortecs.ai/v1'
GATEWAY_UPSTREAM__API_KEY=''

# --- Features (set by the preset) ----------------------------------------------

# Ledger and quotas. Off in homelab.
GATEWAY_ACCOUNTING__ENABLED='true'
GATEWAY_QUOTA__ENABLED='true'
# Redaction: noop (off), or http with the redaction profile on.
GATEWAY_REDACTION__ENGINE='http'
GATEWAY_EXTRACTOR__ENDPOINT='http://extractor:8080'
# disabled = pattern-only (the published image). spacy = NER, which needs the
# -ner image built locally (dev/build.sh --ner; its model is non-commercial,
# so it is never published).
REDACTION_NLP_ENGINE='disabled'
REDACTION_LANGUAGE='en'
# The chat's web fetch: direct, or playwright with the fetch profile on.
FETCH_BACKEND='direct'
# Where the chat reaches the headless browser. Set it with the fetch profile
# on, and leave it unset with the profile off (./configure keeps them in step).
# PLAYWRIGHT_WS_ENDPOINT='ws://playwright:3000/'
# Chat features: 'true' on, '' off.
CHAT_APP_NAME='Cerea'
CHAT_CODE_TOOL_ENABLED='true'
CHAT_CONSOLE_ENABLED='true'
CHAT_KNOWLEDGE_ENABLED='true'
CHAT_MEMORY_ENABLED='true'
# The Usage tab reads the gateway's ledger: '' when accounting is off.
CHAT_USAGE_ENABLED='true'

# The document reader for uploads and the knowledge base. Empty (the default)
# means the chat resolves one itself: this deployment's local extractor, or
# the first OCR-kind model the gateway's catalogue offers. Set CHAT_OCR_MODEL
# to pin a specific model instead. CHAT_OCR_BASE_URL bypasses the gateway
# entirely and calls an OCR endpoint directly — for a deployment with no
# Pystino in front of it — and needs CHAT_OCR_MODEL set alongside it, since a
# direct endpoint has no catalogue to name one from; CHAT_OCR_API_KEY is that
# endpoint's own credential, if it needs one.
# CHAT_OCR_MODEL=''
# CHAT_OCR_BASE_URL=''
# CHAT_OCR_API_KEY=''

# Where the chat sends model calls. Default: this stack's gateway, with each
# person's own token. The satellite preset points it at a central Pystino
# (https://<central>/v1, user tokens); the generic preset at any
# OpenAI-compatible endpoint with one shared key (CHAT_USE_USER_TOKEN='false').
# CHAT_OPENAI_BASE_URL='http://gateway:8000/v1'
# CHAT_OPENAI_API_KEY=''
# CHAT_USE_USER_TOKEN='true'

# --- Agent machines ------------------------------------------------------------

# 'true' turns on /chat/code and galopin, the machine agent: people pair their
# own machines from the chat and drive coding agents there. It dials this
# origin over WSS; no extra service or port.
CODE_AGENTS_ENABLED=''
# The browser terminal in /code: 'true' lets a machine's owner open a shell on
# it from the chat. Security: that is interactive shell access to enrolled
# machines, reachable from a browser session. It works only for machines
# enrolled with `galopin enroll --allow-terminal`. Off unless set.
# CODE_TERMINAL_ENABLED='true'

# --- Identity: OIDC only -------------------------------------------------------
#
# Only one identity provider is supported. To offer people a choice of
# several, federate them in Keycloak (or similar) and point OIDC_ISSUER at
# that instead. The bundled Authelia is one-factor: a second factor (TOTP,
# WebAuthn) comes from an external IdP such as Keycloak.

# The first person to sign in with this verified email becomes an
# administrator. Honoured once per deployment: once any administrator exists
# it never fires again, so deactivating every administrator does not re-arm
# it (break-glass is the way back).
PYSTINO_BOOTSTRAP_ADMIN_EMAIL='admin@example.org'

# The issuer. Bundled Authelia: <PUBLIC_ORIGIN>/authelia. External IdP: its
# issuer URL, exactly as its discovery document states it.
OIDC_ISSUER='https://cerea.example.org/authelia'
# The back-channel: where the gateway and the chat reach the IdP from inside
# the compose network, so server-to-server calls never cross the proxy. The
# bundled Authelia: http://authelia:9091/authelia. External IdP: empty (use the
# issuer) or an internal URL for it.
OIDC_INTERNAL_BASE_URL='http://authelia:9091/authelia'
# authelia (bundled: users-file sync and user management in the console) or
# generic (any other issuer).
OIDC_KIND='authelia'
OIDC_GROUPS_CLAIM='groups'
OIDC_AUDIENCE='pystino-api'
# How often the directory's answer about groups is applied: every_login,
# first_login (once, administered here afterwards) or never. Ignored with
# the bundled Authelia, whose users file carries no groups worth polling.
OIDC_GROUP_SYNC='every_login'

# The console's client at the IdP. Redirect URI: <PUBLIC_ORIGIN>/auth/callback/default
OIDC_CONSOLE_CLIENT_ID='pystino-console'
# openssl rand -hex 32   (bundled Authelia: also set its digest below)
OIDC_CONSOLE_CLIENT_SECRET=''
# The chat's client at the IdP. Redirect URI: <PUBLIC_ORIGIN>/chat/login/callback
OIDC_CHAT_CLIENT_ID='cerea'
# openssl rand -hex 32   (bundled Authelia: also set its digest below)
OIDC_CHAT_CLIENT_SECRET=''
# galopin's client, for enrolling a machine through the device flow. Public:
# no secret, just an id an external IdP must also register — as a public
# client with the device flow and a loopback redirect.
OIDC_MACHINE_CLIENT_ID='opencode-enrollment'

# Who is an administrator, decided here rather than in the console. Set one
# pair — a comma-separated list of verified addresses, or a claim path plus
# the comma-separated values that confer it — or neither with the bundled
# Authelia, which uses PYSTINO_BOOTSTRAP_ADMIN_EMAIL above instead. An
# external IdP refuses to start with neither set. Re-checked at every
# sign-in and at every gateway start; the last active administrator is never
# revoked.
OIDC_ADMIN_EMAIL=''
OIDC_ADMIN_CLAIM=''
OIDC_ADMIN_CLAIM_VALUE=''

# Off unless turned on deliberately: a first sign-in with a verified email
# attaches to the existing non-admin account with that address instead of
# creating a second one. A WARNING prints at every start while this is on.
OIDC_LINK_BY_EMAIL='false'

# A bearer token's azp (or client_id) must name one of these once
# OIDC_AUDIENCE is set: the console, the chat and galopin's machine client
# above. Override the whole list explicitly instead (comma-separated) — rare;
# leaving it empty derives it from the three client ids above.
OIDC_ACCEPTED_CLIENTS=''

# Signing out of the chat ends the IdP's session through this URL when the IdP
# publishes no end_session_endpoint; {redirect} is where to land.
# Bundled Authelia: <PUBLIC_ORIGIN>/authelia/logout?rd={redirect}
OIDC_LOGOUT_URL='https://cerea.example.org/authelia/logout?rd={redirect}'

# --- Mail ------------------------------------------------------------------------
#
# Quota notices, the console's "send test", and (with the bundled Authelia)
# its own self-service password reset all read this one setting. Leave
# SMTP_HOST empty to run without mail: quota notices are simply not sent, and
# a password reset becomes an administrator issuing a one-time password.

SMTP_ENABLED='false'
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_FROM=''
# starttls (connect plain, then upgrade), tls (connect already encrypted,
# port 465 by convention), or none (never encrypt — a mail sink with no
# certificate on a private network).
SMTP_SECURITY='starttls'

# --- Bundled Authelia (profile authelia) ---------------------------------------
#
# Delete this section with an external IdP.

# The host of PUBLIC_ORIGIN. Authelia needs a dotted name: browsers refuse a
# session cookie on an IP address or a dotless host.
AUTHELIA_COOKIE_DOMAIN='cerea.example.org'
# openssl rand -hex 32
AUTHELIA_SESSION_SECRET=''
# openssl rand -hex 32
AUTHELIA_HMAC_SECRET=''
# Encrypts Authelia's store, which holds every person's subject identifier:
# their identity everywhere downstream. Changing it re-keys everyone. Never
# rotate it.
# openssl rand -hex 32
AUTHELIA_STORAGE_KEY=''
# Signs the self-service password reset link Authelia emails when SMTP is
# set below. Required whenever that reset flow isn't disabled, so it's minted
# regardless of whether SMTP_HOST is filled in yet.
# openssl rand -hex 32
AUTHELIA_RESET_PASSWORD_JWT_SECRET=''

# Digests of the two client secrets above: Authelia stores no plaintext.
#   docker run --rm authelia/authelia:4.39.22 authelia crypto hash generate \
#     pbkdf2 --variant sha512 --password '<the OIDC_..._CLIENT_SECRET value>'
# and paste the line after "Digest: ", single-quoted.
AUTHELIA_CONSOLE_CLIENT_DIGEST=''
AUTHELIA_CHAT_CLIENT_DIGEST=''

# The first account, written into Authelia's users file on the first `up` and
# never again (change the password afterwards in Authelia or the console).
AUTHELIA_ADMIN_USER='admin'
AUTHELIA_ADMIN_EMAIL='admin@example.org'
AUTHELIA_ADMIN_NAME='admin'
# A digest of the first password. SHA512-crypt or argon2id (the bootstrap
# service accepts only those two here):
#   docker run --rm authelia/authelia:4.39.22 authelia crypto hash generate \
#     sha2crypt --variant sha512 --password '<a password you choose>'
AUTHELIA_ADMIN_PASSWORD_DIGEST=''
