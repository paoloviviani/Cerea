<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent: keeps `galopin run` up. Install (USER is replaced):
       sed "s/USER/$USER/g" org.cerea.galopin.plist > ~/Library/LaunchAgents/org.cerea.galopin.plist
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/org.cerea.galopin.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>org.cerea.galopin</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USER/.local/bin/galopin</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/USER/.local/bin:/Users/USER/.opencode/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- launchd cannot skip one exit code: after a revocation (exit 78) it restarts
       once, and that start finds its machine id marked revoked and exits 0, which
       ends the loop. Re-enroll, then `launchctl kickstart` the job. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>/Users/USER/Library/Logs/galopin.log</string>
  <key>StandardErrorPath</key><string>/Users/USER/Library/Logs/galopin.log</string>
</dict>
</plist>
