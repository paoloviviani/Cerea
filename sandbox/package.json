{
	"name": "cerea-sandbox",
	"version": "0.1.0",
	"private": true,
	"description": "Cerea server sandboxes (ADR 0115): the sandbox manager and its Docker socket proxy. No runtime dependencies.",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.22.1"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test --test-concurrency=1 --test-timeout=60000 test/*.test.ts",
		"test:integration": "SANDBOX_INTEGRATION=1 node --test --test-concurrency=1 --test-timeout=60000 test/integration.test.ts",
		"format": "prettier --write .",
		"lint": "prettier --check . && tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"prettier": "3.9.5",
		"typescript": "^5.9.0"
	}
}
