{
	"name": "cerea-desktop",
	"version": "0.0.0",
	"private": true,
	"description": "Cerea desktop app: your Cerea, an embedded browser the chat can drive, and galopin.",
	"license": "Apache-2.0",
	"main": "dist/main/main.js",
	"type": "commonjs",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"smoke": "xvfb-run -a node scripts/smoke.mjs && xvfb-run -a node scripts/smoke2.mjs",
		"start": "npm run build && electron . --no-sandbox",
		"lint": "prettier --check . && tsc --noEmit",
		"format": "prettier --write .",
		"runtime:stage": "node scripts/stage-runtime.mjs",
		"package": "node scripts/package.mjs",
		"dist": "npm run build && npm run runtime:stage && node scripts/package.mjs",
		"check:packaged": "node scripts/check-packaged.mjs",
		"galopin:build": "node scripts/build-galopin.mjs"
	},
	"dependencies": {},
	"devDependencies": {
		"@electron/asar": "3.4.1",
		"@types/node": "^24.0.0",
		"electron": "45.3.0",
		"electron-builder": "26.8.1",
		"esbuild": "^0.28.2",
		"playwright-core": "1.66.0-alpha-2026-11-09",
		"prettier": "3.9.5",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0",
		"ws": "8.18.3",
		"@types/ws": "^8.18.1"
	},
	"homepage": "https://github.com/paoloviviani/Cerea",
	"author": {
		"name": "Cerea",
		"email": "noreply@github.com"
	}
}
