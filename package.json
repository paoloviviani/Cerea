{
	"name": "chat-ui",
	"version": "0.30.1",
	"license": "Apache-2.0",
	"private": true,
	"packageManager": "npm@9.5.0",
	"scripts": {
		"predev": "npm run sync-pyodide",
		"prebuild": "npm run sync-pyodide",
		"prebuild:static": "npm run sync-pyodide",
		"sync-pyodide": "node scripts/sync_pyodide.mjs && node scripts/sync_pyodide_wheels.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"build:static": "ADAPTER=static vite build",
		"preview": "vite preview",
		"i18n:compile": "paraglide-js compile --project ./project.inlang",
		"i18n:pseudo": "node scripts/pseudo-locale.mjs",
		"i18n:check": "npm run i18n:compile --silent && node scripts/i18n-check.mjs",
		"check": "npm run i18n:compile --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && npm run i18n:check --silent",
		"format": "prettier --write .",
		"test": "vitest --project=server --project=ssr",
		"test:client": "vitest --project=client",
		"test:all": "vitest",
		"test:coverage": "vitest --project=server --project=ssr --coverage",
		"test:e2e": "playwright test",
		"populate": "vite-node --options.transformMode.ssr='/.*/' scripts/populate.ts",
		"config": "vite-node --options.transformMode.ssr='/.*/' scripts/config.ts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@faker-js/faker": "^8.4.1",
